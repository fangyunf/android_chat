<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/forget_pwd_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="忘记密码"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="37dp"
        android:paddingRight="37dp">

        <include
            android:id="@+id/forget_pwd_activity_phone_tf"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_code_tf"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_pwd_tf"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_pwd2_tf"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <Button
            android:id="@+id/forget_pwd_activity_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:background="@mipmap/login_btn_bg"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>

</LinearLayout>