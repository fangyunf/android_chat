<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/login_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/activity_login_switch_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dimen_30_dp"
        android:layout_marginTop="235dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/activity_login_login_ll"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_60_dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/activity_login_login_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登录"
                android:textColor="#ff244dc6"
                android:textSize="16sp" />

            <View
                android:id="@+id/activity_login_login_title_line_view"
                android:layout_marginTop="6dp"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:background="#244DC6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_login_register_ll"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_60_dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/activity_login_register_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="注册"
                android:textColor="#657ED3"
                android:textSize="16sp" />

            <View
                android:id="@+id/activity_login_register_title_line_view"
                android:layout_marginTop="6dp"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:background="#244DC6"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/bg_white_rounded_12"
        android:orientation="vertical"
        android:padding="@dimen/dimen_30_dp">

        <include
            android:id="@+id/activity_login_tf1"
            layout="@layout/view_round_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp" />

        <include
            android:id="@+id/activity_login_tf2"
            layout="@layout/view_round_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginTop="@dimen/dimen_13_dp" />

        <include
            android:id="@+id/activity_login_tf3"
            layout="@layout/view_round_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginTop="@dimen/dimen_13_dp" />

        <TextView
            android:id="@+id/activity_login_login_tv"
            android:layout_marginTop="@dimen/dimen_13_dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textColor="@color/white"
            android:text="登录"
            android:background="@drawable/bg_3339ff_rounded_28"
            android:textSize="20sp"
            android:gravity="center"
            />
        <TextView
            android:id="@+id/activity_login_forget_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:text="忘记密码？"
            android:textColor="@color/color_666666"
            android:textSize="@dimen/text_size_15" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_login_is_agree_ll"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24_dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/activity_login_is_checked_iv"
            android:layout_width="@dimen/dimen_16_dp"
            android:layout_height="@dimen/dimen_16_dp"
            android:src="@drawable/agree_switch_selector" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_4_dp"
            android:text="登录即阅读并同意"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务协议"
            android:textColor="@color/color_9A75DB"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="和"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私保护指引"
            android:textColor="@color/color_9A75DB"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>

</LinearLayout>