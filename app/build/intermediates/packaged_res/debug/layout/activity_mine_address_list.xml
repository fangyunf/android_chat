<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_address_list_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="地址管理"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_mine_address_list_rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <RelativeLayout
        android:id="@+id/activity_mine_address_list_add_rl"
        android:layout_width="301dp"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dimen_40_dp"
        android:layout_marginBottom="@dimen/dimen_40_dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@mipmap/mine_fragment_address_list_btn_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dimen_19_dp"
                android:layout_height="@dimen/dimen_19_dp"
                android:src="@mipmap/mine_fragment_address_list_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加收获地址"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>