<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:scaleType="fitXY"
        android:src="@mipmap/mine_top_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="215dp"/>

    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        >
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textColor="#ffffffff"
            android:textSize="18sp"
            />
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:gravity="center_vertical"
            >
            <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                android:id="@+id/cavIcon"
                android:layout_width="60dp"
                android:layout_height="60dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="8dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    >
                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text=""
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:ignore="SpUsage" />
                    <ImageView
                        android:id="@+id/fragment_mine_qrcode_iv"
                        android:layout_width="@dimen/dimen_20_dp"
                        android:layout_height="@dimen/dimen_20_dp"
                        android:src="@mipmap/mine_index_ewm"
                        />
                    <ImageView
                        android:layout_marginLeft="10dp"
                        android:id="@+id/fragment_mine_edit_iv"
                        android:layout_width="@dimen/dimen_20_dp"
                        android:layout_height="@dimen/dimen_20_dp"
                        android:src="@mipmap/mine_index_bj"
                        />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="start"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:ignore="SpUsage" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_100_dp"
            android:background="@drawable/mine_top_bg_round_10"
            android:layout_marginHorizontal="10dp"
            >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_pretty_number_tag"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="靓号"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mineFragmentPacketMoneyCl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_qd"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="钱包"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_cj"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="靓号"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
        </LinearLayout>
        <com.yaoxin.appbase.view.IconTitleArrowTemplate
            android:id="@+id/fragment_mine_smrz_view"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:leftImg="@mipmap/mine_index_smrz"
            app:titleText="实名认证"
            />
        <com.yaoxin.appbase.view.IconTitleArrowTemplate
            android:id="@+id/fragment_mine_aqys_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:leftImg="@mipmap/mine_index_aqys"
            app:titleText="安全隐私"
            />
        <com.yaoxin.appbase.view.IconTitleArrowTemplate
            android:id="@+id/fragment_mine_zhaq_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:leftImg="@mipmap/mine_index_zhaq"
            app:titleText="账户安全"
            />
        <com.yaoxin.appbase.view.IconTitleArrowTemplate
            android:id="@+id/fragment_mine_xsqx_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:leftImg="@mipmap/mine_index_xstx"
            app:titleText="消息提醒"
            />
        <com.yaoxin.appbase.view.IconTitleArrowTemplate
            android:id="@+id/fragment_mine_sz_view"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:leftImg="@mipmap/mine_index_sz"
            app:titleText="设置"
            />
    </LinearLayout>


