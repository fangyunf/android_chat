<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="322dp"
    android:layout_height="262dp"
    android:background="@android:color/transparent"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/other_place_login_fragment_bg"
        android:paddingVertical="@dimen/dimen_16_dp"
        android:paddingHorizontal="@dimen/dimen_14_dp"
        android:gravity="center_horizontal"
        >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="设备登陆"
        android:textColor="#ff000000"
        android:textSize="16sp"
        />
    <EditText
        android:id="@+id/fragment_other_place_login_phone_et"
        android:paddingHorizontal="@dimen/dimen_14_dp"
        android:layout_marginTop="@dimen/dimen_14_dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:textSize="@dimen/text_size_14"
        android:hint="请输入手机号"
        android:textColorHint="@color/color_999999"
        android:textColor="@color/black"
        android:background="@color/color_white"
        android:cursorVisible="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dimen_14_dp"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/fragment_other_place_login_input_code_et"
            android:paddingHorizontal="@dimen/dimen_14_dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:textSize="@dimen/text_size_14"
            android:hint="请输入验证码"
            android:textColorHint="@color/color_999999"
            android:textColor="@color/black"
            android:background="@color/color_white"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            />

        <com.yaoxin.appbase.view.loginlib.view.CountDownView
            android:id="@+id/btn_captcha"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/dimen_5_dp"
            android:layout_marginRight="@dimen/dimen_8_dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="获取验证码"
            android:background="@color/white"
            android:textColor="#ff9a75db"
            android:visibility="visible"
            />
    </RelativeLayout>
    <TextView
        android:id="@+id/fragment_other_place_login_confirm_btn"
        android:layout_marginTop="50dp"
        android:layout_width="294dp"
        android:layout_height="38dp"
        android:text="确认"
        android:textColor="#ffffffff"
        android:textSize="16sp"
        android:gravity="center"
        android:background="#B591F5"
        />

</LinearLayout>
</LinearLayout>