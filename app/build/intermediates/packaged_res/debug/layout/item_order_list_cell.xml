<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    >

    <ImageView
        android:layout_width="@dimen/dimen_100_dp"
        android:layout_height="@dimen/dimen_100_dp"

        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_100_dp"
        android:orientation="vertical"
android:layout_marginStart="@dimen/dimen_14_dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/color_333333"
            android:text="床单床笠四件套全棉简约刺绣贡缎"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_4_dp"
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/color_999999"
            android:text="180*200"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen_14_dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/color_333333"
                android:text="实付款"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/color_333333"
                android:text="￥100"
                />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>