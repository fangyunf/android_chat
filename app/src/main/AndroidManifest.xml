            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <meta-data
            android:name="com.vivo.push.api_key"
            android:value="api_key" />
        <meta-data
            android:name="com.vivo.push.app_id"
            android:value="app_id" />

        <receiver
