<?xml version="1.0" encoding="utf-8"?>
<!--
  通栏花财暖橙渐变
  线性：顶 #F05A35 → 中 #FF8A65 → 底 #FFF5F0
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="-90"
                android:centerColor="#FF8A65"
                android:endColor="#FFF5F0"
                android:startColor="#F05A35"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.12"
                android:endColor="#00000000"
                android:gradientRadius="280dp"
                android:startColor="#66FFB899"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
