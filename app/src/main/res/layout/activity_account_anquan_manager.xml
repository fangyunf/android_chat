<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_account_anquan_manager_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="隐私设置"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_F2F2F2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="15dp">

            <!-- 第一部分：加我为朋友时需要验证 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell1"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:text="可通过以下方式找到我"
                android:textColor="@color/color_666666"
                android:textSize="12sp" />

            <!-- 第二部分：可通过以下方式找到我 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">


                <include
                    android:id="@+id/activity_account_anquan_manager_cell2"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell3"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:text="可通过以下方式添加我"
                android:textColor="@color/color_666666"
                android:textSize="12sp" />
            <!-- 第三部分：可通过以下方式添加我 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell4"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell5"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell6"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>