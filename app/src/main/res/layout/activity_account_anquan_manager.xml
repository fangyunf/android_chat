<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_base"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_account_anquan_manager_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="安全隐私"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_20_dp"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:text="隐私设置"
                android:textColor="@color/color_333333"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_20_dp"
                android:layout_marginTop="5dp"
                android:text="全程守护您的隐私安全"
                android:textColor="@color/color_333333"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:paddingVertical="@dimen/dimen_16_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_20_dp"
                    android:text="通知设置"
                    android:textColor="@color/color_333333"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_20_dp"
                    android:layout_marginTop="5dp"
                    android:text="设置您的通知声音"
                    android:textColor="@color/color_999999"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/activity_setting"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_44_dp"
                    android:layout_marginHorizontal="@dimen/dimen_20_dp"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:background="@drawable/btn_bg"
                    android:gravity="center"
                    android:text="立即设置"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell6"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell7"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell1"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell2"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell3"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell4"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/activity_account_anquan_manager_cell5"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</LinearLayout>