<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_account_anquan_manager_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="隐私设置"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 总开关 addState -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell6"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 加好友需验证 check -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell1"
                    layout="@layout/view_title_detail_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 添加方式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingBottom="8dp"
                    android:text="添加我为好友的方式"
                    android:textColor="#ff000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 账号 phoneAdd -->
                <include
                    android:id="@+id/activity_account_anquan_manager_cell2"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 二维码 qrAdd -->
                <include
                    android:id="@+id/activity_account_anquan_manager_cell5"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ID idAdd -->
                <include
                    android:id="@+id/activity_account_anquan_manager_cell3"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 名片 cardAdd -->
                <include
                    android:id="@+id/activity_account_anquan_manager_cell4"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 保留原 cell7，暂不展示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/activity_account_anquan_manager_cell7"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
