<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_bind_usdt_entry_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="USDT"
        app:title_text_color="@color/color_black"
        app:under_divider_color="@color/transparent" />

    <LinearLayout
        android:id="@+id/activity_bind_usdt_entry_info_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_white_rounded_10"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已绑定USDT"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_bind_usdt_entry_address_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/color_999999"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_bind_usdt_entry_rebind_tv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="重新绑定"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_bind_usdt_entry_empty_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:src="@mipmap/common_empty_pic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="还没有绑定USDT，快去绑定吧~"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/activity_bind_usdt_entry_goto_bind_tv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_app_theme_color_rounded_4"
            android:gravity="center"
            android:text="去绑定"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
