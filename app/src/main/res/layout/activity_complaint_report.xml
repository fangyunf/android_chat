<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_complaint_report_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/color_white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="投诉举报"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/color_E8E8E8" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="问题类型"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/activity_complaint_report_type_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <RadioButton
                    android:id="@+id/activity_complaint_report_type_rb_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="44dp"
                    android:text="骚扰/垃圾信息"
                    android:textColor="@color/color_333333"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/activity_complaint_report_type_rb_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="欺诈/诱导交易"
                    android:textColor="@color/color_333333"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/activity_complaint_report_type_rb_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="不当言论/人身攻击"
                    android:textColor="@color/color_333333"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/activity_complaint_report_type_rb_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="侵犯隐私/其他"
                    android:textColor="@color/color_333333"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="相关账号或群 ID（选填）"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/activity_complaint_report_target_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:hint="例如对方用户 ID、群号等"
                android:inputType="text"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="问题描述"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="请尽量说明时间、经过，便于我们核实（不少于 10 个字）"
                android:textColor="@color/color_999999"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/activity_complaint_report_desc_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:gravity="top|start"
                android:hint="请在此填写详细说明…"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="120dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="联系电话（选填）"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/activity_complaint_report_phone_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:hint="方便客服回访时联系您"
                android:inputType="phone"
                android:maxLength="11"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:text="说明：以上为演示表单，提交后仅作本地提示，未实际上传服务器。接入接口后可在 Activity 内替换提交逻辑。"
                android:textColor="@color/color_999999"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/activity_complaint_report_submit_tv"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_app_theme_color_rounded_10"
        android:gravity="center"
        android:text="提交"
        android:textColor="@color/color_white"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
