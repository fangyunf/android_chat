<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    >

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_exchange_account_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="切换账号"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_exchange_account_rv"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="wrap_content"/>
    
    <TextView
        android:id="@+id/activity_exchange_account_tuichu_tv"
        android:gravity="center"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textSize="18sp"
        android:text="退出登录"
        android:background="@drawable/bg_f2f2f2_rounded_10"
        />
</LinearLayout>