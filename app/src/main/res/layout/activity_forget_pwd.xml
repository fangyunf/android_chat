<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/register_activity_back_iv"
        android:layout_width="@dimen/dimen_20_dp"
        android:layout_height="@dimen/dimen_30_dp"
        android:layout_marginLeft="@dimen/dimen_30_dp"
        android:layout_marginTop="20dp"
        android:src="@mipmap/temp_ic_back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_30_dp"
        android:layout_marginTop="30dp"
        android:text="忘记密码"
        android:textColor="@color/app_theme_color"
        android:textSize="@dimen/text_size_26"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_30_dp"
        android:orientation="vertical"
        android:paddingLeft="30dp"
        android:paddingRight="30dp">

        <include
            android:id="@+id/forget_pwd_activity_phone_tf"
            layout="@layout/view_title_tf_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_code_tf"
            layout="@layout/view_title_tf_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_pwd_tf"
            layout="@layout/view_title_tf_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <include
            android:id="@+id/forget_pwd_activity_pwd2_tf"
            layout="@layout/view_title_tf_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp" />

        <LinearLayout
            android:id="@+id/forget_pwd_activity_is_agree_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/dimen_24_dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/forget_pwd_activity_is_checked_iv"
                android:layout_width="@dimen/dimen_16_dp"
                android:layout_height="@dimen/dimen_16_dp"
                android:src="@drawable/agree_switch_selector" />

            <TextView
                android:id="@+id/forget_pwd_activity_is_checked_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_4_dp"
                android:clickable="true"
                android:focusable="true"
                android:text="我已阅读并同意《用户协议》、《隐私政策》"
                android:textColor="@color/color_333333"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>

        <TextView
            android:id="@+id/forget_pwd_activity_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginTop="@dimen/dimen_24_dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>

</LinearLayout>