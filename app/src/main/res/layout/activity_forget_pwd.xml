<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2f2f2">

    <!-- 导航栏 -->
    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/forget_pwd_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="重置密码"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/forget_pwd_activity_nav"
        android:fillViewport="true"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- 图标 -->
            <ImageView
                android:id="@+id/iv_reset_icon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="重置密码图标"
                android:src="@mipmap/forget_wallet_top" />

            <!-- 描述文字 -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="您的密码将进行重置,请妥善保存您的新密码"
                android:textColor="@color/color_999999"
                android:textSize="14sp" />

            <!-- 手机号输入框 -->
            <include
                android:id="@+id/forget_pwd_activity_phone_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <!-- 验证码输入框 -->
            <include
                android:id="@+id/forget_pwd_activity_code_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 新密码输入框 -->
            <include
                android:id="@+id/forget_pwd_activity_pwd_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 确定按钮 -->
            <TextView
                android:id="@+id/forget_pwd_activity_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_green_rounded_10"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
