<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/forget_pwd_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="false"
        app:support_translucent_status_bar="false"
        app:title="重置密码"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/forget_pwd_activity_nav"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <ImageView
                android:id="@+id/iv_reset_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="您的密码将进行重置，请妥善保存您的新密码"
                android:textColor="#999999"
                android:textSize="13sp" />

            <include
                android:id="@+id/forget_pwd_activity_phone_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp" />

            <include
                android:id="@+id/forget_pwd_activity_code_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/forget_pwd_activity_pwd_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/forget_pwd_activity_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_theme_capsule"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
