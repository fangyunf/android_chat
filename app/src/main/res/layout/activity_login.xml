<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/activity_login_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/common_login_bg"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/activity_login_title_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="120dp"
        android:src="@mipmap/common_login_title_login"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="30dp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_centerHorizontal="true"
            android:src="@mipmap/yaoxin_icon"
            app:riv_corner_radius="6dp" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="190dp"
        android:background="@drawable/white_bg_rounded_top_20"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimen_30_dp">

            <include
                android:id="@+id/activity_login_tf1"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_login_tf2"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />

            <include
                android:id="@+id/activity_login_tf3"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />

            <TextView
                android:id="@+id/activity_login_forget_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/dimen_10_dp"

                android:text="忘记密码"
                android:textColor="@color/app_theme_color"
                android:textSize="@dimen/text_size_15" />

            <LinearLayout
                android:id="@+id/activity_login_is_agree_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dimen_24_dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/activity_login_is_checked_iv"
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="@dimen/dimen_16_dp"
                    android:src="@drawable/agree_switch_selector" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_4_dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="我已阅读并同意《用户协议》、《隐私政策》"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_login_login_tv"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/dimen_24_dp"
                android:background="@drawable/bg_3339ff_rounded_28"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_login_register_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="14dp"
                android:text="没账号?点击注册>"
                android:textColor="@color/app_theme_color"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>