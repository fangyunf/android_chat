<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/login_tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="132dp"
        android:text="欢迎来到慎语"
        android:textSize="@dimen/text_size_26"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/activity_login_ll1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8_dp"
        app:layout_constraintLeft_toLeftOf="@+id/login_tv1"
        app:layout_constraintTop_toBottomOf="@+id/login_tv1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有账号，立即"
            android:textColor="@color/color_666666"
            android:textSize="@dimen/text_size_15" />

        <TextView
            android:id="@+id/activity_login_reg_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="注册"
            android:textColor="@color/color_9A75DB"
            android:textSize="@dimen/text_size_15" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="37dp"
        android:layout_marginTop="@dimen/dimen_20_dp"
        android:layout_marginRight="37dp"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="@+id/activity_login_ll1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_login_ll1">

        <include
            android:id="@+id/activity_login_tf1"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp" />

        <include
            android:id="@+id/activity_login_tf2"
            layout="@layout/view_title_tf"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_16_dp"
            app:layout_constraintLeft_toLeftOf="@+id/activity_login_ll1"
            app:layout_constraintTop_toBottomOf="@+id/activity_login_tf1" />

        <TextView
            android:id="@+id/activity_login_forget_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:text="忘记密码？"
            android:textColor="@color/color_666666"
            android:textSize="@dimen/text_size_15" />


        <Button
            android:id="@+id/activity_login_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:background="@mipmap/login_btn_bg"
            android:text="登录"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_16" />
        <LinearLayout
            android:id="@+id/activity_login_is_agree_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24_dp"
            android:gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/activity_login_is_checked_iv"
                android:layout_width="@dimen/dimen_16_dp"
                android:src="@drawable/agree_switch_selector"
                android:layout_height="@dimen/dimen_16_dp"/>

            <TextView
                android:id="@+id/activity_login_is_checked_txt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_4_dp"
                android:text="登录即阅读并同意"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/text_size_13" />
            <TextView
                android:id="@+id/activity_login_is_checked_txt2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务协议"
                android:textColor="@color/color_9A75DB"
                android:textSize="@dimen/text_size_13" />
            <TextView
                android:id="@+id/activity_login_is_checked_txt3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="和"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/text_size_13" />
            <TextView
                android:id="@+id/activity_login_is_checked_txt4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="隐私保护指引"
                android:textColor="@color/color_9A75DB"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>