<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/le_login_bg">

        <ImageView
            android:id="@+id/activity_login_bg_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@mipmap/common_login_bg"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/activity_login_title_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="120dp"
            android:src="@mipmap/common_login_title_login"
            android:visibility="gone" />

        <TextView
            android:id="@+id/activity_login_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:text="注册"
            android:textColor="#ff000000"
            android:textSize="21sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginTop="@dimen/dimen_40_dp"
                android:layout_marginRight="@dimen/dimen_16_dp"
                android:drawableRight="@mipmap/icon_right_arrow"
                android:drawablePadding="@dimen/dimen_5_dp"
                android:text="注册"
                android:textColor="#ff000000"
                android:textSize="18sp" />

            <com.zhihu.matisse.internal.ui.widget.RoundedRectangleImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/dimen_30_dp"
                android:src="@mipmap/yaoxin_icon" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="30dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/activity_login_tf1"
                        layout="@layout/view_title_tf_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/activity_login_tf2"
                        layout="@layout/view_title_tf_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_13_dp" />

                    <include
                        android:id="@+id/activity_login_tf3"
                        layout="@layout/view_title_tf_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_13_dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/dimen_16_dp">

                        <TextView
                            android:id="@+id/activity_login_forget_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/dimen_10_dp"
                            android:text="忘记密码？"
                            android:textColor="@color/color_666666"
                            android:textSize="@dimen/text_size_15" />

                        <TextView
                            android:id="@+id/tv_account_appeal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginTop="@dimen/dimen_10_dp"
                            android:text="账号申诉"
                            android:textColor="@color/app_theme_color"
                            android:textSize="@dimen/text_size_15"
                            android:visibility="gone" />
                    </RelativeLayout>


                    <TextView
                        android:id="@+id/activity_login_login_tv"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_30_dp"
                        android:background="@drawable/fun_bg_app_theme_color_rounded_26"
                        android:gravity="center"
                        android:text="登录"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_login_register_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/dimen_10_dp"
                        android:text="没有账号,去注册"
                        android:textColor="@color/app_theme_color"
                        android:textSize="@dimen/text_size_15" />
                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/activity_login_is_agree_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen_24_dp"
                android:layout_marginBottom="@dimen/dimen_30_dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/activity_login_is_checked_iv"
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="@dimen/dimen_16_dp"
                    android:src="@drawable/agree_switch_selector" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_4_dp"
                    android:text="登录即阅读并同意"
                    android:textColor="@color/color_999999"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《服务协议》"
                    android:textColor="@color/app_theme_color"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和"
                    android:textColor="@color/color_999999"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="《隐私保护指引》"
                    android:textColor="@color/app_theme_color"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>