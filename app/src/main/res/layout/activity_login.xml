<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/activity_login_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/login_top_bg" />

    <ImageView
        android:visibility="gone"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="120dp"
        android:id="@+id/activity_login_title_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/common_login_title_login" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello!"
            android:textColor="@color/black"
            android:textSize="30sp"
            />
        <ImageView
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:src="@mipmap/yaoxin_icon"
            />

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/activity_login_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="注册"
            android:textColor="#ff000000"
            android:textSize="30sp"
            />
    </LinearLayout>
    <RelativeLayout
        android:layout_marginTop="190dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:layout_marginHorizontal="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/login_content_bg"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:paddingHorizontal="20dp"
            android:layout_height="50dp">
            <RelativeLayout
                android:id="@+id/activity_login_login_rl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:layout_centerInParent="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录"
                    android:textColor="#ff000000"
                    android:textSize="20sp"
                    />
                <View
                    android:id="@+id/activity_login_login_rl_line"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:background="@drawable/green_yellow_jianbian_8"
                    />
            </RelativeLayout>
            <RelativeLayout

                android:id="@+id/activity_login_register_rl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:layout_centerInParent="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注册"
                    android:textColor="#ff000000"
                    android:textSize="20sp"
                    />
                <View

                    android:visibility="gone"
                    android:id="@+id/activity_login_register_rl_line"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:background="@drawable/green_yellow_jianbian_8"
                    />
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginHorizontal="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <include
                android:id="@+id/activity_login_tf1"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_login_tf2"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />

            <include
                android:id="@+id/activity_login_tf3"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />
            <TextView
                android:id="@+id/activity_login_forget_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:text="忘记密码？"
                android:layout_marginEnd="30dp"
                android:textColor="@color/color_666666"
                android:textSize="@dimen/text_size_15" />
            <TextView
                android:id="@+id/activity_login_login_tv"
                android:layout_width="253dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/dimen_13_dp"
                android:background="@drawable/green_yellow_jianbian_8"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                android:visibility="gone"
                android:id="@+id/activity_login_register_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:text="没有账号,去注册"
                android:textColor="@color/app_theme_color"
                android:textSize="@dimen/text_size_15" />
        </LinearLayout>

