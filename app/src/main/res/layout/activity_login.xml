<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome_page">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_login_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="   "
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <ImageView
        android:id="@+id/activity_login_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/common_login_bg"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/activity_login_title_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@mipmap/common_login_title_login"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/activity_mine_login_nav"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Logo / 标题 -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="28dp"
                android:src="@mipmap/ic_welcome_logo" />

            <TextView
                android:id="@+id/activity_login_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="优优"
                android:textColor="#305838"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="欢迎使用优优"
                android:textColor="#8AA090"
                android:textSize="14sp" />

            <!-- 输入区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <include
                    android:id="@+id/activity_login_tf1"
                    layout="@layout/view_login_tf_count"
                    android:layout_width="match_parent"
                    android:layout_height="50dp" />

                <include
                    android:id="@+id/activity_login_tf2"
                    layout="@layout/view_login_tf_count"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp" />

                <include
                    android:id="@+id/activity_login_tf3"
                    layout="@layout/view_login_tf_count"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/activity_login_login_tv"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_welcome_btn_login"
                    android:gravity="center"
                    android:text="登录"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/activity_login_register_tv"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_welcome_btn_register"
                    android:gravity="center"
                    android:text="立即注册"
                    android:textColor="#305838"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/activity_login_forget_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="忘记密码?"
                    android:textColor="#5C9C6C"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
