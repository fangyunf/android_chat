<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ImageView
        android:visibility="gone"
        android:id="@+id/activity_login_title_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/login_bg_1" />
    <ImageView
        android:layout_centerHorizontal="true"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="100dp"
        android:scaleType="fitXY"
        android:src="@mipmap/yaoxin_icon" />


    <LinearLayout
        android:layout_marginTop="220dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:id="@+id/activity_login_type_tv"
            android:layout_width="165dp"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/dimen_13_dp"
            android:background="@drawable/bg_app_theme_color_rounded_10"
            android:gravity="center"
            android:text="手机号登录"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/activity_login_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="注册"
            android:layout_gravity="center_horizontal"
            android:textColor="#ff000000"
            android:textSize="24sp"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <include
                android:id="@+id/activity_login_tf1"
                layout="@layout/view_title_tf_count_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_login_tf2"
                layout="@layout/view_title_tf_count_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />

            <include
                android:id="@+id/activity_login_tf3"
                layout="@layout/view_title_tf_count_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_13_dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="10dp"
                >
                <TextView
                    android:id="@+id/activity_login_register_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:text="新用户注册"
                    android:textColor="@color/app_theme_color"
                    android:textSize="@dimen/text_size_15" />
                <TextView
                    android:id="@+id/activity_login_forget_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="忘记密码"
                    android:textColor="@color/color_666666"
                    android:textSize="@dimen/text_size_15" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_login_login_tv"
                android:layout_width="370dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/dimen_13_dp"
                android:background="@drawable/bg_app_theme_color_rounded_10"
                android:gravity="center"
                android:text="登录"
                android:textColor="@color/white"
                android:textSize="20sp" />


        </LinearLayout>

