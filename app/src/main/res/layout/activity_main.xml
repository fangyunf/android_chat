<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="1"
        tools:ignore="MissingConstraints" />


    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="#E2E2E2"
        app:layout_constraintBottom_toTopOf="@+id/bottom_group"
        app:layout_constraintStart_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/bottom_group"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/white"
        android:clipChildren="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints">

        <RelativeLayout
            android:id="@+id/conversation_btn_shop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="tabClick"
            android:visibility="gone">

            <TextView
                android:id="@+id/conversation_shop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableTop="@mipmap/mine_tabbar_shop_sel"
                android:drawablePadding="3dp"
                android:gravity="center"
                android:text="商城"
                android:textColor="@color/tab_checked_color"
                android:textSize="12sp" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/conversation_btn_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="tabClick">

            <TextView
                android:id="@+id/conversation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableTop="@mipmap/mine_tabbar_msg_sel"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="消息"
                android:textColor="@color/tab_checked_color"
                android:textSize="12sp" />

            <View
                android:id="@+id/conversation_dot"
                android:layout_width="@dimen/dimen_6_dp"
                android:layout_height="@dimen/dimen_6_dp"
                android:layout_alignRight="@+id/conversation"
                android:layout_marginLeft="@dimen/dimen_10_dp"
                android:layout_marginTop="@dimen/dimen_7_dp"
                android:background="@drawable/bg_conversation_red_dot"
                android:visibility="gone" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/conversation_btn_group1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="tabClick">

            <TextView
                android:id="@+id/conversation1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableTop="@mipmap/mine_tabbar_msg_group_normal"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="群聊"
                android:textColor="@color/tab_unchecked_color"
                android:textSize="12sp" />

            <View
                android:id="@+id/conversation_dot1"
                android:layout_width="@dimen/dimen_6_dp"
                android:layout_height="@dimen/dimen_6_dp"
                android:layout_alignRight="@+id/conversation1"
                android:layout_marginLeft="@dimen/dimen_10_dp"
                android:layout_marginTop="@dimen/dimen_7_dp"
                android:background="@drawable/bg_conversation_red_dot"
                android:visibility="gone" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/contact_btn_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="tabClick">

            <TextView
                android:id="@+id/contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableTop="@mipmap/mine_tabbar_txl_normal"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="联系人"
                android:textColor="@color/tab_unchecked_color"
                android:textSize="12sp" />

            <View
                android:id="@+id/contact_dot"
                android:layout_width="@dimen/dimen_6_dp"
                android:layout_height="@dimen/dimen_6_dp"
                android:layout_alignEnd="@+id/contact"
                android:layout_marginTop="@dimen/dimen_7_dp"
                android:layout_marginEnd="@dimen/dimen_4_dp"
                android:background="@drawable/bg_conversation_red_dot"
                android:visibility="gone" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/myself_btn_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:onClick="tabClick">

            <TextView
                android:id="@+id/mine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableTop="@mipmap/mine_tabbar_mine_normal"
                android:drawablePadding="2dp"
                android:gravity="center"
                android:text="我的"
                android:textColor="@color/tab_unchecked_color"
                android:textSize="12sp" />

        </RelativeLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>