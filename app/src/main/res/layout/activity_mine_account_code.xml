<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    >

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_account_code_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:support_translucent_status_bar="false"
        app:title="我的二维码"
        app:title_text_color="@color/color_333333"/>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:background="@color/white"
            android:layout_marginTop="80dp"
            android:layout_width="317dp"
            android:layout_centerHorizontal="true"
            android:layout_height="345dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/account_code_bg"
                />
            <ImageView
                android:id="@+id/activity_mine_account_code_code_iv"
                android:layout_marginTop="140dp"
                android:layout_centerHorizontal="true"
                android:layout_width="150dp"
                android:layout_height="150dp"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            >


            <com.makeramen.roundedimageview.RoundedImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:riv_corner_radius="29dp"
                android:scaleType="centerCrop"
                android:id="@+id/activity_mine_account_code_head_iv"
                />
            <TextView
                android:layout_marginTop="15dp"
                android:id="@+id/activity_mine_account_code_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="会飞的洋芋"
                android:textColor="#ff000000"
                android:textSize="20sp"
                />
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/activity_mine_account_code_save_photo"
        android:layout_marginTop="20dp"
        android:layout_width="194dp"
        android:layout_height="44dp"
        android:text="保存至相册"
        android:textColor="#ffffffff"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        />
</LinearLayout>