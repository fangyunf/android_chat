<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F6F6F6"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    >

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_account_code_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="我的二维码"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dimen_16_dp"
        android:gravity="center_vertical"
        >


        <com.makeramen.roundedimageview.RoundedImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:riv_corner_radius="29dp"
            android:scaleType="centerCrop"
            android:id="@+id/activity_mine_account_code_head_iv"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="@dimen/dimen_12_dp"
            >
            <TextView
                android:id="@+id/activity_mine_account_code_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="会飞的洋芋"
                android:textColor="#ff000000"
                android:textSize="20sp"
                />
            <TextView
                android:id="@+id/activity_mine_account_code_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="ID:87988656"
                android:textColor="#ff999999"
                android:textSize="16sp"
                />

        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="289dp"
        android:layout_height="299dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/mine_accout_code_bg"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="扫一扫二维码，加我为好友"
            android:textColor="#ff666666"
            android:textSize="16sp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dimen_20_dp"
            />
        <ImageView
            android:id="@+id/activity_mine_account_code_code_iv"
            android:layout_marginTop="@dimen/dimen_80_dp"
            android:layout_centerHorizontal="true"
            android:layout_width="170dp"
            android:layout_height="173dp"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/activity_mine_account_code_save_photo"
        android:layout_marginTop="20dp"
        android:layout_width="194dp"
        android:layout_height="38dp"
        android:text="保存至相册"
        android:textColor="#ffffffff"
        android:textSize="16sp"
        android:gravity="center"
        android:background="#B591F5"
        />
</LinearLayout>