<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1">

    <!--    <ImageView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:scaleType="fitXY"-->
    <!--        android:src="@mipmap/common_top_bg" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_account_code_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:support_translucent_status_bar="false"
            app:title="我的二维码"
            app:title_text_color="@color/black"
            app:under_divider_color="@android:color/transparent" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="317dp"
                android:layout_height="345dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="80dp">

                <!--                <ImageView-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="match_parent"-->
                <!--                    android:src="@mipmap/account_code_bg" />-->


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/activity_mine_account_code_head_iv"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="@dimen/dimen_30_dp"
                    android:scaleType="centerCrop"
                    app:riv_corner_radius="29dp" />

                <TextView
                    android:id="@+id/activity_mine_account_code_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="15dp"
                    android:text="会飞的洋芋"
                    android:textColor="#ff000000"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/activity_mine_account_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="会飞的洋芋"
                    android:textColor="@color/color_black"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/activity_mine_account_code_code_iv"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/dimen_30_dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:text="扫一扫二维码，加我好友"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>


        <TextView
            android:id="@+id/activity_mine_account_code_save_photo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_50_dp"
            android:layout_marginHorizontal="@dimen/dimen_20_dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_app_theme_color_rounded_10"
            android:gravity="center"
            android:text="保存二维码至相册"
            android:textColor="#ffffffff"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>