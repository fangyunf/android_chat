<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_account_qr_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_account_code_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:support_translucent_status_bar="false"
            app:title="我的二维码"
            app:title_text_color="@color/white"
            app:under_divider_color="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/activity_mine_account_code_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_account_qr_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/activity_mine_account_code_head_iv"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/app_default_base_icon_geren"
                app:riv_corner_radius="36dp" />

            <TextView
                android:id="@+id/activity_mine_account_code_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/activity_mine_account_code_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_account_qr_id_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:textColor="#666666"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_account_qr_code_box"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/activity_mine_account_code_code_iv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="扫一扫上面的二维码，加我为好友"
                android:textColor="#999999"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_account_code_save_photo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_account_qr_save_btn"
            android:gravity="center"
            android:text="保存到相册"
            android:textColor="#1A335B"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>
