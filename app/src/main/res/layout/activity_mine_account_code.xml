<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_account_code_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:support_translucent_status_bar="false"
            app:title="二维码"
            app:title_text_color="@color/black"
            app:under_divider_color="@android:color/transparent" />

        <!-- 保存到相册的完整名片区域（图2效果） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activity_mine_account_code_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#EAF4FB">

            <!-- 正圆同心圆背景，与二维码同中心 -->
            <com.turunsi.yaoxin.main.mine.account.QrConcentricCircleView
                android:id="@+id/activity_mine_account_code_circle_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 二维码固定在圆正中心 -->
            <ImageView
                android:id="@+id/activity_mine_account_code_code_iv"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@id/activity_mine_account_code_circle_bg"
                app:layout_constraintEnd_toEndOf="@id/activity_mine_account_code_circle_bg"
                app:layout_constraintStart_toStartOf="@id/activity_mine_account_code_circle_bg"
                app:layout_constraintTop_toTopOf="@id/activity_mine_account_code_circle_bg" />

            <!-- 头像/昵称/ID 在二维码上方 -->
            <LinearLayout
                android:id="@+id/activity_mine_account_code_user_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/activity_mine_account_code_code_iv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/activity_mine_account_code_head_iv"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/app_default_base_icon_geren"
                    app:riv_corner_radius="28dp" />

                <TextView
                    android:id="@+id/activity_mine_account_code_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#1A1A1A"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/activity_mine_account_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_mine_account_code_tip_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="打开昌盛扫一扫，添加好友"
                android:textColor="#999999"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/activity_mine_account_code_code_iv" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/activity_mine_account_code_save_photo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_pink_gradient_capsule"
            android:gravity="center"
            android:text="保存"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>
