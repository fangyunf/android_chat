<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_account_detail_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/app_theme_color"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="我的资料"
            app:title_text_color="@color/white"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_12_dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/flAvatar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_50_dp">

                <TextView
                    android:id="@+id/tvAvatarTip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:gravity="center"
                    android:text="@string/user_info_avatar"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/cavAvatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="34dp"
                    android:scaleType="fitXY"
                    app:riv_corner_radius="@dimen/dimen_18_dp" />

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="@dimen/dimen_20_dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_frame_mine_right_arrow" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/flName"
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/tvNameTip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dimen_16_dp"
                    android:gravity="center"
                    android:text="@string/user_info_nickname"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="@dimen/dimen_50_dp"
                    android:layout_marginEnd="34dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_666666"
                    android:textSize="14dp" />

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="@dimen/dimen_20_dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_frame_mine_right_arrow" />
            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dimen_16_dp"
                    android:gravity="center"
                    android:text="手机号"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="@dimen/dimen_50_dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_666666"
                    android:textSize="14dp" />


            </FrameLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dimen_16_dp"
                    android:gravity="center"
                    android:text="ID号"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvId"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="@dimen/dimen_50_dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_666666"
                    android:textSize="14dp" />

            </FrameLayout>

        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/white_bg_rounded_top_20"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingBottom="15dp"

                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/activity_mine_account_detail_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/activity_mine_account_detail_id_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_black_alpha_20_rounded_10"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:textColor="#ffffffff"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/activity_mine_account_detail_head_iv"
                android:layout_width="61dp"
                android:layout_height="61dp"
                android:layout_centerHorizontal="true"
                android:scaleType="centerCrop"
                app:riv_corner_radius="30dp" />

            <LinearLayout
                android:id="@+id/activity_mine_account_detail_modify_head_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="80dp"
                android:layout_marginEnd="40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="19dp"
                    android:src="@mipmap/mine_accout_detail_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="上传头像"
                    android:textColor="#ff666666"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的昵称"
                android:textColor="#ff000000"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="昵称7天内只能修改一次"
                android:textColor="#ff999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_account_detail_modify_name_tv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_white_rounded_10"
            android:gravity="center"
            android:text="修改名字"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的ID"
                android:textColor="#ff000000"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="暂不可在此修改"
                android:textColor="#ff999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_account_detail_detail_id_tv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/white_bg_rounded_top_20"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp"
            android:text=""
            android:textColor="@color/black"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的手机号"
                android:textColor="#ff000000"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="暂不可在此修改"
                android:textColor="#ff999999"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_account_detail_phone_num_tv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/white_bg_rounded_top_20"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp"
            android:text=""
            android:textColor="@color/black"
            android:textSize="15sp"
            android:visibility="gone" />
        <!--        <TextView-->
        <!--            android:id="@+id/activity_mine_account_code_save_photo"-->
        <!--            android:layout_marginTop="50dp"-->
        <!--            android:layout_gravity="center_horizontal"-->
        <!--            android:layout_width="194dp"-->
        <!--            android:layout_height="44dp"-->
        <!--            android:text="确定"-->
        <!--            android:textColor="#ffffffff"-->
        <!--            android:textSize="16sp"-->
        <!--            android:gravity="center"-->
        <!--            android:background="@drawable/fun_bg_app_theme_color_rounded_22"-->
        <!--            />-->
    </LinearLayout>
</RelativeLayout>