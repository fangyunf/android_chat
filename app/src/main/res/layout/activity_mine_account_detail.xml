    <!-- 头像部分 -->
    <LinearLayout
        android:id="@+id/llAvatarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_mine_account_detail_nav">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/activity_mine_account_detail_head_iv"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            app:riv_corner_radius="40dp" />

        <TextView
            android:id="@+id/tvSetPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置新照片"
            android:textColor="@color/color_999999"
            android:textSize="14dp" />
    </LinearLayout>

    <!-- 用户信息区域 -->
    <LinearLayout
        android:id="@+id/llUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_20_dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="@dimen/dimen_20_dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llAvatarContainer"
        tools:ignore="SpUsage">

        <!-- 用户名 -->
        <FrameLayout
            android:id="@+id/flName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_rounded_12"
            android:paddingStart="@dimen/dimen_16_dp"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/dimen_16_dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvNameTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="用户名"
                android:textColor="@color/color_333333"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/activity_mine_account_detail_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginStart="80dp"
                android:background="@color/transparent"
                android:gravity="end|center_vertical"
                android:hint="点击更改"
                android:singleLine="true"
                android:textColor="@color/color_333333"
                android:textColorHint="#999999"
                android:textSize="16dp" />


        </FrameLayout>

        <TextView
            android:id="@+id/tvNameHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:layout_marginBottom="10dp"
            android:text="点击输入或更改你的名字"
            android:textColor="@color/color_999999"
            android:textSize="14dp" />


        <!-- 我的昵称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_rounded_12"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/flNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_16_dp"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/dimen_16_dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvNicknameTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:text="我的昵称"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="80dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/dimen_16_dp"
                android:layout_marginEnd="@dimen/dimen_16_dp"
                android:background="@color/color_f5f8fc" />

            <!-- 我的账号 -->
            <FrameLayout
                android:id="@+id/flAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dimen_16_dp"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/dimen_16_dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvAccountTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:text="我的账号"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/activity_mine_account_detail_detail_id_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginStart="80dp"
                    android:gravity="end|center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/color_333333"
                    android:textSize="16dp" />

                <ImageView
                    android:id="@+id/ivAccountCopy"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="0dp"
                    android:src="@mipmap/ic_copy"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部按钮区域 -->
    <LinearLayout
        android:id="@+id/llBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_20_dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="@dimen/dimen_20_dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/llUserInfo">

        <!-- 切换其他账号 -->
        <TextView
            android:id="@+id/tvSwitchAccount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_white_rounded_10"
            android:gravity="center"
            android:text="切换其他账号"
            android:textColor="@color/color_8f55ff"
            android:textSize="16dp" />

        <!-- 退出当前账号 -->
        <TextView
            android:id="@+id/tvLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_white_rounded_10"
            android:gravity="center"
            android:text="退出当前账号"
            android:textColor="@color/color_FF3A3A"
            android:textSize="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
