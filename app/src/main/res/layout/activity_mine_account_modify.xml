<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_ededed"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_account_modify_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="修改用户名"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />


    <com.netease.yunxin.kit.common.ui.widgets.CleanableEditText
        android:id="@+id/activity_mine_account_modify_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/modify_username_hint" />

    <TextView
        android:id="@+id/activity_mine_account_modify_rl"
        android:layout_width="301dp"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_marginTop="@dimen/dimen_40_dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="保存"
        android:textColor="#ffffffff"

        android:textSize="16sp" />
</LinearLayout>