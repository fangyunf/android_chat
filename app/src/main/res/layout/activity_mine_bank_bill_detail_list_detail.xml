<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    >

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_bank_bill_detail_list_detail_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="账单详情"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />

    <ImageView
        android:id="@+id/activity_mine_bank_bill_detail_list_detail_icon_iv"
        android:layout_marginTop="@dimen/dimen_20_dp"
        android:layout_width="@dimen/dimen_56_dp"
        android:layout_height="@dimen/dimen_56_dp"/>
    <TextView
        android:id="@+id/activity_mine_bank_bill_detail_list_detail_title_tv"
        android:layout_marginTop="@dimen/dimen_16_dp"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="专属购物券-发给陈多多"
        android:textColor="#ff000000"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/activity_mine_bank_bill_detail_list_detail_money_tv"
        android:layout_marginTop="@dimen/dimen_10_dp"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:text="-196.00"
        android:textColor="#ff000000"
        android:textSize="26sp"
        />
    <LinearLayout
        android:layout_marginTop="@dimen/dimen_14_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp">
        <LinearLayout
            android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell1"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell1_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="当前状态"
                android:textColor="#ff888888"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell1_detail"
                android:layout_marginLeft="@dimen/dimen_12_dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付成功"
                android:textColor="#ff000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell2"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell2_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="红包详情"
                android:textColor="#ff888888"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell2_detail_tv"
                android:layout_marginLeft="@dimen/dimen_12_dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付成功"
                android:textColor="#8B5FD8"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell3"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell3_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付时间"
                android:textColor="#ff888888"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell3_detail_tv"
                android:layout_marginLeft="@dimen/dimen_12_dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付成功"
                android:textColor="#ff000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell4"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell4_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付方式"
                android:textColor="#ff888888"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell4_detail_tv"
                android:layout_marginLeft="@dimen/dimen_12_dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付成功"
                android:textColor="#ff000000"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell5"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell5_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="交易单号"
                android:textColor="#ff888888"
                android:textSize="16sp"
                />
            <TextView
                android:id="@+id/activity_mine_bank_bill_detail_list_detail_cell5_detail_tv"
                android:layout_marginLeft="@dimen/dimen_12_dp"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="支付成功"
                android:textColor="#ff000000"
                android:textSize="16sp"
                />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>