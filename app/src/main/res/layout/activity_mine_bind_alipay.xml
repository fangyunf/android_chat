<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_bind_alipay_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="支付宝"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/activity_mine_bind_alipay_goto_bind_ll"
        android:layout_marginTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/common_empty_pic"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有绑定支付宝，快去绑定吧~"
            android:textColor="#ff333333"
            android:textSize="15sp"
            />
        <TextView
            android:id="@+id/activity_mine_bind_alipay_goto_bind_tv"
            android:layout_marginTop="24dp"
            android:layout_width="82dp"
            android:layout_height="44dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="去绑定"
            android:textColor="#ffffffff"
            android:textSize="15sp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_rebind_ll"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/activity_mine_bind_alipay_rebind_content"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginHorizontal="15dp"
            layout="@layout/view_title_detail_template"/>
        <TextView
            android:id="@+id/activity_mine_bind_alipay_rebind_tv"
            android:layout_marginTop="24dp"
            android:layout_width="252dp"
            android:layout_height="44dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="重新绑定"
            android:textColor="#ffffffff"
            android:textSize="15sp"
            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_bind_ll"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/activity_mine_bind_alipay_account"
            layout="@layout/view_top_title_et"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />
        <include
            android:id="@+id/activity_mine_bind_alipay_name"
            layout="@layout/view_top_title_et"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/activity_mine_bind_alipay_bind_tv"
            android:layout_marginTop="24dp"
            android:layout_width="252dp"
            android:layout_height="44dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="确定"
            android:textColor="#ffffffff"
            android:textSize="15sp"
            />
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/activity_mine_bind_alipay_bind_success_ll"
        android:layout_marginTop="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/common_success_pic"
            />
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恭喜您！支付宝绑定成功！"
            android:textColor="#ff000000"
            android:textSize="15sp"
            />
        <TextView
            android:id="@+id/activity_mine_bind_alipay_bind_success_tv"
            android:layout_marginTop="24dp"
            android:layout_width="250dp"
            android:layout_height="44dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="返回"
            android:textColor="#ffffffff"
            android:textSize="15sp"
            />
    </LinearLayout>
</LinearLayout>