<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_bind_alipay_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/app_theme_color"
        app:back_icon="@mipmap/temp_ic_back_white"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="支付宝"
        app:title_text_color="@color/white"
        app:under_divider_color="@color/transparent" />

    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_goto_bind_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/common_empty_pic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="还没有绑定，快去绑定吧~"
            android:textColor="#ff333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/activity_mine_bind_alipay_goto_bind_tv"
            android:layout_width="82dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="去绑定"
            android:textColor="#ffffffff"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_rebind_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/activity_mine_bind_alipay_rebind_content"
            layout="@layout/view_title_detail_template"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginHorizontal="15dp" />

        <TextView
            android:id="@+id/activity_mine_bind_alipay_rebind_tv"
            android:layout_width="252dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="重新绑定"
            android:textColor="#ffffffff"
            android:textSize="15sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_bind_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <include
            android:id="@+id/activity_mine_bind_alipay_account"
            layout="@layout/view_top_title_et"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />

        <include
            android:id="@+id/activity_mine_bind_alipay_name"
            layout="@layout/view_top_title_et"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />

        <include
            android:id="@+id/activity_mine_bind_kaihu_name"
            layout="@layout/view_top_title_et"
            android:layout_width="match_parent"

            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/activity_mine_bind_alipay_upload_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/activity_purse_tixian_add_account_upload_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_15_dp"
                android:src="@mipmap/mine_fragment_purse_bank_card_list_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:text="上传收款码"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:paddingHorizontal="@dimen/dimen_16_dp"
                android:text="请勿上传截图的收款码，请在二维码收款界面，点击保存收款码，上传图片 点击上传"
                android:textColor="@color/color_999999"
                android:textSize="@dimen/text_size_12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:paddingHorizontal="@dimen/dimen_16_dp"
                android:text="提示：绑定的支付宝账号实名和注册账户的实名必须要一致，否则提现不到账，自行负责"
                android:textColor="@color/color_red_f04c62"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_bind_alipay_bind_tv"
            android:layout_width="252dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="确定"
            android:textColor="#ffffffff"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_mine_bind_alipay_bind_success_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/common_success_pic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="恭喜您！绑定成功！"
            android:textColor="#ff000000"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/activity_mine_bind_alipay_bind_success_tv"
            android:layout_width="250dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="返回"
            android:textColor="#ffffffff"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>