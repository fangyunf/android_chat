<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_my_fuhao_list_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="我的副号"
            app:title_text_color="@color/black"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:id="@+id/activity_mine_my_fuhao_list_detail_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的主号"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_mine_my_fuhao_list_self_phone_tv"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="5dp"
                android:background="@color/colorWhite"
                android:gravity="center"
                android:paddingHorizontal="15dp"
                android:text="136 5669 6688"

                android:textColor="#ff000000"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认登录密码和支付密码都为主号码"
                android:textColor="#ff999999"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="我的副号"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activity_mine_my_fuhao_list_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="15dp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/activity_mine_purse_fh_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_50_dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/dimen_20_dp"
        android:layout_marginTop="@dimen/dimen_50_dp"
        android:layout_marginBottom="@dimen/dimen_20_dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        android:gravity="center"
        android:text="购买副号"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/activity_mine_my_fuhao_list_buy_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="90dp"
        android:src="@mipmap/mine_fuhao_buy"
        android:visibility="gone" />
</RelativeLayout>