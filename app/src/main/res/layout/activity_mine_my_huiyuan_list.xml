<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    android:id="@+id/activity_mine_my_huiyuan_list_root_rl"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_my_huiyuan_list_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="会员中心"
            app:title_text_color="@color/white"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            >
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/activity_mine_my_huiyuan_list_head_iv"
                    android:layout_width="@dimen/dimen_35_dp"
                    app:riv_corner_radius="17dp"
                    android:scaleType="centerCrop"
                    android:layout_height="@dimen/dimen_35_dp" />

                <LinearLayout
                    android:layout_marginLeft="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <TextView
                        android:id="@+id/activity_mine_my_huiyuan_list_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:text="张三"
                    />
                    <ImageView
                        android:id="@+id/activity_mine_my_huiyuan_list_vip_iv"
                        android:layout_width="46dp"
                        android:layout_height="18dp"
                        />

                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/activity_mine_my_huiyuan_list_my_huiyuan_ll"
                android:layout_width="wrap_content"
                android:gravity="center_vertical"
                android:layout_height="match_parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的会员"
                    android:textColor="#ffFFFFFF"
                    android:textSize="12sp"
                    />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/mine_index_right_arrow"
                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/activity_mine_my_fuhao_list_detail_ll"
            android:layout_marginVertical="10dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activity_mine_my_huiyuan_list_top_rv"
                android:layout_width="match_parent"
                android:scrollbars="horizontal"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/activity_mine_my_huiyuan_list_introduce_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="15dp"
                android:text="以下是 vip2 靓号"
                android:textColor="#ffff8a0b"
                android:textSize="21sp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:layout_weight="1"
                android:id="@+id/activity_mine_my_huiyuan_list_bottom_rv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="购买即可获得对应ID靓号"
                    android:textColor="#ffffffff"
                    android:textSize="14sp"
                    />

                <RelativeLayout
                    android:id="@+id/activity_mine_my_huiyuan_list_buy_rl"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="17dp"
                    android:background="@mipmap/huiyuan_goumai_bg"
                    android:layout_height="50dp">

                    <TextView
                        android:layout_centerInParent="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="立即购买"
                        android:textColor="#ff480500"
                        android:textSize="20sp"
                        />
                </RelativeLayout>


            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>