<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_order_list_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="我的订单"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />


    <com.flyco.tablayout.CommonTabLayout
        android:id="@+id/activity_mine_order_list_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#ffffff"
        tl:tl_indicator_bounce_enable="false"
        tl:tl_indicator_color="#8B5FD8"
        tl:tl_textSelectColor="#8B5FD8"
        tl:tl_textUnselectColor="#66000000"
        tl:tl_indicator_width="@dimen/dimen_32_dp"
        tl:tl_textsize="15sp"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_mine_order_list_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        />
</LinearLayout>