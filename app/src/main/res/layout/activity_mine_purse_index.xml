<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_purse_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_index_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="我的钱包"
            app:title_text_color="@color/color_black"
            app:under_divider_color="@color/transparent" />

        <!-- 资产卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_purse_balance_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="资金安全有保障"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="总资产 (元)"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_mine_purse_index_balance_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0.00"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/activity_mine_purse_index_recharge_tv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_purse_btn_recharge"
                    android:gravity="center"
                    android:text="充值"
                    android:textColor="#5B9E6F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_index_tixian_tv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_purse_btn_withdraw"
                    android:gravity="center"
                    android:text="提现"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_index_recharge_tv2"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="15dp"
                    android:background="#060606"
                    android:gravity="center"
                    android:text="充值2"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_15"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 功能列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_hbjl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_hongbao"
                app:titleText="红包记录" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_lqmx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_mingxi"
                app:titleText="零钱明细" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_smrz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:leftImg="@mipmap/purse_index_item_smrz"
                app:titleText="实名认证" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdwx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:leftImg="@mipmap/purse_index_item_wx"
                app:titleText="绑定微信" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdzfb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_zfb"
                app:titleText="绑定支付宝" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_wdkb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:leftImg="@mipmap/purse_index_item_kabao"
                app:titleText="我的卡包" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
