<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/color_F2F2F2"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_index_nav"
            style="@style/WhiteFontToolbar"
            android:background="#3C3C3C"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="我的钱包"
            app:title_text_color="@color/white"
            app:under_divider_color="@android:color/transparent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="202dp"
            android:paddingHorizontal="15dp"
            android:gravity="center_horizontal"
            android:background="@mipmap/purse_index_money_bg"
            android:orientation="vertical">
            <TextView
                android:layout_marginTop="30dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的零钱"
                android:textColor="@color/white"
                android:textSize="12sp"
                />

            <TextView
                android:id="@+id/activity_mine_purse_index_balance_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="¥0.00"
                android:textColor="@color/white"
                android:textSize="35sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                >

                <TextView
                    android:id="@+id/activity_mine_purse_index_tixian_tv"
 android:layout_width="100dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"

                    android:gravity="center"
                    android:background="@drawable/bg_f2f2f2_rounded_10"
                    android:text="提现"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/text_size_15" />
                <TextView
                    android:layout_marginLeft="15dp"

                    android:id="@+id/activity_mine_purse_index_recharge_tv"

                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:background="#060606"
                    android:text="充值1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_15" />
                <TextView
                    android:layout_marginLeft="15dp"
                    android:id="@+id/activity_mine_purse_index_recharge_tv2"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:background="#060606"
                    android:text="充值2"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_15" />


            </LinearLayout>

        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:background="#545454"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_hbjl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_hongbao"
                app:bgColor="#545454"
                app:textColor="@color/white"
                app:titleText="红包记录"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_lqmx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_mingxi"
                app:titleText="零钱明细"
                app:bgColor="#545454"
                app:textColor="@color/white"
                />
            <!--                <com.yaoxin.appbase.view.IconTitleArrowTemplate-->
            <!--                    android:visibility="gone"-->
            <!--                    android:id="@+id/activity_mine_purse_index_smrz"-->
            <!--                    android:layout_width="0dp"-->
            <!--                    android:layout_columnWeight="1"-->
            <!--                    android:layout_height="64dp"-->
            <!--                    app:leftImg="@mipmap/purse_index_item_smrz"-->
            <!--                    app:titleText="实名认证"-->
            <!--                    />-->
            <!--                <com.yaoxin.appbase.view.IconTitleArrowTemplate-->
            <!--                    android:id="@+id/activity_mine_purse_index_wdkb"-->
            <!--                    android:layout_width="0dp"-->
            <!--                    android:layout_columnWeight="1"-->
            <!--                    android:layout_height="64dp"-->
            <!--                    app:leftImg="@mipmap/purse_index_item_kabao"-->
            <!--                    app:titleText="我的卡包"-->
            <!--                    />-->
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdwx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_wx"
                app:bgColor="#545454"
                app:textColor="@color/white"
                app:titleText="绑定微信"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdzfb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:leftImg="@mipmap/purse_index_item_zfb"
                app:bgColor="#545454"
                app:textColor="@color/white"
                app:titleText="绑定支付宝"
                />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>