<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fafafa">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.yaoxin.appbase.navbar.NavToolbar
                android:id="@+id/activity_mine_purse_index_nav"
                style="@style/WhiteFontToolbar"
                android:background="#00000000"
                app:back_icon="@mipmap/icon_b_back"
                app:enable_under_divider="true"
                app:support_translucent_status_bar="false"
                app:title="我的钱包"
                app:title_text_color="@color/black"
                app:under_divider_color="@android:color/transparent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@mipmap/icon_black_notice"
                android:drawablePadding="@dimen/dimen_10_dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen_16_dp"
                android:text="温馨提示：红包余额可发红包和转账"
                android:textColor="@color/color_333333"
                android:textSize="@dimen/text_size_15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:layout_marginBottom="@dimen/dimen_16_dp"
                android:background="@mipmap/purse_index_money_bg"
                android:orientation="vertical"
                android:padding="@dimen/dimen_16_dp"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="余额"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_index_balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:text="0.00"
                    android:textColor="@color/white"
                    android:textSize="35sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/white"
            android:gravity="center"
            android:paddingVertical="@dimen/dimen_10_dp">

            <TextView
                android:id="@+id/activity_mine_purse_index_tixian_tv"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_7b65e8_stroke_rounded_4"
                android:drawablePadding="@dimen/dimen_10_dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen_50_dp"
                android:text="提现"
                android:textColor="@color/color_333333"
                android:textSize="@dimen/text_size_15" />

            <TextView
                android:id="@+id/activity_mine_purse_index_recharge_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_42_dp"
                android:layout_marginLeft="40dp"
                android:background="@drawable/bg_7b65e8_solid_rounded_4"
                android:drawableLeft="@mipmap/icon_meoney"
                android:drawablePadding="@dimen/dimen_10_dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen_50_dp"
                android:text="充值"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_15"
                android:visibility="gone" />

            <TextView
                android:id="@+id/activity_mine_purse_index_recharge_tv2"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dimen_42_dp"
                android:layout_marginLeft="15dp"
                android:background="@drawable/bg_7b65e8_solid_rounded_4"
                android:drawablePadding="@dimen/dimen_10_dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dimen_50_dp"
                android:text="充值"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_15" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            android:orientation="vertical">

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_lqmx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_mingxi"
                app:textColor="@color/black"
                app:titleText="账单明细" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/color_F2F2F2" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_zfmy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_pay"
                app:textColor="@color/black"
                app:titleText="支付密码" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_smrz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_smrz"
                app:textColor="@color/black"
                app:titleText="实名认证" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/color_F2F2F2"
                android:visibility="gone" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdwx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_wx"
                app:textColor="@color/black"
                app:titleText="微信" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/color_F2F2F2" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdzfb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_zfb"
                app:textColor="@color/black"
                app:titleText="支付宝" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/color_F2F2F2" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_wdkb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_kabao"
                app:textColor="@color/black"
                app:titleText="USDT" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/color_F2F2F2" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_hbjl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:bgColor="#ffffff"
                app:leftImg="@mipmap/purse_index_item_hongbao"
                app:textColor="@color/black"
                app:titleText="红包记录" />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
