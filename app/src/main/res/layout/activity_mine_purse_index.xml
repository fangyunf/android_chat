<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_2">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_index_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/white"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="我的钱包"
            app:title_text_color="@color/color_black"
            app:under_divider_color="@color/transparent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="@dimen/dimen_50_dp"
                    android:background="@drawable/bg_purse_wallet_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总资产(元)"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_index_balance_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0.00"
                        android:textColor="@color/color_white"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <TextView
                            android:id="@+id/activity_mine_purse_index_recharge_tv"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_purse_wallet_recharge_btn"
                            android:gravity="center"
                            android:text="充值"
                            android:textColor="#7c5dfe"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/activity_mine_purse_index_tixian_tv"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_purse_wallet_tixian_btn"
                            android:gravity="center"
                            android:text="提现"
                            android:textColor="@color/color_white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/activity_mine_purse_index_recharge_tv2"
                            android:layout_width="100dp"
                            android:layout_height="60dp"
                            android:layout_marginLeft="15dp"
                            android:background="#060606"
                            android:gravity="center"
                            android:text="充值2"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_size_15"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:paddingTop="2dp">

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_hbjl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:titleText="红包记录" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#EEEEEE" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_lqmx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:titleText="我的账单" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#EEEEEE" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_smrz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:titleText="实名认证" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#EEEEEE" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_bdzfb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:titleText="绑定支付宝" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="20dp"
                        android:background="#EEEEEE" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_bdwx"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:titleText="绑定微信" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/activity_mine_purse_index_wdkb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:titleText="我的卡包" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>
