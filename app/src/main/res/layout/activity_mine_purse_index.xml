<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFF4">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/bg_wallet"

        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_index_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="资产权益"
            app:title_text_color="@color/color_black"
            app:under_divider_color="@color/transparent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginHorizontal="15dp"
            android:background="@mipmap/bg_wallet_top"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:text="资产安全有保障"
                android:textColor="@color/color_FF8A0B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="可用余额"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/activity_mine_purse_index_balance_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:text="¥0.00"
                android:textColor="@color/black"
                android:textSize="35sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/activity_mine_purse_index_tixian_tv"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_48_dp"
                    android:layout_weight="1"
                    android:background="@drawable/fun_bg_gray_line_4"
                    android:gravity="center"
                    android:text="提现"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/text_size_15" />

                <TextView
                    android:id="@+id/activity_mine_purse_index_recharge_tv"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_48_dp"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:gravity="center"
                    android:text="充值"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_15" />


                <TextView
                    android:id="@+id/activity_mine_purse_index_recharge_tv2"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="15dp"
                    android:background="#060606"
                    android:gravity="center"
                    android:text="充值2"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_15"
                    android:visibility="gone" />


            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_zd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dimen_16_dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/icn_wallet_record">

                </ImageView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_10_dp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:text="我的账单"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="资金流动明细"
                        android:textColor="@color/color_999999"
                        android:textSize="@dimen/text_size_14" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/dtf_right_arrow">

                </ImageView>


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_zfb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dimen_16_dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/icn_wallet_zfb">

                </ImageView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_10_dp"
                    android:layout_weight="@integer/material_motion_duration_long_1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:text="支付宝"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="立即绑定支付宝"
                        android:textColor="@color/color_999999"
                        android:textSize="@dimen/text_size_14" />

                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/dtf_right_arrow">

                </ImageView>


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical"
            android:visibility="gone">

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_hbjl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleText="红包记录" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_lqmx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleText="零钱明细" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_smrz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:titleText="实名认证" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdwx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleText="绑定微信" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_bdzfb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleText="绑定支付宝" />

            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/activity_mine_purse_index_wdkb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:titleText="我的卡包" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>