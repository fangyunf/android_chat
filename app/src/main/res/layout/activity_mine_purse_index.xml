<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F6F6F6"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_purse_index_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="我的钱包"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:scaleType="fitXY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/mine_fragment_purse_index_assets_bg"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/dimen_16_dp"
                >
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="22dp"
                    android:text="总资产："
                    android:textColor="#ff000000"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:textSize="16sp"
                    />
                <TextView
                    android:id="@+id/activity_mine_purse_index_balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4_dp"
                    android:layout_height="37dp"
                    android:text="¥0.00"
                    android:textColor="#ff000000"
                    android:textSize="26sp"
                    />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <include
                android:id="@+id/activity_mine_purse_index_cell1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp"
                layout="@layout/view_purse_icon_title"
                />
            <include
                android:id="@+id/activity_mine_purse_index_cell2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp"
                layout="@layout/view_purse_icon_title"
                />
            <include
                android:id="@+id/activity_mine_purse_index_cell3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp"
                layout="@layout/view_purse_icon_title"
                />
            <include
                android:id="@+id/activity_mine_purse_index_cell4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp"
                layout="@layout/view_purse_icon_title"
                />

        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_40_dp"
        >
        <TextView
            android:id="@+id/activity_mine_purse_index_recharge_tv"
            android:gravity="center"
            android:layout_width="160dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:background="@mipmap/mine_fragment_purse_index_recharge_btn_bg"
            android:text="充值"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16"
            />
        <TextView
            android:id="@+id/activity_mine_purse_index_tixian_tv"
            android:gravity="center"
            android:layout_marginLeft="@dimen/dimen_23_dp"
            android:layout_width="160dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:background="@mipmap/mine_fragment_purse_index_tixian_btn_bg"
            android:text="提现"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16"
            />
    </LinearLayout>

</LinearLayout>