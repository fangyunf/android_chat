<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F6F6F6"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_purse_pwd_manager_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="密码管理"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/color_d5d5d5" />


    <include
        android:id="@+id/activity_mine_purse_pwd_manager_set_pwd"
        layout="@layout/view_title_arrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/activity_mine_purse_pwd_manager_modify_pwd"
        layout="@layout/view_title_arrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>