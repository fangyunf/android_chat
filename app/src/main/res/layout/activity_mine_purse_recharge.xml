<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_purse_recharge_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="充值"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimen_16_dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_50_dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:paddingHorizontal="@dimen/dimen_10_dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/mine_fragment_purse_recharge_bg"
                    android:visibility="gone" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="钱包余额"
                    android:textColor="@color/color_black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_recharge_account_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:background="@drawable/bg_f2f2f2_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp"
                android:visibility="gone"

                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="¥"
                    android:textColor="#ff000000"
                    android:textSize="36sp" />

                <EditText
                    android:id="@+id/activity_mine_purse_recharge_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="请输入金额"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_999999"
                    android:textSize="30sp"

                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充值金额"
                    android:textColor="#333333"
                    android:textSize="16sp" />
            </LinearLayout>
            <!--        <include-->
            <!--            android:id="@+id/activity_mine_purse_recharge_recharge_money"-->
            <!--            layout="@layout/view_title_tf_without_bg"-->
            <!--            android:layout_width="match_parent"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_marginTop="@dimen/dimen_12_dp" />-->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dimen_10_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">


                    <EditText
                        android:id="@+id/activity_mine_purse_recharge_et1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:cursorVisible="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:hint="请输入金额"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_999999"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充值金额"
                        android:textColor="#ff000000"
                        android:textSize="14sp" />
                    <!--            <TextView-->
                    <!--                android:id="@+id/activity_mine_purse_recharge_detail_tv"-->
                    <!--                android:layout_width="wrap_content"-->
                    <!--                android:layout_height="wrap_content"-->
                    <!--                android:text="≈200CNY"-->
                    <!--                android:textColor="#ff000001"-->
                    <!--                android:textSize="15sp"-->
                    <!--                />-->
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_8_dp"
                    android:text="选择充值金额"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:orientation="vertical">


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/activity_mine_purse_recharge_rv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical"
                android:padding="@dimen/dimen_10_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支付方式"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/activity_mine_purse_recharge_rv_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <include
                    android:id="@+id/activity_mine_purse_recharge_recharge_type"
                    layout="@layout/view_title_tf_without_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12_dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_20_dp"
                android:text="充值说明:\n
充值早上8点到晚上11点\n
如果遇到充值不到账，请第一时间联系平台处理!\n
平台保证用户充值数据，只要保留支付凭证，用户的利益就不会出现损失!"
                android:textColor="#999999"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/activity_mine_purse_recharge_recharge_rl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="@dimen/dimen_20_dp"

        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        android:gravity="center"
        android:text="充值"
        android:textColor="@color/white"
        android:textSize="16sp" />


</LinearLayout>