<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_purse_recharge_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="充值"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:background="@drawable/bg_white_rounded_10"
            android:paddingHorizontal="@dimen/dimen_15_dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="我的零钱"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/activity_mine_purse_recharge_account_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text=""
                android:textColor="@color/black"
                android:textSize="16sp" />
        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:background="@drawable/bg_white_rounded_10"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="15dp"
            android:paddingVertical="@dimen/dimen_20_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:background="@drawable/bg_f2f2f2_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="¥"
                    android:textColor="#ff000000"
                    android:textSize="36sp" />

                <EditText
                    android:id="@+id/activity_mine_purse_recharge_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="请输入金额"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_999999"
                    android:textSize="30sp"

                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="充值金额"
                    android:textColor="#333333"
                    android:textSize="16sp" />
            </LinearLayout>
            <!--        <include-->
            <!--            android:id="@+id/activity_mine_purse_recharge_recharge_money"-->
            <!--            layout="@layout/view_title_tf_without_bg"-->
            <!--            android:layout_width="match_parent"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_marginTop="@dimen/dimen_12_dp" />-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_100"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="100"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_300"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_marginLeft="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="300"

                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_500"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_marginLeft="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="500"

                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10_dp">

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_1000"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="1000"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_3000"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_marginLeft="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="3000"

                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_recharge_money_5000"
                        android:layout_width="0dp"
                        android:layout_height="53dp"
                        android:layout_marginLeft="15dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_f2f2f2_rounded_4"
                        android:gravity="center"
                        android:text="5000"

                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/activity_mine_purse_recharge_recharge_type"
            layout="@layout/view_title_tf_without_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12_dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:text="支付方式"
                android:textColor="@color/color_333333"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/activity_mine_purse_recharge_wx_pay_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_44_dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:background="@color/app_theme_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="微信充值"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_recharge_ali_pay_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_44_dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="1"
                    android:background="@color/app_theme_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="支付宝充值"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp">

                <TextView
                    android:id="@+id/activity_mine_purse_recharge_qq_pay_btn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_44_dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="1"
                    android:background="@color/app_theme_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="QQ充值"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dimen_44_dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:text="充值说明：\n1.充值实时到账\n2.充值未到账情况联系客服处理"
            android:textColor="#999999"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/activity_mine_purse_recharge_recharge_rl"
            android:layout_width="301dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="35dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="充值"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>


</LinearLayout>