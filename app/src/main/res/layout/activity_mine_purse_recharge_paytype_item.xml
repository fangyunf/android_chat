<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:background="@color/white">

    <ImageView
        android:id="@+id/activity_mine_purse_recharge_paytype_item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/icon_usdt"
        />
    <TextView
        android:layout_marginStart="5dp"
        android:id="@+id/activity_mine_purse_recharge_paytype_item_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:text="支付宝"
        android:gravity="center_vertical"
        />

    <ImageView
        android:id="@+id/activity_mine_purse_recharge_paytype_item_state_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/selector_covnersation_radio_button"
        />
</LinearLayout>