<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_mine_purse_tixian_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_purse_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_tixian_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="提现"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <!-- 提现方式卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="提现方式"
                        android:textColor="#999999"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/activity_mine_purse_tixianfangshi_ll"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/activity_mine_purse_tixianfangshi_icon_iv"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@mipmap/recharge_index_zfb"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/activity_mine_purse_tixianfangshi_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:hint="请选择"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_999999"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/activity_mine_purse_tixianfangshi_arrow_iv"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@mipmap/mine_index_right_arrow"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 提现金额卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="提现金额"
                        android:textColor="#999999"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥"
                            android:textColor="#5C9C6C"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/activity_mine_purse_tixian_money_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:cursorVisible="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="输入金额"
                            android:paddingVertical="0dp"
                            android:textColor="@color/black"
                            android:textColorHint="#CCCCCC"
                            android:textSize="28sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#EEEEEE" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/activity_mine_purse_tixian_available_balance_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="可用余额 0.00"
                            android:textColor="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/activity_mine_purse_tixian_all_tixian_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="全部提现"
                            android:textColor="#5C9C6C"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activity_mine_purse_tixian_note_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_tixian_note"
                        android:lineSpacingExtra="4dp"
                        android:padding="12dp"
                        android:text="注：技术服务费率8%+服务费2元/笔\n提现时间（早8.00-晚20.00）\n发起提现后二小时内到账"
                        android:textColor="#999999"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 提现按钮：保持原先位置/间距 -->
                <TextView
                    android:id="@+id/activity_mine_purse_tixian_tixian_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_50_dp"
                    android:layout_marginTop="@dimen/dimen_50_dp"
                    android:layout_marginBottom="@dimen/dimen_20_dp"
                    android:background="@drawable/fun_bg_app_theme_color_rounded_22"
                    android:gravity="center"
                    android:text="提现"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <EditText
        android:id="@+id/activity_mine_purse_tixian_accout_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <include
        android:id="@+id/activity_mine_purse_my_lingqian"
        layout="@layout/view_title_tf_without_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
