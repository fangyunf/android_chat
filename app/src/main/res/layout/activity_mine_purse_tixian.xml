<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_mine_purse_tixian_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_wallet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_tixian_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="提现"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />

        <include
            android:id="@+id/activity_mine_purse_my_lingqian"
            layout="@layout/view_title_tf_without_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_12_dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/activity_mine_purse_tixian_accout_tv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_f2f2f2_rounded_10"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="请输入支付宝账号"
            android:paddingHorizontal="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/color_999999"
            android:textSize="@dimen/text_size_15"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginHorizontal="@dimen/dimen_20_dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:text="当前总金额(元)"
            android:textColor="@color/color_333333" />

        <TextView
            android:id="@+id/tvBlance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginHorizontal="@dimen/dimen_20_dp"
            android:layout_marginTop="@dimen/dimen_5_dp"
            android:text="¥0"
            android:textColor="@color/color_333333"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical">

            <include
                android:id="@+id/activity_mine_purse_tixianfangshi"
                layout="@layout/view_title_tf_without_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="#f2f2f2" />


            <LinearLayout
                android:id="@+id/view_title_tf_without_bg_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_16_dp">

                <TextView
                    android:id="@+id/view_title_tf_without_bg_tv"
                    android:layout_width="@dimen/dimen_70_dp"
                    android:layout_height="@dimen/dimen_22_dp"
                    android:text="提现到"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:id="@+id/view_tixian_way"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_46_dp"
                    android:background="@color/transparent"
                    android:enabled="false"
                    android:gravity="right|center"
                    android:paddingHorizontal="@dimen/dimen_12_dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_15" />

                <com.yaoxin.appbase.view.loginlib.view.CountDownView
                    android:id="@+id/btn_captcha"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="获取验证码"
                    android:textColor="@color/app_theme_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/view_title_tf_without_bg_arrow_iv"
                    android:layout_width="6dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="4dp"
                    android:src="@mipmap/mine_fragment_purse_pwd_manager_arrow"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="#f2f2f2" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:background="@drawable/bg_f2f2f2_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="提现金额"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/activity_mine_purse_tixian_money_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="请输入金额"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_999999"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/activity_mine_purse_tixian_all_tixian_tv"
                    android:layout_width="64dp"
                    android:layout_height="22dp"
                    android:text="全部提现"
                    android:textColor="@color/color_8f55ff"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_mine_purse_tixian_tixian_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_44_dp"
                android:layout_marginHorizontal="@dimen/dimen_20_dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_bg"
                android:gravity="center"
                android:text="提现"
                android:textColor="@color/color_333333"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="14dp"
                android:text="1.提现费率0.08外加单笔2
充值时间8点至晚11点，\n2.提现时间8点至晚8点，提现100起到账时间1小时内"
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>