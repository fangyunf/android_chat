<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_mine_purse_tixian_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_tixian_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="提现"
            app:title_text_color="@color/white"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_16_dp"
            android:background="@drawable/bg_recharge"
            android:orientation="vertical">

            <include
                android:id="@+id/activity_mine_purse_my_lingqian"
                layout="@layout/view_title_tf_without_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/activity_mine_purse_tixian_accout_tv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_44_dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_f2f2f2_rounded_10"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="请输入支付宝账号"
                android:paddingHorizontal="10dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="@dimen/text_size_15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="5dp"
                android:text="请输入提现金额"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="@drawable/bg_white_stork_rounded_bg"
                android:gravity="center_vertical"
                android:paddingHorizontal="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="¥"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/activity_mine_purse_tixian_money_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="15dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="请输入金额"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBlance"
                    android:layout_width="64dp"
                    android:layout_height="22dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentRight="true"
                    android:text="可用余额:"
                    android:textColor="@color/white"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/activity_mine_purse_tixian_all_tixian_tv"
                    android:layout_width="64dp"
                    android:layout_height="22dp"
                    android:layout_alignParentRight="true"
                    android:text="全部提现"
                    android:textColor="#F5E605"
                    android:textSize="14sp" />

            </RelativeLayout>

            <include
                android:id="@+id/activity_mine_purse_tixianfangshi"
                layout="@layout/view_title_tf_without_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_12_dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/activity_mine_purse_tixian_tixian_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_marginHorizontal="@dimen/dimen_16_dp"
            android:layout_marginTop="70dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="提现"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="14dp"
            android:text="1.充值时间9点到晚11点，提现时间9点到晚10点
\n2:到账时间1小时内"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
