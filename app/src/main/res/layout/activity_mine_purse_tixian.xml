<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_mine_purse_tixian_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/bg_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_purse_tixian_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="提现"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 提现方式 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:paddingHorizontal="@dimen/dimen_15_dp"
                    android:text="提现方式"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/text_size_15" />

                <!-- 提现方式选择区域 -->
                <LinearLayout
                    android:id="@+id/activity_mine_purse_tixianfangshi_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_46_dp"
                    android:layout_marginTop="@dimen/dimen_8_dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_15_dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/activity_mine_purse_tixianfangshi_icon_iv"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@mipmap/recharge_index_zfb"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/activity_mine_purse_tixianfangshi_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dimen_8_dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:hint="请选择"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_999999"
                            android:textSize="@dimen/text_size_15" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/activity_mine_purse_tixianfangshi_arrow_iv"
                        android:layout_width="6dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@mipmap/mine_fragment_purse_pwd_manager_arrow"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- 提现金额 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/white_bg_rounded_top_20"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dimen_15_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_24_dp"
                        android:text="提现金额"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/text_size_15" />

                    <!-- 金额输入框 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/dimen_15_dp"
                        android:paddingVertical="@dimen/dimen_16_dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥"
                            android:textColor="@color/black"
                            android:textSize="36sp" />

                        <EditText
                            android:id="@+id/activity_mine_purse_tixian_money_et"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dimen_15_dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:cursorVisible="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:hint="输入金额"
                            android:paddingVertical="0dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_999999"
                            android:textSize="30sp" />


                    </LinearLayout>

                    <!-- 可用余额 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/activity_mine_purse_tixian_available_balance_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="可用余额 0.00"
                            android:textColor="@color/color_333333"
                            android:textSize="@dimen/text_size_15" />

                        <TextView
                            android:id="@+id/activity_mine_purse_tixian_all_tixian_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_10_dp"
                            android:text="全部提现"
                            android:textColor="#0A7FFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- 注意事项 -->
                    <TextView
                        android:id="@+id/activity_mine_purse_tixian_note_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_50_dp"
                        android:text="注：USDT提现费率5%（按提现金额计算）+服务费2元/笔\n
提现金额1000元起，通道TRC20\n
提现时间（早9.00-晚9.00）\n
发起提现后二小时内到账"
                        android:textColor="@color/color_666666"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/activity_mine_purse_tixian_tixian_btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_50_dp"

                        android:layout_marginTop="@dimen/dimen_50_dp"
                        android:layout_marginBottom="@dimen/dimen_20_dp"
                        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
                        android:gravity="center"
                        android:text="提现"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                </LinearLayout>


            </LinearLayout>
        </ScrollView>
        <!-- 提现按钮 -->
    </LinearLayout>

    <!-- 隐藏的账号输入框（保留用于兼容） -->
    <EditText
        android:id="@+id/activity_mine_purse_tixian_accout_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 隐藏的我的零钱组件（保留用于兼容） -->
    <include
        android:id="@+id/activity_mine_purse_my_lingqian"
        layout="@layout/view_title_tf_without_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
