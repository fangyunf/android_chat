<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_purse_usdt_recharge_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="usdt充值地址"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />


    <LinearLayout
        android:layout_marginHorizontal="10dp"
        android:padding="10dp"
        android:background="@drawable/bg_f2f2f2_rounded_10"
        android:layout_width="match_parent"
        android:gravity="center_vertical"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USDT充值地址"
            />
        <TextView
            android:id="@+id/activity_mine_purse_usdt_recharge_copy_content_tv"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TMqHu1fkLNx28YztSjznXb5X3RuNcycWU3"
            />
        <TextView
            android:id="@+id/activity_mine_purse_usdt_recharge_copy_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制"
            android:textColor="@color/app_theme_color"
            />
    </LinearLayout>

    <ImageView
        android:layout_gravity="center_horizontal"
        android:src="@mipmap/usdt_recharge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        />

</LinearLayout>