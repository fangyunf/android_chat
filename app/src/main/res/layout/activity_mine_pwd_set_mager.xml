<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_pwd_set_mager_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="安全隐私"
            app:title_text_color="@color/black"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:id="@+id/activity_mine_pwd_set_mager_set_login_pwd_ll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_f6f6f6_rounded_28"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="设置登录密码"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="11dp"
                android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_mine_pwd_set_mager_set_pay_pwd_ll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_f6f6f6_rounded_28"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="设置支付密码"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="11dp"
                android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_mine_pwd_set_mager_set_login_zx_ll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_251642_rounded_10"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="账号注销"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="6dp"
                android:layout_height="11dp"
                android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>