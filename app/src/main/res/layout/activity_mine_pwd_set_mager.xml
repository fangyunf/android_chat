<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_bg"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_mine_pwd_set_mager_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/app_theme_color"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="true"
            app:title="安全隐私"
            app:title_text_color="@color/white"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_16_dp"
            android:layout_marginTop="@dimen/dimen_24_dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_login_pwd_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="设置登录密码"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EAEEF2" />

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_pay_pwd_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="设置支付密码"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EAEEF2" />

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_login_zx_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="账号注销"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>