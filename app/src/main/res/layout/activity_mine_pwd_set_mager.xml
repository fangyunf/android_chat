<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <!--    <ImageView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="match_parent"-->
    <!--        android:scaleType="fitXY"-->
    <!--        android:src="@mipmap/jinzita_common_page_bg"-->
    <!--        />-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar

            android:id="@+id/activity_mine_pwd_set_mager_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="账户安全"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:background="@drawable/app_white_round_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_login_pwd_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_set_login_pwd" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="设置登录密码"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_pay_pwd_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"


                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_set_pay_pwd" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="设置支付密码"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_mine_pwd_set_mager_set_login_zx_ll"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_white_rounded_20"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_zx" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:text="账号注销"
                    android:textColor="#ff333333"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="11dp"
                    android:src="@mipmap/activity_mine_pwd_set_mager_arrow_righ" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:text="当前账户"
            android:textColor="@color/color_666666" />
    </LinearLayout>

</RelativeLayout>