<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_mine_set_new_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="我的设置"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:background="@drawable/bg_white_rounded_10"
            android:orientation="vertical">

            <include
                android:id="@+id/activity_mine_set_new_notice_voice"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_anquan_set"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_yinsi_set"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_mima_set"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_delete_cache"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_delete_record"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />


            <include
                android:id="@+id/activity_mine_set_new_about_us"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_download"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_exchange_acount"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/activity_mine_set_new_zhuxiao"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <include
                android:id="@+id/activity_mine_set_new_login_out"
                layout="@layout/view_title_arrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>