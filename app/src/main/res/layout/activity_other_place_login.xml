<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_other_place_login_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="异地登录"
            app:title_text_color="@color/black"
            app:under_divider_color="@color/transparent" />

        <ImageView
            android:layout_width="215dp"
            android:layout_height="194dp"
            android:layout_marginTop="20dp"
            android:src="@mipmap/other_place_login_icon" />

        <TextView
            android:id="@+id/activity_other_place_login_tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="您正在异地登录，须完成验证方可继续"
            android:textColor="#ff000000"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/activity_other_place_login_tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textColor="#ff999999"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/activity_other_place_login_get_code_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/activity_other_place_login_ans_et"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_search_et"
                android:hint="@string/hint_input_security_answer"
                android:paddingHorizontal="14dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_other_place_login_verify_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/dimen_40_dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/activity_other_place_login_confirm_ans_tv"
            android:layout_width="253dp"
            android:layout_height="52dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_26"
            android:gravity="center"
            android:text="确认"
            android:textColor="#ffffffff"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/activity_other_place_login_dont_verify_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="暂不验证"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>
</RelativeLayout>
