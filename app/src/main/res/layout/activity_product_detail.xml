<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_white"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 商品图片轮播 -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/activity_product_detail_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="400dp" />

                <!-- 价格 -->
                <TextView
                    android:id="@+id/activity_product_detail_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:textColor="#DC14A0"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- 商品名称 -->
                <TextView
                    android:id="@+id/activity_product_detail_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/color_black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 推荐标签 -->
                <TextView
                    android:id="@+id/activity_product_detail_subtitle_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/color_999999"
                    android:textSize="16sp" />

                <!-- 商品详情标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="-商品详情-"
                    android:textColor="@color/color_999999"
                    android:textSize="16sp" />

                <!-- 详情图片 -->
                <ImageView
                    android:id="@+id/activity_product_detail_detail_iv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY" />

            </LinearLayout>

        </ScrollView>

        <!-- 底部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/dimen_10_dp">

            <!-- 收藏按钮 -->
            <LinearLayout
                android:id="@+id/activity_product_detail_favorite_btn"
                android:layout_width="72dp"
                android:layout_height="49dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/activity_product_detail_favorite_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@mipmap/icon_collect" />

                <TextView
                    android:id="@+id/activity_product_detail_favorite_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="收藏"
                    android:textColor="@color/color_222222"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 立即购买按钮 -->
            <TextView
                android:id="@+id/activity_product_detail_buy_btn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_buy_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="立即购买"
                android:textColor="@color/color_white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activityProductDetailNav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/transparent" />

</FrameLayout>

