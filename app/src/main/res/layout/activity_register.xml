<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2f2f2">

    <!-- 导航栏 -->
    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_other_place_login_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="欢迎注册"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/transparent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/activity_other_place_login_nav"
        android:fillViewport="true"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- 手机号输入框 -->
            <include
                android:id="@+id/register_activity_phone_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 验证码输入框 -->
            <include
                android:id="@+id/register_activity_code_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 用户名输入框 -->
            <include
                android:id="@+id/register_activity_username_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 密码输入框 -->
            <include
                android:id="@+id/register_activity_pwd_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 确认密码输入框 -->
            <include
                android:id="@+id/register_activity_pwd2_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- 性别选择 -->
            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@null"
                    android:checked="true"
                    android:drawableLeft="@drawable/app_radio_green_selector"
                    android:drawablePadding="@dimen/dimen_10_dp"
                    android:text="男"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:button="@null"
                    android:drawableLeft="@drawable/app_radio_green_selector"
                    android:drawablePadding="@dimen/dimen_10_dp"
                    android:text="女"
                    android:textColor="@color/black"
                    android:textSize="16sp" />
            </RadioGroup>

            <!-- 协议复选框 -->
            <LinearLayout
                android:id="@+id/activity_register_agree_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/activity_register_is_checked_iv"
                    android:layout_width="@dimen/dimen_18_dp"
                    android:layout_height="@dimen/dimen_18_dp"
                    android:button="@null"
                    android:drawablePadding="0dp"
                    android:padding="0dp"
                    android:src="@drawable/app_radio_green_selector" />

                <TextView
                    android:id="@+id/activity_register_agree_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_8_dp"
                    android:text="我已阅读并接受《服务条款》《隐私政策》"
                    android:textColor="@color/color_999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 提交按钮 -->
            <TextView
                android:id="@+id/activity_register_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_green_rounded_10"
                android:gravity="center"
                android:text="提交"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
