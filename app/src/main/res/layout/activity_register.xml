<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_30_dp">

    <ImageView
        android:id="@+id/register_activity_back_iv"
        android:layout_width="@dimen/dimen_20_dp"
        android:layout_height="@dimen/dimen_30_dp"
        android:layout_marginTop="@dimen/dimen_20_dp"
        android:src="@mipmap/temp_ic_back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="注册"
        android:textColor="@color/app_theme_color"
        android:textSize="@dimen/text_size_26"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/register_activity_phone_tf"
        layout="@layout/view_title_tf_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_48_dp" />

    <include
        android:id="@+id/register_activity_code_tf"
        layout="@layout/view_title_tf_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <include
        android:id="@+id/register_activity_pwd_tf"
        layout="@layout/view_title_tf_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <include
        android:id="@+id/register_activity_pwd2_tf"
        layout="@layout/view_title_tf_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <LinearLayout
        android:id="@+id/register_activity_is_agree_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="@dimen/dimen_24_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/register_activity_is_checked_iv"
            android:layout_width="@dimen/dimen_16_dp"
            android:layout_height="@dimen/dimen_16_dp"
            android:src="@drawable/agree_switch_selector" />

        <TextView
            android:id="@+id/register_activity_is_checked_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_4_dp"
            android:clickable="true"
            android:focusable="true"
            android:text="我已阅读并同意《用户协议》、《隐私政策》"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>

    <TextView
        android:id="@+id/activity_register_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_marginTop="@dimen/dimen_30_dp"
        android:background="@drawable/bg_3339ff_rounded_28"
        android:gravity="center"
        android:text="注册"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16" />
</LinearLayout>