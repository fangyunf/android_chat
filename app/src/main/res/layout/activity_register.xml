<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="37dp"
    android:paddingRight="37dp">

    <ImageView
        android:id="@+id/register_activity_back_iv"
        android:layout_width="@dimen/dimen_20_dp"
        android:layout_height="@dimen/dimen_16_dp"
        android:layout_marginTop="64dp"
        android:src="@mipmap/register_activity_back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:text="注册"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_26"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/register_activity_phone_tf"
        layout="@layout/view_title_tf"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:layout_marginTop="@dimen/dimen_48_dp" />

    <include
        android:id="@+id/register_activity_code_tf"
        layout="@layout/view_title_tf"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <include
        android:id="@+id/register_activity_pwd_tf"
        layout="@layout/view_title_tf"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <include
        android:id="@+id/register_activity_pwd2_tf"
        layout="@layout/view_title_tf"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:layout_marginTop="@dimen/dimen_16_dp" />

    <TextView
        android:id="@+id/activity_register_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_marginTop="@dimen/dimen_16_dp"
        android:background="@mipmap/login_btn_bg"
        android:gravity="center"
        android:text="注册"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_16" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24_dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/activity_login_is_checked"
            android:layout_width="@dimen/dimen_16_dp"
            android:layout_height="@dimen/dimen_16_dp"
            android:src="@mipmap/login_activity_normal" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_4_dp"
            android:text="登录即阅读并同意"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务协议"
            android:textColor="@color/color_9A75DB"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="和"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私保护指引"
            android:textColor="@color/color_9A75DB"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>
</LinearLayout>