<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fafafa"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/layout_title_bar"
        style="@style/WhiteFontToolbar"
        android:background="@mipmap/icon_nav_title_bg"
        app:back_icon="@mipmap/icon_a_back"
        app:enable_under_divider="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:support_translucent_status_bar="false"
        app:title="注册"
        app:title_text_color="@color/white"
        app:under_divider_color="@color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/register_activity_phone_tf"
                layout="@layout/view_title_tf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_30_dp" />

            <include
                android:id="@+id/register_activity_pwd_tf"
                layout="@layout/view_title_tf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp" />

            <include
                android:id="@+id/register_activity_pwd2_tf"
                layout="@layout/view_title_tf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp" />

            <include
                android:id="@+id/register_activity_code_tf"
                layout="@layout/view_title_tf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dimen_16_dp">

                <TextView
                    android:id="@+id/tvToAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:text="已有账号？"
                    android:textColor="@color/color_666666"
                    android:textSize="@dimen/text_size_15" />

                <TextView
                    android:id="@+id/tvToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:text="立即登录"
                    android:textColor="@color/app_theme_color"
                    android:textSize="@dimen/text_size_15" />
            </RelativeLayout>

            <TextView
                android:id="@+id/activity_register_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_48_dp"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="@dimen/dimen_30_dp"
                android:background="@drawable/fun_bg_app_theme_color_rounded_26"
                android:gravity="center"
                android:text="注册"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:id="@+id/activity_login_is_agree_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dimen_24_dp"
        android:layout_marginBottom="@dimen/dimen_30_dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/activity_login_is_checked_iv"
            android:layout_width="@dimen/dimen_16_dp"
            android:layout_height="@dimen/dimen_16_dp"
            android:src="@drawable/agree_switch_selector" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_4_dp"
            android:text="登录/注册即表示同意"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="《服务协议》"
            android:textColor="@color/app_theme_color"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="和"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/text_size_13" />

        <TextView
            android:id="@+id/activity_login_is_checked_txt4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="《隐私保护指引》"
            android:textColor="@color/app_theme_color"
            android:textSize="@dimen/text_size_13" />
    </LinearLayout>
</LinearLayout>