<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/flTopBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivTopBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:src="@mipmap/login_top_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:layout_marginTop="-30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="注册"
                android:textColor="@color/white"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="注册的账号密码"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/flTopBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/dimen_20_dp"
            android:orientation="vertical">


            <include
                android:id="@+id/register_activity_phone_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/register_activity_code_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp" />

            <include
                android:id="@+id/register_activity_pwd_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_40_dp"
                android:layout_marginTop="@dimen/dimen_16_dp" />

            <include
                android:id="@+id/register_activity_pwd2_tf"
                layout="@layout/view_title_tf_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16_dp" />

            <TextView
                android:id="@+id/activity_register_btn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/dimen_30_dp"
                android:background="@drawable/bg_3339ff_rounded_28"
                android:gravity="center"
                android:text="注册"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/activity_register_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:text="已有账号，去登录"
                android:textColor="@color/app_theme_color"
                android:textSize="@dimen/text_size_15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24_dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/activity_login_is_checked"
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="@dimen/dimen_16_dp"
                    android:src="@mipmap/login_activity_normal" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_4_dp"
                    android:text="登录即阅读并同意"
                    android:textColor="@color/color_999999"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务协议"
                    android:textColor="@color/color_9A75DB"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和"
                    android:textColor="@color/color_999999"
                    android:textSize="@dimen/text_size_13" />

                <TextView
                    android:id="@+id/activity_login_is_checked_txt4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="隐私保护指引"
                    android:textColor="@color/color_9A75DB"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/reigster_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back_white"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title=" "
        app:title_text_color="@color/transparent"
        app:under_divider_color="@color/transparent" />
</RelativeLayout>