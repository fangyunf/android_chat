<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 渐变背景 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_search_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activityProductDetailNav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title_text_color="@color/black"
            app:under_divider_color="@color/transparent" />

        <!-- 搜索栏区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16_dp"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:layout_marginEnd="@dimen/dimen_16_dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 搜索框 -->
            <EditText
                android:id="@+id/activity_search_edit_text"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_input"
                android:drawableLeft="@mipmap/conversation_list_index_search_icon1"
                android:hint="搜索商品关键字"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/color_black"
                android:textSize="14sp" />

            <!-- 取消按钮 -->
            <TextView
                android:id="@+id/activity_search_cancel_btn"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="取消"
                android:textColor="@color/color_black"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 历史记录标题 -->
        <TextView
            android:id="@+id/activity_search_history_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16_dp"
            android:layout_marginTop="30dp"
            android:text="历史记录"
            android:textColor="@color/color_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 历史记录标签容器 -->
        <LinearLayout
            android:id="@+id/activity_search_history_tags_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_16_dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/dimen_16_dp"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>

