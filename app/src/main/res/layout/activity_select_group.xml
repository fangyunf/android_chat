<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_select_group_nav"
        style="@style/WhiteFontToolbar"
        android:background="#ffffff"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="选择群聊"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <EditText
        android:id="@+id/activity_select_group_search_et"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_40_dp"
        android:layout_margin="@dimen/dimen_14_dp"
        android:background="@drawable/bg_f2f2f2_rounded_10"
        android:cursorVisible="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="搜索群聊"
        android:paddingHorizontal="@dimen/dimen_14_dp"
        android:textColor="@color/black"
        android:textColorHint="@color/color_999999"
        android:textSize="15sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_select_group_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_white" />

        <TextView
            android:id="@+id/activity_select_group_confirm_tv"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="@dimen/dimen_40_dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_26"
            android:gravity="center"
            android:paddingHorizontal="30dp"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </RelativeLayout>

</LinearLayout>

