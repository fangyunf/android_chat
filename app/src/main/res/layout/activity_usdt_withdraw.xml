<?xml version="1.0" encoding="utf-8"?><!-- USDT 提现（TRC20），对齐产品设计稿 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_usdt_withdraw_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F6F6F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_usdt_withdraw_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/color_white"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="提现"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/color_E8E8E8" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dimen_16_dp"
                android:paddingTop="@dimen/dimen_12_dp"
                android:paddingBottom="@dimen/dimen_20_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dimen_16_dp"
                    android:paddingTop="@dimen/dimen_16_dp"
                    android:paddingBottom="@dimen/dimen_16_dp">

                    <!-- 今日汇率：标题在上，灰色底内容区在下 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今日汇率"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_usdt_recharge_input"
                        android:minHeight="48dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/activity_usdt_withdraw_rate_tv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="1USDT ≈ 7.00 元"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <!-- 提现 USDT 地址 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="提现 USDT 地址"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_usdt_recharge_input"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/activity_usdt_withdraw_address_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:maxLines="2"
                            android:text="--"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/activity_usdt_withdraw_rebind_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:text="重新绑定"
                            android:textColor="@color/color_884EEF"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 提现金额（元） -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="提现金额（元）"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_usdt_recharge_input"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <EditText
                            android:id="@+id/activity_usdt_withdraw_money_et"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/usdt_withdraw_amount_hint"
                            android:inputType="numberDecimal"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_999999"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="元"
                            android:textColor="@color/black"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- 服务费（元） -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="服务费（元）"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_usdt_recharge_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/activity_usdt_withdraw_fee_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0.00"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="元"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- 到账金额（USDT） -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="到账金额（USDT）"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_usdt_recharge_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/activity_usdt_withdraw_arrival_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0.00"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USDT"
                            android:textColor="@color/color_333333"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activity_usdt_withdraw_btn"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_50_dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_usdt_submit_green_rounded_22"
                        android:gravity="center"
                        android:text="USDT-TRC20 提现"
                        android:textColor="@color/color_white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_usdt_withdraw_note_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/usdt_withdraw_notes"
                        android:textColor="@color/color_666666"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/activity_usdt_withdraw_important_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/usdt_withdraw_important_tips"
                        android:textColor="@color/color_666666"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>
