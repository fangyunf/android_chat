<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_buy_confirm"
    android:orientation="vertical">

    <!-- 地址选择区域 -->
    <LinearLayout
        android:id="@+id/dialog_buy_confirm_address_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/color_white"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/dialog_buy_confirm_location_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/icon_order_address" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dialog_buy_confirm_name_phone_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择地址"
                android:textColor="@color/color_black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_buy_confirm_address_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="@color/color_222222"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/common_right_arrow" />

    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/color_f5f5f5" />

    <!-- 商品信息区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_buy_confirm_product_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@color/color_f5f5f5"
            android:contentDescription="商品图片"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_buy_confirm_product_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_buy_confirm_product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DC14A0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_buy_confirm_deposit_btn"
                    android:layout_width="80dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_deposit_button"
                    android:gravity="center"
                    android:textColor="#DC14A0"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 租赁天数 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:text="租赁天数"
        android:textColor="@color/color_999999"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/dialog_buy_confirm_duration_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialog_buy_confirm_duration_1"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_duration_button_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="1个月"
            android:textColor="#DC14A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_buy_confirm_duration_3"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_duration_button_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="3个月"
            android:textColor="@color/color_222222"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_buy_confirm_duration_6"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_duration_button_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="6个月"
            android:textColor="@color/color_222222"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 确定按钮 -->
    <TextView
        android:id="@+id/dialog_buy_confirm_confirm_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_buy_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="确定"
        android:textColor="@color/color_white"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>

