<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2">

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:id="@+id/contact_new_fragment_top_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#f2f1f8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="@dimen/dimen_25_dp"
        android:paddingBottom="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/fun_conversation_fragment_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="发现"
            android:textColor="@color/color_black"
            android:textSize="20sp" />


    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/contact_new_fragment_top_ll"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: 朋友圈 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="@dimen/dimen_16_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tvDaymic"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"

                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="朋友圈图标"
                        android:src="@mipmap/icon_a_x" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="朋友圈"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: 扫一扫、附近的人、邀请好友 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <!-- 扫一扫 -->
                <LinearLayout
                    android:id="@+id/tvSao"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="扫一扫图标"
                        android:src="@mipmap/ic_f_sao" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="扫一扫"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="#EFEFEF" />

                <!-- 附近的人 -->
                <LinearLayout
                    android:id="@+id/tvNearby"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="附近的人图标"
                        android:src="@mipmap/ic_f_fj" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="附近的人"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="#EFEFEF" />

                <!-- 邀请好友 -->
                <LinearLayout
                    android:id="@+id/tvInvite"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="邀请好友图标"
                        android:src="@mipmap/ic_f_yq" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="邀请好友"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 3: AI机器人、我的开源 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen_16_dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_white_rounded_10"
                android:orientation="vertical">

                <!-- AI机器人 -->
                <LinearLayout
                    android:id="@+id/tvAIRobot"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="AI机器人图标"
                        android:src="@mipmap/ic_f_ai" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="AI机器人"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="52dp"
                    android:background="#EFEFEF" />

                <!-- 我的开源 -->
                <LinearLayout
                    android:id="@+id/tvOpenSource"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="我的开源图标"
                        android:src="@mipmap/ic_f_ky" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="我的开源"
                        android:textColor="@color/color_black"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/dimen_16_dp"
                        android:layout_height="@dimen/dimen_16_dp"
                        android:contentDescription="右箭头"
                        android:src="@drawable/ic_frame_mine_right_arrow" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
