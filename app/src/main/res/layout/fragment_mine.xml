<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        >
        <TextView
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的"
            android:textColor="@color/color_333333"
            android:textSize="18sp"
            />
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="15dp"
            android:gravity="center_horizontal"
            >
            <RelativeLayout
                android:layout_width="65dp"
                android:layout_height="65dp">

                <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                    android:id="@+id/cavIcon"
                    android:layout_centerInParent="true"
                    android:layout_width="60dp"
                    android:layout_height="60dp" />
                <ImageView
                    android:layout_marginLeft="10dp"
                    android:id="@+id/fragment_mine_edit_iv"
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="@dimen/dimen_20_dp"
                    android:src="@mipmap/mine_index_bj"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:singleLine="true"
                    android:text="1233"
                    android:textColor="@color/color_333333"
                    android:textSize="18sp"
                    tools:ignore="SpUsage" />
                <ImageView
                    android:layout_marginLeft="5dp"
                    android:visibility="gone"
                    android:id="@+id/fragment_mine_grade_iv"
                    android:layout_width="46dp"
                    android:layout_height="18dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvAccount"
                android:layout_width="wrap_content"

                android:paddingHorizontal="10dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_black_alpha_20_rounded_10"

                android:layout_marginTop="4dp"
                android:gravity="start"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:ignore="SpUsage" />
            <RelativeLayout
                android:visibility="visible"
                android:id="@+id/fragment_mine_grade_rl"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/mine_fragment_index_lianghao_bg"
                    />
                <TextView
                    android:id="@+id/fragment_mine_grade_tv"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="您是尊贵的8级靓号用户"
                    android:textColor="#ffffffff"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"
                    />
                <TextView
                    android:id="@+id/fragment_mine_goto_upgrade_tv"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="27dp"
                    android:layout_marginRight="10dp"
                    android:text="去升级"
                    android:textColor="#ff000000"
                    android:textSize="10sp"
                    android:background="@drawable/bg_white_alpha_30_rounded_10"
                    />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_100_dp"
            android:background="@drawable/bg_white_alpha_30_rounded_20"
            android:layout_marginHorizontal="10dp"
            >

            <LinearLayout
                android:visibility="gone"
                android:id="@+id/fragment_mine_lianghao"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_pretty_number_tag"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="靓号"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/mineFragmentPacketMoneyCl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_qd"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="钱包"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
            <LinearLayout

                android:visibility="gone"
                android:id="@+id/mineFragmentYuLeCl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_yule"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="娱乐游戏"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
            <LinearLayout

                android:visibility="gone"
                android:id="@+id/fragment_mine_choujiang"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:src="@mipmap/mine_index_cj"
                    android:layout_width="23dp"
                    android:layout_height="23dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="抽奖"
                    android:textColor="#ff333333"
                    android:textSize="13sp"
                    android:layout_marginTop="9dp"
                    />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:paddingTop="20dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_white_alpha_30_rounded_20"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:rowCount="2"
            >
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/fragment_mine_smrz_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_ewm"
                app:titleText="二维码"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/fragment_mine_aqys_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_aqys"
                app:titleText="安全隐私"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/fragment_mine_zhaq_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_zhaq"
                app:titleText="账户安全"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/fragment_mine_xsqx_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_xstx"
                app:titleText="消息提醒"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:id="@+id/fragment_mine_sz_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_sz"
                app:titleText="设置"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:visibility="gone"
                android:id="@+id/fragment_mine_fuhao_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_my_fuhao"
                app:titleText="我的副号"
                />
            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                android:visibility="gone"
                android:id="@+id/fragment_mine_caidan_view"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="64dp"
                app:leftImg="@mipmap/mine_index_my_caidan"
                app:titleText="彩蛋商城"
                />
        </GridLayout>
