<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_mine_root_cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fun_page_bg_color">

    <LinearLayout
        android:id="@+id/contact_new_fragment_top_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:paddingBottom="@dimen/dimen_10_dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fun_conversation_fragment_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="我的"
            android:textColor="#ff151515"
            android:textSize="16sp" />


    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contact_new_fragment_top_ll">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!--            <ImageView-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:scaleType="centerCrop"-->
            <!--                android:src="@mipmap/fragment_mine_person_bg"-->
            <!--                app:layout_constraintLeft_toLeftOf="parent"-->
            <!--                app:layout_constraintTop_toTopOf="parent" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_10_dp"
                    android:background="@color/color_white"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="@dimen/dimen_20_dp"
                    android:paddingBottom="@dimen/dimen_16_dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/cavIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="fitXY" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/color_333333"
                                android:textSize="18sp"
                                tools:ignore="SpUsage" />

                            <ImageView
                                android:id="@+id/fragment_mine_grade_iv"
                                android:layout_width="46dp"
                                android:layout_height="18dp"
                                android:layout_marginLeft="5dp"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/fragment_mine_edit_iv"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginLeft="10dp"
                                android:src="@mipmap/mine_index_bj" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/tvAccount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="#000000"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/fragment_mine_copy_iv"
                                android:layout_width="wrap_content"
                                android:layout_height="12dp"
                                android:layout_marginLeft="10dp"
                                android:src="@mipmap/mine_index_copy" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iv_grade"
                            android:layout_width="@dimen/dimen_40_dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_5_dp"
                            android:src="@mipmap/mine_grade_level_1"
                            android:visibility="gone" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/fragment_mine_erweima_iv"
                        android:layout_width="32dp"
                        android:layout_height="28dp"
                        android:src="@mipmap/mine_index_erweima" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:visibility="gone">

                    <RelativeLayout
                        android:id="@+id/fragment_mine_grade_rl"
                        android:layout_width="match_parent"
                        android:layout_height="56dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/mine_fragment_index_lianghao_bg" />

                        <TextView
                            android:id="@+id/fragment_mine_grade_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="10dp"
                            android:text="您是尊贵的8级靓号用户"
                            android:textColor="#ffffffff"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/fragment_mine_goto_upgrade_tv"
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="27dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/bg_white_alpha_30_rounded_10"
                            android:gravity="center"
                            android:text="去升级"
                            android:textColor="#ff000000"
                            android:textSize="10sp" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_qbgl_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_qbgl"
                        app:textColor="@color/color_333333"
                        app:titleText="我的钱包" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_zhgl_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_zhgl"
                        app:textColor="@color/color_333333"
                        app:titleText="账户管理" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_wdfh_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_wdfh"
                        app:textColor="@color/color_333333"
                        app:titleText="主号副号" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_mmsz_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_mmsz"
                        app:textColor="@color/color_333333"
                        app:titleText="安全中心" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_hyzx_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_hyzx"
                        app:textColor="@color/color_333333"
                        app:titleText="靓号" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_hmd_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_hmd"
                        app:textColor="@color/color_333333"
                        app:titleText="黑名单" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_kf_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_kf"
                        app:textColor="@color/color_333333"
                        app:titleText="联系客服" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_sz_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:leftImg="@mipmap/mine_index_item_sz"
                        app:textColor="@color/color_333333"
                        app:titleText="设置" />

                </LinearLayout>

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_ltsz_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_ltsz"
                    app:titleText="聊天设置" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_qbye_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_qbye"
                    app:titleText="钱包余额" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_ysgl_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_ysgl"
                    app:titleText="朋友权限" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_tz_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_message"
                    app:titleText="消息通知" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_fxyy_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_fxyy"
                    app:titleText="分享应用" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_yysj_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_yysj"
                    app:titleText="应用升级" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_zhushou_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_lqzs"
                    app:titleText="零钱助手" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_ylyx_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:leftImg="@mipmap/mine_index_item_ylyx"
                    app:titleText="娱乐游戏" />

                <com.yaoxin.appbase.view.IconTitleArrowTemplate
                    android:id="@+id/fragment_mine_xtsz_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:titleText="" />

                <LinearLayout
                    android:id="@+id/fragment_mine_index_wdqb_ll"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/fragment_mine_index_cdsc_ll"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>