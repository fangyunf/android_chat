<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_mine_root_cl"
    android:background="@color/color_F2F2F2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ImageView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@mipmap/fragment_mine_person_bg"
                android:scaleType="centerCrop"
                />
            <LinearLayout
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                >
                <RelativeLayout
                    android:layout_marginTop="80dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="15dp"
                    >

                    <LinearLayout
                        android:layout_marginTop="40dp"
                            android:paddingHorizontal="20dp"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_marginTop="60dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/color_333333"
                                android:textSize="18sp"
                                tools:ignore="SpUsage" />
                            <ImageView
                                android:layout_marginLeft="5dp"
                                android:visibility="gone"
                                android:id="@+id/fragment_mine_grade_iv"
                                android:layout_width="46dp"
                                android:layout_height="18dp"/>
                            <ImageView
                                android:layout_marginLeft="10dp"
                                android:id="@+id/fragment_mine_edit_iv"
                                android:layout_width="@dimen/dimen_20_dp"
                                android:layout_height="@dimen/dimen_20_dp"
                                android:src="@mipmap/mine_index_bj"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvAccount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="#666666"
                                android:textSize="14sp" />
                            <ImageView
                                android:layout_marginLeft="10dp"
                                android:id="@+id/fragment_mine_copy_iv"
                                android:layout_width="@dimen/dimen_20_dp"
                                android:layout_height="@dimen/dimen_20_dp"
                                android:src="@mipmap/mine_index_copy"
                                />
                        </LinearLayout>

                        <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_marginVertical="10dp"
                        android:layout_height="50dp">
                        <LinearLayout
                            android:id="@+id/fragment_mine_index_wdqb_ll"
                            android:background="@color/white"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:gravity="center"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:src="@mipmap/mine_index_item_wdqb"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="我的钱包"
                                android:textColor="#ff000000"
                                android:textSize="18sp"
                                />
                        </LinearLayout>
                        <LinearLayout
                            android:visibility="gone"
                            android:id="@+id/fragment_mine_index_cdsc_ll"
                            android:background="@color/white"
                            android:layout_marginLeft="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:gravity="center"
                            android:layout_height="match_parent">
                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:src="@mipmap/mine_index_item_cdsc"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="彩蛋商城"
                                android:textColor="#ff000000"
                                android:textSize="12sp"
                                />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                    <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                        android:id="@+id/cavIcon"
                        android:layout_marginLeft="20dp"
                        android:layout_width="80dp"
                        android:layout_height="80dp" />

                    <ImageView
                        android:id="@+id/fragment_mine_erweima_iv"
                        android:layout_width="32dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="80dp"
                        android:layout_marginEnd="40dp"
                        android:src="@mipmap/mine_index_erweima"
                        />

                </RelativeLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="15dp"
                    android:gravity="center_horizontal"
                    >

                    <RelativeLayout
                        android:id="@+id/fragment_mine_grade_rl"
                        android:layout_width="match_parent"
                        android:layout_height="56dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/mine_fragment_index_lianghao_bg"
                            />
                        <TextView
                            android:id="@+id/fragment_mine_grade_tv"
                            android:layout_centerHorizontal="true"
                            android:layout_alignParentBottom="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="您是尊贵的8级靓号用户"
                            android:textColor="#ffffffff"
                            android:textSize="13sp"
                            android:layout_marginBottom="10dp"
                            />
                        <TextView
                            android:id="@+id/fragment_mine_goto_upgrade_tv"
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:gravity="center"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="27dp"
                            android:layout_marginRight="10dp"
                            android:text="去升级"
                            android:textColor="#ff000000"
                            android:textSize="10sp"
                            android:background="@drawable/bg_white_alpha_30_rounded_10"
                            />
                    </RelativeLayout>
                </LinearLayout>


            <GridLayout
                android:background="@drawable/bg_white_rounded_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_margin="20dp"
                android:padding="10dp">

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_ltsz_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:gLeftImg="@mipmap/mine_index_item_ltsz"
                    app:gTitleText="聊天设置" />

<!--                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate-->
<!--                    android:id="@+id/activity_mine_purse_index_lqmx"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="64dp"-->
<!--                    android:layout_columnWeight="1"-->
<!--                    android:visibility="gone"-->
<!--                    app:bgColor="#545454"-->
<!--                    app:gLeftImg="@mipmap/purse_index_item_mingxi"-->
<!--                    app:textColor="@color/white"-->
<!--                    app:gTitleText="零钱明细" />-->

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_ysgl_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:visibility="visible"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_ysgl"
                    app:textColor="@color/white"
                    app:gTitleText="隐私管理" />
                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_zhgl_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_zhgl"
                    app:textColor="@color/white"
                    app:gTitleText="账户管理" />

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_hmd_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_hmd"
                    app:textColor="@color/white"
                    app:gTitleText="黑名单" />

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_hyzx_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_hyzx"
                    app:textColor="@color/white"
                    app:gTitleText="客服中心" />
            </GridLayout>
            <GridLayout
                android:background="@drawable/bg_white_rounded_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginHorizontal="20dp"
                android:padding="10dp">

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_mmsz_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:gLeftImg="@mipmap/mine_index_item_mmsz"
                    app:gTitleText="密码设置" />


                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_fxyy_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_fxyy"
                    app:textColor="@color/white"
                    app:gTitleText="分享应用" />

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_yysj_view"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:gLeftImg="@mipmap/mine_index_item_yysj"
                    app:textColor="@color/white"
                    app:gTitleText="应用升级" />

                <com.yaoxin.appbase.view.GridIconTitleArrowTemplate
                    android:id="@+id/fragment_mine_hyzx_view111"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    app:bgColor="#545454"
                    app:textColor="@color/white" />
            </GridLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>