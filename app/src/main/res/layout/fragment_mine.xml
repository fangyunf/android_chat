<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_mine_root_cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="90dp">

                    <LinearLayout
                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_white_rounded_10">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="15dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="56dp">

                                <TextView
                                    android:id="@+id/tvName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    android:singleLine="true"
                                    android:text="1233"
                                    android:textColor="@color/color_333333"
                                    android:textSize="18sp"
                                    tools:ignore="SpUsage" />

                                <ImageView
                                    android:id="@+id/fragment_mine_grade_iv"
                                    android:layout_width="46dp"
                                    android:layout_height="18dp"
                                    android:layout_marginLeft="5dp"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/fragment_mine_edit_iv"
                                    android:layout_width="@dimen/dimen_20_dp"
                                    android:layout_height="@dimen/dimen_20_dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_alignParentBottom="true"
                                    android:layout_marginLeft="10dp"
                                    android:src="@mipmap/mine_index_bj" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp">

                                <TextView
                                    android:id="@+id/tvAccount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true"
                                    android:textColor="#666666"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/fragment_mine_copy_iv"
                                    android:layout_width="@dimen/dimen_20_dp"
                                    android:layout_height="@dimen/dimen_20_dp"
                                    android:layout_marginLeft="10dp"
                                    android:src="@mipmap/mine_index_copy" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/fragment_mine_qianbao_ll"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_marginTop="20dp"
                                android:layout_marginBottom="30dp"
                                android:background="@drawable/bg_f2f2f2_rounded_10"
                                android:gravity="center_horizontal">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="28dp"
                                    android:layout_marginTop="9dp"
                                    android:src="@mipmap/mine_index_qianbao" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="15dp"
                                    android:text="我的钱包"
                                    android:textColor="#ff000000"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/fragment_mine_erweima_iv"
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="80dp"
                        android:layout_marginEnd="15dp"
                        android:src="@mipmap/mine_index_erweima" />

                    <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                        android:id="@+id/cavIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginLeft="15dp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:visibility="gone">

                    <RelativeLayout
                        android:id="@+id/fragment_mine_grade_rl"
                        android:layout_width="match_parent"
                        android:layout_height="56dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/mine_fragment_index_lianghao_bg" />

                        <TextView
                            android:id="@+id/fragment_mine_grade_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="10dp"
                            android:text="您是尊贵的8级靓号用户"
                            android:textColor="#ffffffff"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/fragment_mine_goto_upgrade_tv"
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="27dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/bg_white_alpha_30_rounded_10"
                            android:gravity="center"
                            android:text="去升级"
                            android:textColor="#ff000000"
                            android:textSize="10sp" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/dimen_16_dp"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_ltsz_view"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_columnWeight="1"
                        app:leftImg="@mipmap/mine_index_item_ltsz"
                        app:titleText="聊天设置" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="17dp"
                        android:layout_marginTop="15dp"
                        android:text="常用功能"
                        android:textColor="#ff000000"
                        android:textSize="14sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:rowCount="2">

<!--                        <com.yaoxin.appbase.view.IconTitleArrowTemplate-->
<!--                            android:id="@+id/fragment_mine_ltsz_view"-->
<!--                            android:layout_width="0dp"-->
<!--                            android:layout_height="64dp"-->
<!--                            android:layout_columnWeight="1"-->
<!--                            app:leftImg="@mipmap/mine_index_item_ltsz"-->
<!--                            app:titleText="聊天设置" />-->

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_ysgl_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_ysgl"
                            app:titleText="隐私管理" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_zhgl_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_zhgl"
                            app:titleText="账户管理" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_hmd_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_hmd"
                            app:titleText="黑名单" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_wdfh_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_wdfh"
                            app:titleText="我的副号" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_hyzx_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            android:visibility="visible"
                            app:leftImg="@mipmap/mine_index_item_hyzx"
                            app:titleText="会员中心" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_caidan_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_my_caidan"
                            app:titleText="彩蛋商城" />


                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_ylyx_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_ylyx"
                            app:titleText="娱乐游戏" />
                    </GridLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="17dp"
                        android:layout_marginTop="15dp"
                        android:text="其它功能"
                        android:textColor="#ff000000"
                        android:textSize="14sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:paddingTop="20dp"
                        android:paddingBottom="10dp"
                        android:rowCount="2">

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_mmsz_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_mmsz"
                            app:titleText="密码设置" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_fxyy_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_fxyy"
                            app:titleText="分享应用" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_yysj_view"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"
                            app:leftImg="@mipmap/mine_index_item_yysj"
                            app:titleText="应用升级" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_xtsz_view"

                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_columnWeight="1"

                            app:titleText="" />
                    </GridLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>