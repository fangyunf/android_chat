                    <ImageView
                        android:id="@+id/fragment_mine_edit_iv"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/mine_index_bj" />
                </LinearLayout>

                <LinearLayout
