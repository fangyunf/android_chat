<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/fragment_mine_qrcode_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/dimen_60_dp"
        android:layout_marginRight="@dimen/dimen_20_dp"
        android:layout_width="@dimen/dimen_20_dp"
        android:layout_height="@dimen/dimen_20_dp"
        android:src="@mipmap/mine_index_qcode_icon"
        />
    <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
        android:id="@+id/cavIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="46dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--    <ImageView-->
    <!--        android:id="@+id/ivRightArrow"-->
    <!--        android:layout_width="16dp"-->
    <!--        android:layout_height="16dp"-->
    <!--        android:visibility="gone"-->
    <!--        android:layout_marginEnd="36dp"-->
    <!--        android:src="@drawable/ic_frame_mine_right_arrow"-->
    <!--        app:layout_constraintBottom_toBottomOf="@id/cavIcon"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintTop_toTopOf="@id/cavIcon" />-->

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:singleLine="true"
        android:text="test"
        android:textColor="@color/color_333333"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@id/cavIcon"
        app:layout_constraintStart_toStartOf="@id/cavIcon"
        app:layout_constraintTop_toBottomOf="@id/cavIcon"
        tools:ignore="SpUsage" />

    <TextView
        android:id="@+id/tvAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/tvName"
        app:layout_constraintStart_toStartOf="@id/tvName"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        tools:ignore="SpUsage" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mine_fragment_packet_money_cl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAccount" >
        <ImageView
            android:id="@+id/mine_fragment_packet_money_bg"
            android:layout_width="343dp"
            android:layout_height="84dp"
            android:scaleType="fitXY"
            android:src="@mipmap/mine_fragment_packet_money_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mine_fragment_packet_money_title"
            android:layout_marginStart="21dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="钱包"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/mine_fragment_packet_money_bg"
            app:layout_constraintStart_toStartOf="@+id/mine_fragment_packet_money_bg"
            app:layout_constraintTop_toTopOf="@+id/mine_fragment_packet_money_bg"

            />

        <TextView

            android:id="@+id/mine_fragment_packet_money_detail_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="￥200"
            android:textColor="@color/color_666666"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/mine_fragment_packet_money_title"
            app:layout_constraintStart_toEndOf="@+id/mine_fragment_packet_money_title"
            app:layout_constraintTop_toTopOf="@+id/mine_fragment_packet_money_title"

            />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:src="@mipmap/mine_fragment_packet_money_title_line"
            app:layout_constraintEnd_toEndOf="@+id/mine_fragment_packet_money_title"
            app:layout_constraintStart_toStartOf="@+id/mine_fragment_packet_money_title"
            app:layout_constraintTop_toBottomOf="@+id/mine_fragment_packet_money_title" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/mine_fragment_my_manager_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mine_fragment_packet_money_cl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="我的管理"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp">

            <include
                android:id="@+id/mine_fragment_my_manager_item1"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <include
                android:id="@+id/mine_fragment_my_manager_item2"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/mine_fragment_my_manager_item3"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/mine_fragment_my_manager_item4"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@+id/mine_fragment_my_manager_ll"
        app:layout_constraintStart_toStartOf="@+id/mine_fragment_my_manager_ll"
        app:layout_constraintTop_toBottomOf="@+id/mine_fragment_my_manager_ll">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="设置中心"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp">

            <include
                layout="@layout/view_mine_fragment_item_cell"
                android:id="@+id/mine_fragment_my_manager_item5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="hell0"
                app:customText="Hello, World!" />

            <include
                android:id="@+id/mine_fragment_my_manager_item6"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/mine_fragment_my_manager_item7"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/mine_fragment_my_manager_item8"
                layout="@layout/view_mine_fragment_item_cell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>