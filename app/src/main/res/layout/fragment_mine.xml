<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_mine_root_cl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_purse_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:src="@mipmap/jinzita_common_page_bg"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的"
                        android:textColor="@color/black"
                        android:textSize="30sp" />

                    <ImageView
                        android:id="@+id/fragment_mine_edit_iv"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/mine_index_bj" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="44dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/fragment_mine_erweima_iv"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@mipmap/mine_index_erweima" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="编辑"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/fragment_mine_shezhi_iv"
                        android:layout_width="@dimen/dimen_24_dp"
                        android:layout_height="@dimen/dimen_24_dp"
                        android:layout_marginLeft="@dimen/dimen_20_dp"
                        android:src="@mipmap/mine_index_shezhi_icon"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp">

                    <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                        android:id="@+id/cavIcon"
                        android:layout_width="72dp"
                        android:layout_height="72dp" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="11111" />

                    <ImageView
                        android:id="@+id/fragment_mine_grade_iv"
                        android:layout_width="40dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:src="@mipmap/mine_grade_level_1"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_mine_id_pill"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp">

                        <TextView
                            android:id="@+id/tvAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            tools:text="ID:122222" />

                        <ImageView
                            android:id="@+id/fragment_mine_copy_iv"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="8dp"
                            android:src="@mipmap/mine_index_copy" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:visibility="gone">

                    <RelativeLayout
                        android:id="@+id/fragment_mine_grade_rl"
                        android:layout_width="match_parent"
                        android:layout_height="56dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/mine_fragment_index_lianghao_bg" />

                        <TextView
                            android:id="@+id/fragment_mine_grade_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="10dp"
                            android:text="您是尊贵的8级靓号用户"
                            android:textColor="#ffffffff"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/fragment_mine_goto_upgrade_tv"
                            android:layout_width="40dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="27dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/bg_white_alpha_30_rounded_10"
                            android:gravity="center"
                            android:text="去升级"
                            android:textColor="#ff000000"
                            android:textSize="10sp" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/fragment_mine_index_wdqb_ll"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:src="@mipmap/mine_index_item_wdqb" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="我的钱包"
                                android:textColor="#ff000000"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 优优：移除彩蛋入口 -->
                        <LinearLayout
                            android:id="@+id/fragment_mine_index_cdsc_ll"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="10dp"
                            android:layout_weight="1"
                            android:background="@color/white"
                            android:gravity="center"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:src="@mipmap/mine_index_item_cdsc" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="彩蛋商城"
                                android:textColor="#ff000000"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@mipmap/icon_kaitong"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_30_dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="多种精选权益"
                                android:textColor="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="30dp"
                                android:text="开通会员立享"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_kaitong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_10_dp"
                            android:layout_marginRight="@dimen/dimen_20_dp"
                            android:background="@drawable/bg_fffffff_stork_4"
                            android:drawableRight="@mipmap/icon_right_white"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="2dp"
                            android:text="立即开通"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>


                    <!-- 我的资产：对齐 iOS（左图标 + 标题/金额纵向 + 右箭头） -->
                    <LinearLayout
                        android:id="@+id/fragment_mine_zcqy_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_mine_assets_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@mipmap/mine_assets_wallet_white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="我的资产"
                                android:textColor="#CCFFFFFF"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/fragment_mine_balance_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="¥0.00"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@mipmap/icon_right_white" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_white_rounded_10"
                        android:orientation="vertical">

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_hyzx_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@mipmap/mine_index_item_hyzx"
                            app:titleText="会员商城" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_wdfh_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@mipmap/mine_index_item_wdfh"
                            app:titleText="我的副号" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_zhgl_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@mipmap/mine_index_item_zhgl"
                            app:titleText="账号管理" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_mmsz_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@mipmap/mine_index_item_mmsz"
                            app:titleText="密码管理" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_tysz_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@mipmap/mine_index_item_tysz"
                            app:titleText="通用设置" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.yaoxin.appbase.view.IconTitleArrowTemplate
                                android:id="@+id/fragment_mine_gwdz_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:leftImg="@mipmap/mine_index_item_gwdz"
                                app:titleText="官网地址" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true">

                                <TextView
                                    android:id="@+id/fragment_mine_copy_ios"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:gravity="center"
                                    android:text="iOS复制"
                                    android:textColor="#999999"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/fragment_mine_copy_android"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:layout_marginLeft="12dp"
                                    android:layout_marginRight="16dp"
                                    android:gravity="center"
                                    android:text="android复制"
                                    android:textColor="#999999"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_ltsz_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_ltsz"
                            app:titleText="聊天设置" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_ysgl_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_ysgl"
                            app:titleText="隐私管理" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_hmd_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_hmd"
                            app:titleText="黑名单" />
                        <!--                        <com.yaoxin.appbase.view.IconTitleArrowTemplate-->
                        <!--                            android:id="@+id/fragment_mine_wdfh_view"-->
                        <!--                            android:layout_width="0dp"-->
                        <!--                            android:layout_columnWeight="1"                android:layout_height="64dp"-->
                        <!--                            app:leftImg="@mipmap/mine_index_item_wdfh"-->
                        <!--                            app:titleText="我的副号"-->
                        <!--                            />-->

                        <!--                        <com.yaoxin.appbase.view.IconTitleArrowTemplate-->
                        <!--                            android:visibility="visible"-->
                        <!--                            android:id="@+id/fragment_mine_caidan_view"-->
                        <!--                            android:layout_width="0dp"-->
                        <!--                            android:layout_columnWeight="1"-->
                        <!--                            android:layout_height="64dp"-->
                        <!--                            app:leftImg="@mipmap/mine_index_my_caidan"-->
                        <!--                            app:titleText="彩蛋商城"-->
                        <!--                            />-->

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_ylyx_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_ylyx"
                            app:titleText="娱乐游戏" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_fxyy_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_fxyy"
                            app:titleText="分享应用" />

                        <com.yaoxin.appbase.view.IconTitleArrowTemplate
                            android:id="@+id/fragment_mine_yysj_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:leftImg="@mipmap/mine_index_item_yysj"
                            app:titleText="应用升级" />

                    </LinearLayout>

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_tcdl_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_white_rounded_10"
                        app:leftImg="@mipmap/mine_index_item_tcdl"
                        app:titleText="退出登录" />

                    <com.yaoxin.appbase.view.IconTitleArrowTemplate
                        android:id="@+id/fragment_mine_xtsz_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:titleText="" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>