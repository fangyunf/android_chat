<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="322dp"
    android:layout_height="262dp"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/other_place_login_fragment_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dimen_14_dp"
        android:paddingVertical="@dimen/dimen_16_dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="设备登陆"
            android:textColor="#ff000000"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/fragment_other_place_login_phone_et"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:layout_marginTop="@dimen/dimen_14_dp"
            android:background="@color/color_white"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="请输入手机号"
            android:paddingHorizontal="@dimen/dimen_14_dp"
            android:textColor="@color/black"
            android:textColorHint="@color/color_999999"
            android:textSize="@dimen/text_size_14" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_14_dp">

            <EditText
                android:id="@+id/fragment_other_place_login_input_code_et"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_40_dp"
                android:background="@color/color_white"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="请输入验证码"
                android:paddingHorizontal="@dimen/dimen_14_dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="@dimen/text_size_14" />

            <com.yaoxin.appbase.view.loginlib.view.CountDownView
                android:id="@+id/btn_captcha"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/dimen_5_dp"
                android:layout_marginRight="@dimen/dimen_8_dp"
                android:background="@color/white"
                android:gravity="center"
                android:text="获取验证码"
                android:textColor="@color/app_theme_color"
                android:visibility="visible" />
        </RelativeLayout>

        <TextView
            android:id="@+id/fragment_other_place_login_confirm_btn"
            android:layout_width="294dp"
            android:layout_height="38dp"
            android:layout_marginTop="50dp"
            android:background="@color/app_theme_color"
            android:gravity="center"
            android:text="确认"
            android:textColor="#ffffffff"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>