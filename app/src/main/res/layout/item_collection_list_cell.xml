<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    android:paddingTop="@dimen/dimen_14_dp"
    android:paddingBottom="@dimen/dimen_14_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_8_dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_collection_list_cell_user_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/color_999999"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/item_collection_list_cell_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-8-23"
            android:textColor="@color/color_999999"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/item_collection_list_cell_media_fl"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/item_collection_list_cell_content_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/item_collection_list_cell_play_iv"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_collection_play"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/item_collection_list_cell_text_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_collection_list_cell_content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ff000000"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_collection_list_cell_file_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/item_collection_list_cell_file_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_collection_file" />

        <TextView
            android:id="@+id/item_collection_list_cell_file_name_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#ff000000"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dimen_14_dp"
        android:background="@color/color_d5d5d5" />
</LinearLayout>
