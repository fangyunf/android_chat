<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dimen_8_dp"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    android:paddingVertical="@dimen/dimen_14_dp">

    <ImageView
        android:id="@+id/item_collection_list_cell_content_iv"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        />

    <LinearLayout
        android:id="@+id/item_collection_list_cell_text_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_collection_list_cell_content_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="你们用我的账号登录，18276678900，然后退…"
            android:textColor="#ff000000"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8_dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_collection_list_cell_user_tv"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/color_999999"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/item_collection_list_cell_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:text="2024-8-23"
            android:textColor="@color/color_999999"
            android:textSize="12sp" />

    </LinearLayout>
</LinearLayout>