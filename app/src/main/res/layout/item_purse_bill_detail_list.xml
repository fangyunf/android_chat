<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="67dp"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginHorizontal="@dimen/dimen_16_dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/item_purse_bill_detail_list_icon"
            android:layout_width="@dimen/dimen_35_dp"
            android:layout_height="@dimen/dimen_35_dp"

            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_4_dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_purse_bill_detail_list_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="发送群红包"
                android:textColor="#ff000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/item_purse_bill_detail_list_content_tv"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginTop="@dimen/dimen_4_dp"
                android:text="2023-01-23  16:00"
                android:textColor="#ff999999"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_purse_bill_detail_list_money_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text="-66.00"
                android:textColor="#ff000000"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/item_purse_bill_detail_list_yue_money_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text=""
                android:textColor="#ff000000"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="59dp"
        android:background="#F2F2F2" />
</LinearLayout>