<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_white"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- 字母索引 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/item_select_group_tv_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_white"
            android:paddingLeft="12dp"
            android:text="A"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 群信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp"
        android:paddingVertical="@dimen/dimen_14_dp">

        <ImageView
            android:id="@+id/item_select_group_sel_iv"
            android:layout_width="@dimen/dimen_18_dp"
            android:layout_height="@dimen/dimen_18_dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/person_choose_icon_selector" />

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/item_select_group_avatar_iv"
            android:layout_width="@dimen/dimen_44_dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/app_default_base_icon_group"
            app:riv_corner_radius="3dp" />

        <TextView
            android:id="@+id/item_select_group_name_tv"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginLeft="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:text="群聊名称"
            android:textColor="#ff000000"
            android:textSize="16sp"
            tools:text="群聊名称" />

    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:background="#F2F2F2" />

</LinearLayout>

