<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:layout_marginTop="@dimen/dimen_8_dp"
    android:background="@drawable/bg_white_rounded_10"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/item_xiaozhushou_list_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="充值成功"
        android:textColor="#ff000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#E0E0E0" />

    <!-- 第1行：金额（充值金额/提现金额/退回金额 + 金额值） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_xiaozhushou_list_money_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="充值金额"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_xiaozhushou_list_money_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10_dp"
            android:text="¥0.00"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 第2行：到账方式/退回方式 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_xiaozhushou_list_tyle1_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="到账方式"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_xiaozhushou_list_tyle1_detail_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10_dp"
            android:text="零钱"
            android:textColor="#ff000000"
            android:textSize="14sp" />
    </LinearLayout>



    <!-- 第4行：时间（充值时间/提现时间/退回时间） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_xiaozhushou_list_tyle3_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="充值时间"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_xiaozhushou_list_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10_dp"
            android:text="2026-02-01 11:03:33"
            android:textColor="#ff000000"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 第3行：退回原因（仅红包退回显示） -->
    <LinearLayout
        android:id="@+id/item_xiaozhushou_list_reason_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_6_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_xiaozhushou_list_tyle2_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="退回原因"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/item_xiaozhushou_list_tyle2_detail_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_10_dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#ff000000"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
