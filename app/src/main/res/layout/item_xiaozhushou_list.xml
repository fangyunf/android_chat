<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:layout_marginTop="@dimen/dimen_8_dp"
    android:background="@drawable/bg_white_rounded_10"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/item_xiaozhushou_list_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="红包退回"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/item_xiaozhushou_list_subtitle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="您有一笔收入"
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- 金额（居中显示） -->
    <TextView
        android:id="@+id/item_xiaozhushou_list_money_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="+1"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 交易详情区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- 交易账户 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_xiaozhushou_list_account_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交易账户"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/item_xiaozhushou_list_account_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10_dp"
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 交易时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_xiaozhushou_list_time_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交易时间"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/item_xiaozhushou_list_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10_dp"
                android:text="2026年01月22日 10:11:00"
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 交易单号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_xiaozhushou_list_order_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交易单号"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/item_xiaozhushou_list_order_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_10_dp"
                android:text="21792"
                android:textColor="#333333"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>