<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_title_tf_without_bg_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/dimen_16_dp">

    <TextView
        android:id="@+id/view_title_tf_without_bg_tv"
        android:layout_width="@dimen/dimen_70_dp"
        android:layout_height="@dimen/dimen_22_dp"
        android:text="手机号号"
        android:textColor="@color/color_black"
        android:textSize="@dimen/text_size_14" />

    <EditText
        android:id="@+id/view_title_tf_without_bg_et"
        android:layout_width="0dp"
        android:layout_height="@dimen/dimen_46_dp"
        android:layout_marginLeft="@dimen/dimen_8_dp"
        android:layout_weight="1"
        android:background="@color/color_F6F6F6"
        android:cursorVisible="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="请输入"
        android:paddingHorizontal="@dimen/dimen_12_dp"
        android:textColor="@color/black"
        android:textColorHint="@color/color_999999"
        android:textSize="@dimen/text_size_14" />

    <com.yaoxin.appbase.view.loginlib.view.CountDownView
        android:id="@+id/btn_captcha"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:gravity="center"
        android:text="获取验证码"
        android:textColor="@color/app_theme_color"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/view_title_tf_without_bg_arrow_iv"
        android:layout_width="@dimen/dimen_16_dp"
        android:layout_height="12dp"
        android:layout_marginLeft="4dp"
        android:src="@mipmap/dtf_right_arrow"
        android:visibility="gone" />
</LinearLayout>