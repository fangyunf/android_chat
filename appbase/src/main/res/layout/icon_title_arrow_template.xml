<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/icon_title_arrow_template_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="15dp">

    <ImageView
        android:id="@+id/icon_title_arrow_template_left_iv"
        android:layout_width="23dp"
        android:layout_height="23dp"
        android:layout_marginRight="@dimen/dimen_10_dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/icon_title_arrow_template_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_weight="1"
        android:text=""
        android:textColor="@color/color_white"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/icon_title_arrow_template_right_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@mipmap/icon_right_white_bg" />
</LinearLayout>