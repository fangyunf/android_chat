<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/icon_title_arrow_template_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/icon_title_arrow_template_left_iv"
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <TextView
            android:id="@+id/icon_title_arrow_template_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/color_black"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/icon_title_arrow_template_right_iv"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@mipmap/mine_index_right_arrow"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>