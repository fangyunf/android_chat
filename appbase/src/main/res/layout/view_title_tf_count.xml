<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_round_tf_ll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_16_dp">

    <TextView
        android:id="@+id/view_title_tf_count_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="输入账号"
        android:textColor="#ff000000"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8_dp"
        android:background="@drawable/bg_white_rounded_10"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/view_title_tf_count_et"
            android:layout_width="0dp"
            android:layout_height="@dimen/dimen_54_dp"
            android:layout_weight="1"
            android:background="@null"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="请输入"
            android:paddingHorizontal="@dimen/dimen_16_dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="@color/color_999999"
            android:textSize="15sp" />

        <RelativeLayout
            android:id="@+id/view_title_tf_count_eye_rl"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/view_title_tf_count_eye_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/common_pwd_eye_state_selector" />
        </RelativeLayout>

        <com.yaoxin.appbase.view.loginlib.view.CountDownView
            android:id="@+id/view_title_tf_count_captcha"
            android:layout_width="90dp"
            android:layout_height="30dp"
            android:layout_marginRight="@dimen/dimen_16_dp"
            android:background="@color/transparent"
            android:gravity="right|center_vertical"
            android:text="获取验证码"
            android:textColor="@color/app_theme_color"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_F2F2F2"
        android:visibility="gone" />

</LinearLayout>