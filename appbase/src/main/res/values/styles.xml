<resources>

    <style name="custom_dlg" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:alwaysDrawnWithCache">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="PascToolbarBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="title_text_size">18dp</item>
        <item name="sub_title_text_size">13dp</item>
        <item name="menu_text_size">16sp</item>
        <item name="enable_under_divider">true</item>
        <item name="under_divider_color">#E0E0E0</item>
        <item name="under_divider_height">1px</item>
    </style>
    <style name="WhiteFontToolbar" parent="PascToolbarBase">
        <item name="title_text_color">#ffffff</item>
        <item name="android:background">#27A5F9</item>
        <item name="sub_title_text_color">#b2ffffff</item>
        <item name="menu_text_color">#ffffff</item>
        <item name="back_icon">@drawable/ic_back_white</item>
    </style>
</resources>