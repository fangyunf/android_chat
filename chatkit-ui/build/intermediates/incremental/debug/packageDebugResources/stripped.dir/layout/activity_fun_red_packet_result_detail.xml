<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/chat_red_packet_open_result_top_bg"
            android:scaleType="fitXY"
            />
        <LinearLayout
            android:paddingEnd="@dimen/dimen_16_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            >


            <LinearLayout
                android:layout_width="@dimen/dimen_100_dp"
                android:layout_height="@dimen/dimen_70_dp"
                android:gravity="bottom"
                android:paddingStart="@dimen/dimen_16_dp"
                android:id="@+id/activity_fun_red_packet_result_detail_back_ll"
                >

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="@dimen/dimen_19_dp"
                    android:src="@drawable/chat_red_packet_open_result_top_back"
                    />
            </LinearLayout>
            <TextView
                android:id="@+id/activity_fun_red_packet_result_detail_red_packet_record_tv"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:text="购物券记录"
                android:textColor="#ff000000"
                android:textSize="14sp"
                android:gravity="end"
                />



        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <LinearLayout
            android:layout_marginTop="@dimen/dimen_19_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/activity_fun_red_packet_result_detail_sender_head_iv"
                android:layout_width="@dimen/dimen_35_dp"
                android:layout_height="@dimen/dimen_35_dp"/>
            <TextView
                android:layout_marginLeft="@dimen/dimen_8_dp"
                android:id="@+id/activity_fun_red_packet_result_detail_sender_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text="洋芋发出的拼手气红包"
                android:textColor="#ff000000"
                android:textSize="18sp"
                />

        </LinearLayout>
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_greeting_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="恭喜发财,大吉大利"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_marginBottom="@dimen/dimen_18_dp"
            android:textColor="#ff999999"
            android:textSize="14sp"
            />
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_money_tv"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:text="手慢了，已抢完"
            android:textColor="#ff8b5fd8"
            android:textSize="26sp"
            android:layout_marginBottom="31dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/activity_fun_red_packet_result_detail_bottom_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_10_dp"
            android:background="#EDEDED"
            />
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_rv_detail_tv"
            android:layout_marginTop="@dimen/dimen_12_dp"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="9个红包共200.00元，55秒被抢光"
            android:textColor="#ff999999"
            android:textSize="14sp"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_fun_red_packet_result_detail_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </LinearLayout>
</LinearLayout>