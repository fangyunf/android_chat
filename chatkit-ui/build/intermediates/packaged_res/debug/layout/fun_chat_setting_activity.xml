<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fun_chat_secondary_page_bg_color"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.netease.yunxin.kit.common.ui.widgets.BackTitleBar
            android:id="@+id/titleBarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:gravity="center_vertical">

            <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                android:id="@+id/fun_chat_setting_activity_avatarView"
                android:layout_width="@dimen/dimen_60_dp"
                android:layout_height="@dimen/dimen_60_dp"
                android:layout_marginLeft="@dimen/dimen_16_dp"
                app:avatarCorner="@dimen/dimen_30_dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_18_dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="会飞的洋芋"
                    android:textColor="#ff000000"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/fun_chat_setting_activity_id"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="8dp"
                    android:text="ID:87988656"
                    android:textColor="#ff999999"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/fun_chat_setting_activity_memo"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp"
            android:layout_marginTop="@dimen/dimen_14_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_recommand"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_to_top"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_clear_history"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp"
            android:layout_marginTop="@dimen/dimen_14_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_clear_dont_notice_msg"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_clear_add_black_list"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp" />

        <include
            android:id="@+id/fun_chat_setting_activity_clear_delete_friend"
            layout="@layout/fun_title_tf_arrow_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_58_dp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/fun_chat_setting_activity_send_msg_rl"
        android:layout_width="301dp"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_marginBottom="@dimen/dimen_40_dp"
        android:background="@drawable/fun_bg_purple_rounded_22">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_centerInParent="true"
            android:text="发消息"
            android:textColor="#ffffffff"
            android:textSize="16sp" />

    </RelativeLayout>
</LinearLayout>