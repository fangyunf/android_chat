<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <ImageView
            android:id="@+id/dialog_chat_egg_open_egg_iv"
            android:scaleType="fitCenter"
            android:layout_width="375dp"
            android:layout_height="327dp"
            />

        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_width="match_parent"
            android:layout_height="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="砸蛋进行时，你是最幸运的"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                />
            <TextView
                android:id="@+id/dialog_chat_egg_open_progress_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                />
        </LinearLayout>
        <com.yaoxin.appbase.view.zzhorizontalprogressbar.ZzHorizontalProgressBar
            android:layout_marginTop="5dp"
            android:id="@+id/dialog_chat_egg_open_pb6"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:zpb_bg_color="#0000"
            app:zpb_border_color="#85ff00"
            app:zpb_border_width="2dp"
            app:zpb_draw_border="false"
            app:zpb_gradient_from="#E784FA"
            app:zpb_gradient_to="#F06BF8"
            app:zpb_open_gradient="false"
            app:zpb_max="100"
            app:zpb_progress="0"
            app:zpb_second_progress="0"
            app:zpb_show_second_progress="true"
            app:zpb_padding="0px"
            app:zpb_round_rect_radius="30px"
            app:zpb_show_mode="round_rect" />

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="144dp"
                android:layout_height="54dp"
                android:src="@mipmap/egg_chat_open_opt_btn_bg"
                />
            <TextView
                android:id="@+id/dialog_chat_egg_open_opt_tv"
                android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加成砸蛋+2"
                android:textColor="#ffffffff"
                android:textSize="24sp"
                />
        </RelativeLayout>
        <TextView
            android:id="@+id/dialog_chat_egg_open_desc_tv"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="砸中即可获得388元余额"
            android:gravity="center"
            android:textColor="#ffffffff"
            android:textSize="12sp"
            />
    </LinearLayout>
    <ImageView
        android:layout_marginTop="20dp"
        android:id="@+id/dialog_chat_egg_open_gif_iv"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="400dp"

        />
</RelativeLayout>