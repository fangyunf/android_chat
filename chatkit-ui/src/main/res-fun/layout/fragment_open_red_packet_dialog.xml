<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="274dp"
        android:layout_height="412dp">
        <ImageView
            android:id="@+id/fragment_open_red_packet_dialog_bg_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/chat_red_packet_open_bg_cant_open"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="230dp"
                android:layout_marginBottom="@dimen/dimen_12_dp"
android:gravity="center_vertical"
                >
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/fragment_open_red_packet_dialog_head_iv"
                    android:layout_width="@dimen/dimen_18_dp"
                    android:layout_height="@dimen/dimen_18_dp"
                    app:riv_corner_radius="9dp"
                    android:scaleType="centerCrop"

                    />
                <TextView
                    android:id="@+id/fragment_open_red_packet_dialog_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginLeft="8dp"
                    android:text="西瓜虫"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="发出的购物券"
                    android:textColor="#ffffffff"
                    android:textSize="16sp"
                    />
            </LinearLayout>

            <TextView
                android:id="@+id/fragment_open_red_packet_dialog_greeting_tv"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="手慢啦，购物券已抢完"
                android:textColor="#ffffffff"
                android:textSize="22sp"
                />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/fragment_open_red_packet_dialog_open_rl"
            android:layout_width="200dp"
            android:layout_height="@dimen/dimen_100_dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="275dp"

            />
        <LinearLayout
            android:id="@+id/fragment_open_red_packet_dialog_detail_rl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/dimen_14_dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="查看领取详情"
                android:textColor="#ffffffff"
                android:textSize="14sp"
                />
            <ImageView
                android:layout_marginLeft="@dimen/dimen_8_dp"
                android:layout_width="5dp"
                android:layout_height="@dimen/dimen_10_dp"
                android:src="@drawable/chat_red_packet_open_right_arrow"
                />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>