<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageForwardLayout"
    android:layout_width="236dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <TextView
        android:id="@+id/messageMultiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_16_dp"
        android:paddingEnd="@dimen/dimen_16_dp"
        android:paddingTop="@dimen/dimen_12_dp"
        android:paddingBottom="@dimen/dimen_8_dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/color_333333"
        android:textSize="@dimen/text_size_16"
        android:textStyle="bold"
        tools:text="群聊的聊天记录" />

    <TextView
        android:id="@+id/messageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_16_dp"
        android:paddingEnd="@dimen/dimen_16_dp"
        android:paddingBottom="@dimen/dimen_10_dp"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:textColor="@color/color_999999"
        android:textSize="@dimen/text_size_14"
        tools:text="张三：你好\n李四：[图片]" />

    <View
        android:id="@+id/messageDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/dimen_16_dp"
        android:layout_marginEnd="@dimen/dimen_16_dp"
        android:background="#E5E5E5" />

    <TextView
        android:id="@+id/messageRecordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dimen_16_dp"
        android:paddingEnd="@dimen/dimen_16_dp"
        android:paddingTop="@dimen/dimen_6_dp"
        android:paddingBottom="@dimen/dimen_10_dp"
        android:text="@string/chat_message_multi_record"
        android:textColor="@color/color_999999"
        android:textSize="12sp"
        tools:text="聊天记录" />

    <androidx.constraintlayout.widget.Placeholder
        android:id="@+id/place_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

</LinearLayout>
