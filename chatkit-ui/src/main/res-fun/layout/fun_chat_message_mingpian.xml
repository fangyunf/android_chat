<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="100dp"
    android:layout_marginHorizontal="5dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fun_chat_mingpian_bg">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/fun_chat_message_mingpian_head_iv"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="@dimen/dimen_10_dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:scaleType="centerCrop"
            app:riv_corner_radius="@dimen/dimen_18_dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fun_chat_message_mingpian_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="张晓汐"
                android:textColor="@color/color_black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fun_chat_message_mingpian_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="123213"
                android:textColor="@color/color_black"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_10_dp"
            android:background="@drawable/bg_app_theme_color_rounded_10"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/dimen_7_dp"
            android:paddingVertical="@dimen/dimen_4_dp"
            android:text="名片"
            android:textColor="@color/color_white"
            android:textSize="12sp"
            android:visibility="gone" />


    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/dimen_10_dp"
        android:text="好友名片"
        android:textColor="@color/color_black"
        android:textSize="12sp" />

</FrameLayout>