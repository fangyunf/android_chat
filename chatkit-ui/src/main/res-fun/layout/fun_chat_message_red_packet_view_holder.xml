<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fun_chat_message_red_packet_view_holder_rl"
    android:layout_width="258dp"
    android:layout_height="100dp"
    android:orientation="vertical"
    android:layout_marginHorizontal="@dimen/dimen_6_dp">

    <ImageView
        android:id="@+id/fun_chat_message_red_packet_view_holder_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/chat_red_packet_cell_bg_no_open"
        />

    <LinearLayout
        android:paddingRight="@dimen/dimen_7_dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        >

        <LinearLayout
            android:layout_width="@dimen/dimen_97_dp"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_alignParentTop="true"
            >
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_money_tv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="1000.00"
                android:textColor="#ff866c09"
                android:textSize="20sp"
                />
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_type_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="购物券"
                android:textColor="#ff866c09"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_greeting_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text="恭喜发财,大吉大利"
                android:textColor="#ffffffff"
                android:textSize="18sp"
                />
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_detail_tv"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="@dimen/dimen_2_dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="分享了一张购物券，赶紧领取下单吧"
                android:textColor="#ffffffff"
                android:textSize="13sp"
                />
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_time_tv"
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:text="2023-11-08 19:20:30"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>