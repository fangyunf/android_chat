<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fun_chat_message_red_packet_view_holder_rl"
    android:layout_width="240dp"
    android:layout_height="100dp"
    android:orientation="vertical"
    android:layout_marginHorizontal="@dimen/dimen_5_dp">

    <ImageView
        android:id="@+id/fun_chat_message_red_packet_view_holder_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chat_red_packet_cell_bg_no_open"
        />

    <LinearLayout
        android:paddingRight="@dimen/dimen_7_dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"


        >


        <LinearLayout
            android:layout_width="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_money_tv"
                android:layout_width="80dp"
                android:layout_height="22dp"
                android:text="0.00"
                android:textColor="#C8131B"
                android:textSize="18sp"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="3dp"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/fun_chat_message_red_packet_view_holder_greeting_tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="专属券"
                    android:textColor="#3A3837"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/fun_chat_message_red_packet_view_holder_greeting_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="恭喜发财,大吉大利"
                    android:maxLength="4"
                    android:textColor="#3A3837"
                    android:textSize="12sp"
                    />
            </LinearLayout>
        </LinearLayout>
        <View
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:background="@color/color_white"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_height="wrap_content">
            <TextView
                android:visibility="gone"
                android:id="@+id/fun_chat_message_red_packet_view_holder_type_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="购物券"
                android:textColor="#ffffffff"
                android:textSize="12sp"
                android:layout_weight="1"
                />
            <TextView
                android:layout_marginLeft="20dp"
                android:id="@+id/fun_chat_message_red_packet_view_holder_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2023-11-08 19:20:30"
                android:textColor="#999999"
                android:textSize="11sp"
                />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>