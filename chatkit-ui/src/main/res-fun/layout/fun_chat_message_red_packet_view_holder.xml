<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fun_chat_message_red_packet_view_holder_rl"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginHorizontal="@dimen/dimen_5_dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/fun_chat_message_red_packet_view_holder_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/chat_red_packet_cell_bg_no_open" />

    <LinearLayout
        android:id="@+id/layoutRedContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:orientation="vertical"
        android:paddingRight="@dimen/dimen_7_dp">

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_greeting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_15_dp"
            android:text="恭喜发财,大吉大利"
            android:textColor="#ffffffff"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_money_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="0.00"
            android:textColor="@color/color_white"
            android:textSize="14sp" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="9dp"
            android:layout_marginTop="5dp"
            android:background="@color/color_white"
            android:visibility="gone" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/dimen_3_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dimen_9_dp">

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_type_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="红包"
            android:textColor="@color/color_white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-11-08 19:20:30"
            android:textColor="@color/color_white"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:id="@+id/fun_chat_message_red_packet_view_holder_mengceng"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:background="@color/color_white"
        android:visibility="gone" />
</FrameLayout>