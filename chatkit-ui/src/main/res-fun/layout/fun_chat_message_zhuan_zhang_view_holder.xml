<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fun_chat_message_red_packet_view_holder_rl"
    android:layout_width="216dp"
    android:layout_height="90dp"
    android:layout_marginHorizontal="@dimen/dimen_5_dp">

    <ImageView
        android:id="@+id/fun_chat_message_red_packet_view_holder_bg_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chat_zhuanzhang_bg_no_open" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="@dimen/dimen_7_dp">

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_type_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_white"
            android:textSize="16sp"
            tools:text="你收到了一笔转账" />

        <TextView
            android:id="@+id/fun_chat_message_red_packet_view_holder_greeting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_white"
            android:textSize="13sp"
            tools:text="来自任万荣qqq" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_time_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_message_zhuan_zhang"
                android:textColor="@color/color_white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/fun_chat_message_red_packet_view_holder_money_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_white"
                android:textSize="11sp"
                tools:text="¥1.00" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
