<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fun_chat_secondary_page_bg_color"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/fun_chat_setting_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="好友资料"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:orientation="vertical"

            android:gravity="center_horizontal">

            <com.netease.yunxin.kit.common.ui.widgets.ContactAvatarView
                android:id="@+id/fun_chat_setting_activity_avatarView"
                android:layout_width="@dimen/dimen_60_dp"
                android:layout_height="@dimen/dimen_60_dp"
                app:avatarCorner="4dp" />

            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="会飞的洋芋"
                    android:textColor="@color/color_333333"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/fun_chat_setting_activity_id"
                    android:layout_width="wrap_content"

                    android:paddingHorizontal="10dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_black_alpha_20_rounded_10"

                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="ID:87988656"
                    android:textColor="@color/color_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fun_chat_setting_activity_content_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_alpha_30_rounded_20"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="15dp"
            android:orientation="vertical">
            <include
                android:id="@+id/fun_chat_setting_activity_memo"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />

            <include
                android:id="@+id/fun_chat_setting_activity_clear_history"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />
<!--            <include-->
<!--                android:id="@+id/fun_chat_setting_activity_recommand"-->
<!--                layout="@layout/fun_title_tf_arrow_view"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="@dimen/dimen_58_dp" />-->

            <include
                android:id="@+id/fun_chat_setting_activity_clear_dont_notice_msg"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />
            <include
                android:id="@+id/fun_chat_setting_activity_to_top"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />



            <include
                android:id="@+id/fun_chat_setting_activity_clear_add_black_list"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />

            <include
                android:id="@+id/fun_chat_setting_activity_clear_delete_friend"
                layout="@layout/fun_title_tf_arrow_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_58_dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fun_chat_setting_activity_send_msg_rl"
        android:layout_width="301dp"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_alignParentBottom="true"
        android:text="发消息"
        android:textColor="#ffffffff"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        />
        <TextView
        android:visibility="gone"
        android:id="@+id/fun_chat_setting_activity_add_friend_tv"
        android:layout_width="253dp"
        android:layout_height="52dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_26"
        android:gravity="center"
        android:text="添加好友"
        android:textColor="#ffffffff"
        android:textSize="18sp" />

</RelativeLayout>

