<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/fun_chat_setting_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@mipmap/icon_nav_title_bg"
            app:back_icon="@mipmap/icon_a_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="好友资料"
            app:title_text_color="@color/color_white"
            app:under_divider_color="@color/transparent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_liaotian_chat_settting"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/dimen_14_dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_16_dp">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/fun_chat_setting_activity_avatarView"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="@dimen/dimen_40_dp" />

                        <ImageView
                            android:id="@+id/ivGradeBg"
                            android:layout_width="80dp"
                            android:layout_height="80dp" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/nameTv"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginLeft="@dimen/dimen_10_dp"
                                android:text=""
                                android:textColor="@color/color_white"
                                android:textSize="22sp" />

                            <ImageView
                                android:id="@+id/ivGrade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fun_chat_setting_activity_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:layout_marginRight="@dimen/dimen_6_dp"
                        android:layout_marginBottom="@dimen/dimen_2_dp"
                        android:text=""
                        android:textColor="@color/color_white"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fun_chat_setting_activity_content_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dimen_16_dp"
                        android:background="@drawable/bg_white_rounded_10"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/fun_chat_setting_activity_memo"
                            layout="@layout/fun_title_tf_arrow_view"
                            android:layout_width="match_parent"
                            android:layout_height="50dp" />

                        <include
                            android:id="@+id/fun_chat_setting_activity_clear_history"
                            layout="@layout/fun_title_tf_arrow_view"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimen_40_dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_16_dp"
                        android:background="@drawable/bg_white_rounded_10"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/fun_chat_setting_activity_to_top"
                            layout="@layout/fun_title_tf_arrow_view"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimen_50_dp" />

                        <include
                            android:id="@+id/fun_chat_setting_activity_clear_dont_notice_msg"
                            layout="@layout/fun_title_tf_arrow_view"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimen_50_dp" />

                        <include
                            android:id="@+id/fun_chat_setting_activity_clear_add_black_list"
                            layout="@layout/fun_title_tf_arrow_view"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dimen_50_dp" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_send"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_40_dp"
                    android:layout_marginBottom="@dimen/dimen_80_dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/dimen_15_dp">

                    <TextView
                        android:id="@+id/fun_chat_setting_activity_send_msg_rl"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_48_dp"
                        android:background="@drawable/fun_bg_app_theme_color_rounded_26"
                        android:gravity="center"
                        android:text="发送消息"
                        android:textColor="@color/color_white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvDelete"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_48_dp"
                        android:layout_marginTop="@dimen/dimen_10_dp"
                        android:background="@drawable/bb_fun_bg_app_theme_color_rounded_22"
                        android:gravity="center"
                        android:text="删除好友"
                        android:textColor="@color/app_theme_color"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/fun_chat_setting_activity_add_friend_tv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_48_dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/dimen_16_dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_26"
        android:gravity="center"
        android:text="添加好友"
        android:textColor="@color/color_white"
        android:textSize="15sp"
        android:visibility="gone" />

</RelativeLayout>
