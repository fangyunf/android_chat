<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_fun_red_packet_record_list_nav"
            style="@style/WhiteFontToolbar"
            android:background="#00000000"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="红包记录"
            app:title_text_color="@color/color_white"
            app:under_divider_color="#000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/activity_fun_red_packet_record_list_receivce_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/selector_selected_round_10_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_fun_red_packet_record_list_receivce_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="我收到的"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_fun_red_packet_record_list_send_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dimen_15_dp"
                android:layout_weight="1"
                android:background="@drawable/selector_selected_round_10_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_fun_red_packet_record_list_send_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="我发出的"
                    android:textColor="#666666"
                    android:textSize="16sp" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dimen_16_dp"
            android:paddingVertical="@dimen/dimen_14_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_110_dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/dimen_20_dp"
                android:background="@drawable/bg_info_rounded_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="vertical">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/activity_fun_red_packet_record_list_head_iv"
                    android:layout_width="51dp"
                    app:riv_corner_radius="@dimen/dimen_25_dp"
                    android:layout_height="51dp" />

                <TextView
                    android:id="@+id/activity_fun_red_packet_record_list_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="16sp" />

            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_fun_red_packet_record_list_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_fun_red_packet_record_list_choose_date_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginRight="15dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/activity_fun_red_packet_record_list_choose_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="2023-11"
            android:textColor="@color/color_white"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="@dimen/dimen_12_dp"
            android:layout_height="@dimen/dimen_6_dp"
            android:layout_marginLeft="@dimen/dimen_4_dp"
            android:src="@drawable/red_packet_record_list_arrow_bottom_new" />
    </LinearLayout>
</RelativeLayout>