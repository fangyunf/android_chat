<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--        <ImageView-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="200dp"-->
        <!--            android:scaleType="fitXY"-->
        <!--             />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/icon_gouwuka_bg"
            android:orientation="vertical">

            <com.yaoxin.appbase.navbar.NavToolbar
                android:id="@+id/activity_fun_red_packet_result_detail_nav"
                style="@style/WhiteFontToolbar"
                android:background="@color/transparent"
                app:back_icon="@mipmap/icon_white_back"
                app:enable_under_divider="true"
                app:support_translucent_status_bar="false"
                app:title="红包详情"
                app:title_text_color="@color/color_white"
                app:under_divider_color="@color/transparent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/activity_fun_red_packet_result_detail_sender_head_iv"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            app:riv_corner_radius="@dimen/dimen_19_dp" />

                        <ImageView
                            android:id="@+id/ivGrade"
                            android:layout_width="@dimen/dimen_38_dp"
                            android:layout_height="@dimen/dimen_38_dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/activity_fun_red_packet_result_detail_sender_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="洋芋发出的拼手气红包"
                        android:textColor="@color/color_white"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/activity_fun_red_packet_result_detail_money_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dimen_10_dp"
                    android:text="手慢了，已抢完"
                    android:textColor="@color/color_white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/activity_fun_red_packet_result_detail_greeting_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginBottom="@dimen/dimen_10_dp"
                    android:text="恭喜发财,大吉大利"
                    android:textColor="#F6ECAF"
                    android:textSize="14sp" />


            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/activity_fun_red_packet_result_detail_bottom_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_rv_detail_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="right"
            android:layout_marginHorizontal="@dimen/dimen_16_dp"
            android:layout_marginVertical="@dimen/dimen_8_dp"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:text="9个红包共200.00元，55秒被抢光"
            android:textColor="#ff999999"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_fun_red_packet_result_detail_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>