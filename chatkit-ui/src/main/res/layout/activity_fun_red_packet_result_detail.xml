<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@drawable/chat_red_packet_open_result_top_bg"
            android:scaleType="fitXY"
            />
        <com.yaoxin.appbase.navbar.NavToolbar

            android:id="@+id/activity_fun_red_packet_result_detail_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="领取详情"

            app:title_text_color="@color/color_white"
            app:under_divider_color="@color/transparent" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        >

        <LinearLayout
            android:layout_marginTop="@dimen/dimen_19_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/activity_fun_red_packet_result_detail_sender_head_iv"
                android:layout_width="@dimen/dimen_35_dp"
                android:layout_height="@dimen/dimen_35_dp"/>
            <TextView
                android:layout_marginLeft="@dimen/dimen_8_dp"
                android:id="@+id/activity_fun_red_packet_result_detail_sender_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text=""
                android:textColor="#ff000000"
                android:textSize="18sp"
                />

        </LinearLayout>
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_greeting_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text="恭喜发财,大吉大利"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_marginBottom="@dimen/dimen_18_dp"
            android:textColor="#ff999999"
            android:textSize="14sp"
            />
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_money_tv"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:text="手慢了，已抢完"
            android:textColor="@color/app_theme_color"
            android:textSize="26sp"
            android:layout_marginBottom="31dp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/activity_fun_red_packet_result_detail_bottom_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_10_dp"
            android:background="#EDEDED"
            />
        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_rv_detail_tv"
            android:layout_marginTop="@dimen/dimen_12_dp"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:text=""
            android:textColor="#ff999999"
            android:textSize="14sp"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_fun_red_packet_result_detail_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </LinearLayout>
</LinearLayout>