<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:scaleType="fitXY"
            android:src="@drawable/chat_red_packet_open_result_top_bg" />

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_fun_red_packet_result_detail_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="领取详情"
            app:title_text_color="@color/color_333333"
            app:under_divider_color="@color/transparent" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_19_dp"
            android:gravity="center_vertical">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/activity_fun_red_packet_result_detail_sender_head_iv"
                android:layout_width="@dimen/dimen_22_dp"
                android:layout_height="@dimen/dimen_22_dp"
                app:riv_corner_radius="@dimen/dimen_11_dp" />

            <TextView
                android:id="@+id/activity_fun_red_packet_result_detail_sender_tv"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="@dimen/dimen_8_dp"
                android:text=""
                android:textColor="@color/color_333333"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_greeting_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_marginBottom="@dimen/dimen_18_dp"
            android:text="恭喜发财,大吉大利"
            android:textColor="#ff999999"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_money_tv"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:layout_marginBottom="31dp"
            android:text=""
            android:textColor="#EB5644"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/activity_fun_red_packet_result_detail_bottom_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_10_dp"
            android:background="#f5f5f5" />

        <TextView
            android:id="@+id/activity_fun_red_packet_result_detail_rv_detail_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:layout_marginTop="@dimen/dimen_12_dp"
            android:text=""
            android:textColor="#ff999999"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activity_fun_red_packet_result_detail_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>