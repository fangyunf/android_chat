<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_fun_send_red_packet_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2f2f2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_fun_send_red_packet_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="发红包"
        app:title_text_color="@color/black"
        app:under_divider_color="@color/transparent" />

    <RelativeLayout
        android:id="@+id/layoutFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--        <ImageView-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="80dp" />-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="@dimen/dimen_20_dp"
            android:layout_marginBottom="@dimen/dimen_20_dp">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvShouqi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拼手气红包"
                    android:textColor="@color/color_black" />

                <View
                    android:id="@+id/viewLine"
                    android:layout_width="@dimen/dimen_30_dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/dimen_5_dp"
                    android:background="@color/app_theme_color" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutZhuanShu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_30_dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvZhuanshu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="专属红包"
                    android:textColor="#666666" />

                <View
                    android:id="@+id/viewLine1"
                    android:layout_width="@dimen/dimen_30_dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="@dimen/dimen_5_dp"
                    android:background="@color/app_theme_color" />

            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/activity_fun_send_red_packet_pin_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!--                <LinearLayout-->
                <!--                    android:id="@+id/activity_fun_send_red_packet_pin_change_type_ll"-->
                <!--                    android:layout_marginTop="@dimen/dimen_22_dp"-->
                <!--                    android:layout_marginLeft="@dimen/dimen_16_dp"-->
                <!--                    android:gravity="center_vertical"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content">-->
                <!--                    <TextView-->
                <!--                        android:id="@+id/activity_fun_send_red_packet_pin_change_type_tv"-->

                <!--                        android:layout_width="wrap_content"-->
                <!--                        android:layout_height="20dp"-->
                <!--                        android:text="拼手气红包"-->
                <!--                        android:textColor="@color/app_theme_color"-->
                <!--                        android:textSize="14sp"-->
                <!--                        />-->
                <!--                    <ImageView-->
                <!--                        android:layout_marginLeft="@dimen/dimen_4_dp"-->
                <!--                        android:layout_width="12dp"-->
                <!--                        android:layout_height="6dp"-->
                <!--                        android:src="@drawable/chat_red_packet_arrow_bottom"-->
                <!--                        />-->

                <!--                </LinearLayout>-->

                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_to_people_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_52_dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="@dimen/dimen_22_dp"
                    android:layout_marginTop="@dimen/dimen_8_dp"
                    android:layout_marginBottom="@dimen/dimen_2_dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_16_dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_marginLeft="@dimen/dimen_3_dp"
                        android:layout_weight="1"
                        android:text="发给谁"
                        android:textColor="#ff000000"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/activity_fun_send_red_packet_to_people_head_iv"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="20dp" />

                        <TextView
                            android:id="@+id/activity_fun_send_red_packet_to_people_name_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dimen_10_dp"
                            android:layout_marginRight="@dimen/dimen_10_dp"
                            android:text="请选择"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_frame_mine_right_arrow" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_count_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_52_dp"
                        android:layout_marginHorizontal="22dp"
                        android:background="@drawable/bg_white_rounded_10"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dimen_16_dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginLeft="@dimen/dimen_3_dp"
                            android:text="个数"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/activity_fun_send_red_packet_count_et"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="@dimen/dimen_6_dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="填写红包个数"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_size_16" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="个"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_team_member_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="@dimen/dimen_22_dp"
                        android:layout_marginTop="8dp"
                        android:text="本群共18人"
                        android:textColor="#ff666666"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_52_dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="@dimen/dimen_8_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_16_dp">

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_money_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="金额"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/activity_fun_send_red_packet_money_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="@dimen/dimen_6_dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="end|center_vertical"
                    android:hint="0.00"
                    android:imeOptions="actionSearch"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="元"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_fun_send_red_packet_greeting_ll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_52_dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="@dimen/dimen_12_dp"
                android:background="@drawable/bg_white_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_16_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="备注"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/activity_fun_send_red_packet_greeting_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dimen_20_dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|right"
                    android:hint="恭喜发财,大吉大利"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_size_16" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="@dimen/dimen_10_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="账户余额："
                    android:textColor="#ff999999"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="0"
                    android:textColor="#ff999999"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="¥"
                    android:textColor="#000000"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_total_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="0.00"
                    android:textColor="#000000"
                    android:textSize="36sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="188dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                app:cardBackgroundColor="@color/app_theme_color"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_send_tv"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="发红包"
                        android:textColor="#ffffffff"
                        android:textSize="16sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/activity_fun_send_red_packet_keybord_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent_half"
            android:visibility="gone">

            <com.yaoxin.appbase.view.pwdkeyboard.PayEditText
                android:id="@+id/PayEditText_pay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <com.yaoxin.appbase.view.pwdkeyboard.Keyboard
                android:id="@+id/KeyboardView_pay"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>