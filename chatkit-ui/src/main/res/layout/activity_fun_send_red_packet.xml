<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_fun_send_red_packet_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_send_red_bg"
            android:visibility="gone" />

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_fun_send_red_packet_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/app_theme_color"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="发红包"
            app:title_text_color="@color/color_white"
            app:under_divider_color="@color/transparent" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutRedOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16_dp"
        android:layout_marginTop="@dimen/dimen_20_dp"
        android:layout_marginBottom="@dimen/dimen_10_dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvShouqi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拼手气红包"
                android:textColor="@color/black" />

            <View
                android:id="@+id/viewLine"
                android:layout_width="@dimen/dimen_30_dp"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/dimen_5_dp"
                android:background="@color/color_black" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutZhuanShu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_30_dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvZhuanshu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专属红包"
                android:textColor="@color/black" />

            <View
                android:id="@+id/viewLine1"
                android:layout_width="@dimen/dimen_30_dp"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/dimen_5_dp"
                android:background="@color/black" />

        </LinearLayout>

    </LinearLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/activity_fun_send_red_packet_nav">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_money_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="left"
                    android:layout_marginLeft="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_16_dp"
                    android:text="金额"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_52_dp"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_8_dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥"
                        android:textColor="@color/black"
                        android:textSize="40sp" />

                    <EditText
                        android:id="@+id/activity_fun_send_red_packet_money_et"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/dimen_6_dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="left|center"
                        android:hint="0.00"
                        android:imeOptions="actionSearch"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="@dimen/dimen_10_dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_ff666666"
                        android:textCursorDrawable="@null"
                        android:textSize="40sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_5_dp"
                    android:background="@color/black" />

                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_count_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_52_dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dimen_16_dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginLeft="@dimen/dimen_3_dp"
                            android:text="红包个数"
                            android:textColor="#ff000000"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/activity_fun_send_red_packet_count_et"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="@dimen/dimen_6_dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="left|center_vertical"
                            android:hint="填写红包个数"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="@color/color_666666"
                            android:textCursorDrawable="@null"
                            android:textSize="@dimen/text_size_16" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="个"
                            android:textColor="@color/black"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_team_member_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_4_dp"
                        android:text="本群共18人"
                        android:textColor="#ff666666"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginHorizontal="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_5_dp"
                        android:background="@color/black" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_greeting_ll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_52_dp"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/activity_fun_send_red_packet_greeting_et"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="恭喜发财,大吉大利"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_ff666666"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/text_size_16" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_5_dp"
                    android:background="@color/black" />


                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_pin_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!--                <LinearLayout-->
                    <!--                    android:id="@+id/activity_fun_send_red_packet_pin_change_type_ll"-->
                    <!--                    android:layout_marginTop="@dimen/dimen_22_dp"-->
                    <!--                    android:layout_marginLeft="@dimen/dimen_16_dp"-->
                    <!--                    android:gravity="center_vertical"-->
                    <!--                    android:layout_width="wrap_content"-->
                    <!--                    android:layout_height="wrap_content">-->
                    <!--                    <TextView-->
                    <!--                        android:id="@+id/activity_fun_send_red_packet_pin_change_type_tv"-->

                    <!--                        android:layout_width="wrap_content"-->
                    <!--                        android:layout_height="20dp"-->
                    <!--                        android:text="拼手气红包"-->
                    <!--                        android:textColor="@color/app_theme_color"-->
                    <!--                        android:textSize="14sp"-->
                    <!--                        />-->
                    <!--                    <ImageView-->
                    <!--                        android:layout_marginLeft="@dimen/dimen_4_dp"-->
                    <!--                        android:layout_width="12dp"-->
                    <!--                        android:layout_height="6dp"-->
                    <!--                        android:src="@drawable/chat_red_packet_arrow_bottom"-->
                    <!--                        />-->
                    <!--                </LinearLayout>-->

                    <LinearLayout
                        android:id="@+id/activity_fun_send_red_packet_to_people_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/dimen_16_dp">

                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/activity_fun_send_red_packet_to_people_head_iv"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:scaleType="centerCrop"
                                app:riv_corner_radius="15dp" />

                            <TextView
                                android:id="@+id/activity_fun_send_red_packet_to_people_name_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dimen_10_dp"
                                android:text="请选择"
                                android:textColor="@color/black"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_marginHorizontal="@dimen/dimen_16_dp"
                            android:layout_marginTop="@dimen/dimen_5_dp"
                            android:background="#99ffffff" />
                    </LinearLayout>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_50_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="¥"
                        android:textColor="@color/black"
                        android:textSize="36sp" />

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_total_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:text="0.00"
                        android:textColor="@color/black"
                        android:textSize="36sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_4_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="账户余额："
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_balance_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:text="0"
                        android:textColor="@color/color_black"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_send_tv"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_28_dp"
                    android:background="@drawable/bg_app_theme_color_rounded_10"
                    android:gravity="center"
                    android:text="发红包"
                    android:textColor="#ffffffff"
                    android:textSize="16sp" />

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/activity_fun_send_red_packet_keybord_rl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent_half"
                android:visibility="gone">

                <com.yaoxin.appbase.view.pwdkeyboard.PayEditText
                    android:id="@+id/PayEditText_pay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="20dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />

                <com.yaoxin.appbase.view.pwdkeyboard.Keyboard
                    android:id="@+id/KeyboardView_pay"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_alignParentBottom="true" />
            </RelativeLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>