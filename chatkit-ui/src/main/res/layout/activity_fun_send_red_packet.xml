<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_fun_send_red_packet_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_fun_send_red_packet_nav"
        style="@style/WhiteFontToolbar"
        android:background="#ffffff"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="发红包"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 红包类型选择器 -->
            <LinearLayout
                android:id="@+id/activity_fun_send_red_packet_type_selector_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_16_dp"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/dimen_8_dp">

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="拼手气红包"
                    android:textColor="#FF8B4513"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="@dimen/dimen_4_dp"
                    android:contentDescription="下拉选择"
                    android:src="@drawable/ic_arrow_bottom" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_fun_send_red_packet_pin_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!--                <LinearLayout-->
                <!--                    android:id="@+id/activity_fun_send_red_packet_pin_change_type_ll"-->
                <!--                    android:layout_marginTop="@dimen/dimen_22_dp"-->
                <!--                    android:layout_marginLeft="@dimen/dimen_16_dp"-->
                <!--                    android:gravity="center_vertical"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content">-->
                <!--                    <TextView-->
                <!--                        android:id="@+id/activity_fun_send_red_packet_pin_change_type_tv"-->

                <!--                        android:layout_width="wrap_content"-->
                <!--                        android:layout_height="20dp"-->
                <!--                        android:text="拼手气红包"-->
                <!--                        android:textColor="@color/app_theme_color"-->
                <!--                        android:textSize="14sp"-->
                <!--                        />-->
                <!--                    <ImageView-->
                <!--                        android:layout_marginLeft="@dimen/dimen_4_dp"-->
                <!--                        android:layout_width="12dp"-->
                <!--                        android:layout_height="6dp"-->
                <!--                        android:src="@drawable/chat_red_packet_arrow_bottom"-->
                <!--                        />-->

                <!--                </LinearLayout>-->

                <!-- 专属红包：选择专属人区域 -->
                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_to_people_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_8_dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/activity_fun_send_red_packet_to_people_head_iv"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/app_default_base_icon_geren"
                        app:riv_corner_radius="10dp" />

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_to_people_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="选择专属人"
                        android:textColor="#ff000000"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_52_dp"
                    android:layout_marginHorizontal="22dp"
                    android:layout_marginTop="@dimen/dimen_16_dp"
                    android:background="@drawable/bg_f2f2f2_rounded_10"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dimen_16_dp">
                    <!-- 拼手气红包：左侧图标（金色方块+拼字） -->
                    <ImageView
                        android:id="@+id/activity_fun_send_red_packet_money_icon_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="@dimen/dimen_8_dp"
                        android:contentDescription="拼手气"
                        android:src="@drawable/temp_ic_pin_lucky"
                        android:visibility="visible" />
                    <!-- 专属红包：金额标签 -->
                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_money_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="总金额"
                        android:textColor="#ff000000"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/activity_fun_send_red_packet_money_et"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/dimen_6_dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="¥00.00"
                        android:imeOptions="actionSearch"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/bg_app_edit_text_cursor"
                        android:textSize="@dimen/text_size_16" />
                    <!-- 专属红包：元 -->
                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_money_yuan_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="元"
                        android:textColor="#ff000000"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>


                <!-- 拼手气红包：红包个数输入框 -->
                <LinearLayout
                    android:id="@+id/activity_fun_send_red_packet_count_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_52_dp"
                        android:layout_marginHorizontal="22dp"
                        android:background="@drawable/bg_f2f2f2_rounded_10"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dimen_16_dp">
                        <!-- 红包图标 -->
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginRight="@dimen/dimen_8_dp"
                            android:contentDescription="红包"
                            android:src="@drawable/temp_ic_red_packet" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="红包个数"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/activity_fun_send_red_packet_count_et"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="@dimen/dimen_6_dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="0"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"
                            android:textCursorDrawable="@drawable/bg_app_edit_text_cursor"
                            android:textSize="@dimen/text_size_16" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="个"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_team_member_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_4_dp"
                        android:text="本群共18人"
                        android:textColor="#ff666666"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
            <!-- 金额输入框 -->


            <LinearLayout
                android:id="@+id/activity_fun_send_red_packet_greeting_ll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_52_dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="@dimen/dimen_12_dp"
                android:background="@drawable/bg_f2f2f2_rounded_10"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dimen_16_dp">

                <EditText
                    android:id="@+id/activity_fun_send_red_packet_greeting_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="恭喜发财,大吉大利"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textCursorDrawable="@drawable/bg_app_edit_text_cursor"
                    android:textSize="@dimen/text_size_16" />

            </LinearLayout>
            <!-- 总金额显示 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_40_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="¥"
                    android:textColor="#ff000000"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_total_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="00.00"
                    android:textColor="#ff000000"
                    android:textSize="48sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="账户余额："
                    android:textColor="#ff999999"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/activity_fun_send_red_packet_balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="0"
                    android:textColor="#ff999999"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/activity_fun_send_red_packet_send_tv"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="@dimen/dimen_40_dp"
                android:background="@drawable/bg_ff4727_rounded_4"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="塞钱进红包"
                android:textColor="#ffffffff"
                android:textSize="18sp" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/activity_fun_send_red_packet_keybord_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent_half"
            android:visibility="gone">

            <com.yaoxin.appbase.view.pwdkeyboard.PayEditText
                android:id="@+id/PayEditText_pay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <com.yaoxin.appbase.view.pwdkeyboard.Keyboard
                android:id="@+id/KeyboardView_pay"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_alignParentBottom="true" />
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>