<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_fun_send_red_packet_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5f5"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_fun_send_red_packet_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/color_white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="转账"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="#e5e5e5" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_white"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/dimen_22_dp">

                <!-- 收款人信息：头像 + 流水号 + 姓名 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_24_dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/activity_fun_send_red_packet_to_people_head_iv"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:scaleType="centerCrop"
                        app:riv_corner_radius="@dimen/dimen_6_dp" />

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_to_people_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text=""
                        android:textColor="#ff000000"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/activity_fun_send_zhuanzhang_liushuihao_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="流水号"
                        android:textColor="@color/color_black"
                        android:textSize="16sp"
                        android:visibility="gone" />


                </LinearLayout>

                <!-- 转账金额 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_32_dp"
                    android:text="转账金额"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/activity_fun_send_red_packet_money_et"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_60_dp"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="0dp"
                    android:textColor="@color/color_black"
                    android:textColorHint="@color/color_black"
                    android:textSize="30sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/dimen_4_dp"
                    android:background="#e5e5e5" />

                <!-- 添加转账说明 -->
                <EditText
                    android:id="@+id/activity_fun_send_red_packet_greeting_et"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_150_dp"
                    android:background="@null"
                    android:gravity="top|left"
                    android:hint="添加转账说明"
                    android:inputType="text"
                    android:paddingHorizontal="0dp"
                    android:paddingTop="@dimen/dimen_16_dp"
                    android:textColor="#ff000000"
                    android:textColorHint="@color/color_666666"
                    android:textSize="16sp" />


                <!-- 账户余额 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_20_dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="账户余额："
                        android:textColor="#ff999999"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/activity_fun_send_red_packet_balance_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#ff999999"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/activity_fun_send_red_packet_send_tv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/dimen_20_dp"
                android:layout_marginTop="@dimen/dimen_40_dp"
                android:background="@drawable/fun_bg_app_theme_color_rounded_26"
                android:gravity="center"
                android:text="转账"
                android:textColor="#ffffffff"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>


</LinearLayout>
