<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_60_dp"
    android:paddingHorizontal="@dimen/dimen_16_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/item_fun_red_packet_result_detail_head_iv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop"
                app:riv_corner_radius="24dp" />

            <ImageView
                android:id="@+id/ivGradeBg"
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </FrameLayout>
        
        <LinearLayout
            android:id="@+id/item_fun_red_packet_result_detail_detail_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_12_dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_fun_red_packet_result_detail_username_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:textColor="#ff000000"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/ivGrade"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_5_dp"
                android:src="@mipmap/mine_grade_level_1"
                android:visibility="gone" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <ImageView
                    android:id="@+id/item_fun_red_packet_result_detail_best_win_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dimen_8_dp"
                    android:src="@drawable/icon_shouqizuja" />

                <TextView
                    android:id="@+id/item_fun_red_packet_result_detail_money_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="元"
                    android:textColor="#B74F51"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_5_dp">

                <!--                <ImageView-->
                <!--                    android:layout_width="@dimen/dimen_20_dp"-->
                <!--                    android:layout_height="@dimen/dimen_15_dp"-->
                <!--                    android:src="@drawable/chat_red_packet_open_result_best_win" />-->


                <TextView
                    android:id="@+id/item_fun_red_packet_result_detail_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:textColor="#ff999999"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_4_dp"
                    android:background="@color/app_theme_color"
                    android:paddingHorizontal="@dimen/dimen_4_dp"
                    android:paddingVertical="@dimen/dimen_2_dp"
                    android:text="手气最佳"
                    android:textColor="@color/color_white"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/dimen_60_dp"
        android:background="#F2F2F2" />
</RelativeLayout>