<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="59dp"
    android:paddingHorizontal="@dimen/dimen_16_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/item_fun_red_packet_result_detail_head_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            app:riv_corner_radius="20dp" />

        <LinearLayout
            android:id="@+id/item_fun_red_packet_result_detail_detail_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_12_dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_fun_red_packet_result_detail_username_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:textColor="@color/color_333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/item_fun_red_packet_result_detail_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:textColor="#ff999999"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_fun_red_packet_result_detail_money_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="元"
                android:textColor="@color/color_333333"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/item_fun_red_packet_result_detail_best_win_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="@dimen/dimen_15_dp"
                    android:src="@drawable/chat_red_packet_open_result_best_win" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginLeft="@dimen/dimen_4_dp"
                    android:text="手气王"
                    android:textColor="#EB5644"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:layout_alignParentBottom="true"
        android:background="#F2F2F2"
        android:visibility="invisible" />
</RelativeLayout>