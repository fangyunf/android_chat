<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/red_packet_toolbar_collapsed"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_red_packet_toolbar_btn"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="#666666"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/red_packet_toolbar_expanded"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/red_packet_btn_exclusive"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_red_packet_toolbar_btn"
            android:gravity="center"
            android:text="专"
            android:textColor="#7B4DFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/red_packet_btn_lucky"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_red_packet_toolbar_btn"
            android:gravity="center"
            android:text="拼"
            android:textColor="#7B4DFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/red_packet_btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_red_packet_toolbar_btn"
            android:gravity="center"
            android:text="➤"
            android:textColor="#E54545"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/red_packet_btn_setting"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_red_packet_toolbar_btn"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#666666"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/red_packet_btn_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_red_packet_toolbar_btn"
            android:gravity="center"
            android:text="✕"
            android:textColor="#666666"
            android:textSize="16sp" />
    </LinearLayout>

</merge>
