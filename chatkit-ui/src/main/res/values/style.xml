<resources>

    <style name="horizontal_light_thin_divider">
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:background">@color/color_d9d9d9</item>
    </style>

    <style name="TransBottomSheetTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@style/BottomDialogAnimation</item>
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>
    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="RedPacketSettingRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="RedPacketSettingLabel">
        <item name="android:layout_width">@dimen/red_packet_setting_label_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/color_333333</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RedPacketSettingSpacer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="RedPacketSettingInput">
        <item name="android:layout_width">@dimen/red_packet_setting_input_width</item>
        <item name="android:layout_height">@dimen/red_packet_setting_input_height</item>
        <item name="android:background">@drawable/bg_red_packet_setting_input</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/color_333333</item>
        <item name="android:textColorHint">#BBBBBB</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="RedPacketSettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">#F0F0F0</item>
    </style>
</resources>