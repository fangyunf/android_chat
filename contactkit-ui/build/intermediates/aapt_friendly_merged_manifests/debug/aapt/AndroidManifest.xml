            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.selector.ContactSelectorActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.search.GlobalSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- fun style activity -->
