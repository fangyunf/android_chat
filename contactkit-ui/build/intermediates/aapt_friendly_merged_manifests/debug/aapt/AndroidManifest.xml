<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.netease.yunxin.kit.contactkit.ui" >

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <provider
            android:name="com.netease.yunxin.kit.corekit.startup.InitializationProvider"
            android:authorities="dollar_openBracket_applicationId_closeBracket.xkit-startup"
            android:exported="false"
            tools:node="merge" >
            <meta-data
                android:name="com.netease.yunxin.kit.contactkit.ui.ContactUIService"
                android:value="xkit.startup" />
        </provider>

        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.contact.ContactActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.addfriend.AddFriendActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.blacklist.BlackListActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.normal.team.TeamListActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.contactkit.ui.fun.addfriend.FunAddFriendVerifyActivity"
            android:launchMode="singleTop"
