<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dimen_60_dp"
    android:paddingHorizontal="16dp"
    >

<ImageView
    android:id="@+id/fun_contact_top_search_new_view_new_friend_iv"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:src="@mipmap/contact_fragment_top_view_item_new_friend"
    android:layout_weight="1"
    />
<ImageView
    android:id="@+id/fun_contact_top_search_new_view_group_notice_iv"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:src="@mipmap/contact_fragment_top_view_item_group_notice"
    android:layout_weight="1"
    />
<ImageView
    android:id="@+id/fun_contact_top_search_new_view_black_list_iv"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:src="@mipmap/contact_fragment_top_view_item_black_list"
    android:layout_weight="1"
    />
</LinearLayout>