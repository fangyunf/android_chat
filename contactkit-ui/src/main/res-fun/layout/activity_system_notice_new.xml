<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_system_notice_new_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/color_white"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="系统通知"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_system_notice_new_rv1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>