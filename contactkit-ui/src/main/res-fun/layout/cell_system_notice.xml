<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:gravity="center_horizontal"
    android:background="@color/color_F2F2F2"
    android:layout_height="wrap_content">
    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/cell_system_notice_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:textColor="#ff999999"
        android:textSize="12sp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_rounded_10"
        android:padding="15dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/cell_system_notice_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="string/clear_message"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/text_size_16" />
        <TextView
            android:layout_marginTop="10dp"
            android:id="@+id/cell_system_notice_detail_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="string/clear_message"
            android:textColor="@color/color_333333"
            android:textSize="@dimen/text_size_16" />
    </LinearLayout>
</LinearLayout>