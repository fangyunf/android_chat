<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cell_system_notice_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="10dp"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_rounded_bg"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/cell_system_notice_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="string/clear_message"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14" />

        <TextView
            android:id="@+id/cell_system_notice_detail_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="string/clear_message"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14" />
    </LinearLayout>
</LinearLayout>