<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/fun_add_friend_verify_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="添加好友"
            app:title_text_color="@color/color_white"
            app:under_divider_color="@color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/dimen_16_dp">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/fun_add_friend_verify_activity_head_iv"
                android:layout_width="@dimen/dimen_60_dp"
                android:layout_height="@dimen/dimen_60_dp"
                android:scaleType="centerCrop"
                app:riv_corner_radius="30dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_18_dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fun_add_friend_verify_activity_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/fun_add_friend_verify_activity_account_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="@dimen/dimen_8_dp"
                    android:text="ID:87988656"
                    android:textColor="@color/color_white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimen_16_dp">

            <TextView
                android:id="@+id/fun_add_friend_verify_activity_et_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="验证信息"
                android:textColor="@color/color_white"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/fun_add_friend_verify_activity_et"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="@dimen/dimen_8_dp"
                android:background="@color/color_F6F6F6"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="top|start"
                android:hint="请输入"
                android:padding="@dimen/dimen_12_dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="@dimen/text_size_16" />

        </LinearLayout>

        <TextView
            android:id="@+id/fun_add_friend_verify_activity_send_rl"
            android:layout_width="301dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_centerInParent="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/dimen_40_dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="发送"
            android:textColor="#ffffffff"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/fun_add_friend_verify_activity_two_opt_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dimen_40_dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">


            <TextView
                android:id="@+id/fun_add_friend_verify_activity_aggre_rl"
                android:layout_width="253dp"
                android:layout_height="52dp"
                android:layout_centerInParent="true"
                android:background="@drawable/fun_bg_app_theme_color_rounded_26"
                android:gravity="center"
                android:text="通过验证"
                android:textColor="#ffffffff"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/fun_add_friend_verify_activity_refuse_rl"
                android:layout_width="100dp"
                android:layout_height="22dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="拒绝"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>