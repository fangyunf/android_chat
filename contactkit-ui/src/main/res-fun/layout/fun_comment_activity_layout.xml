<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/icon_app_bg"
    android:orientation="vertical">

    <!--    <com.netease.yunxin.kit.common.ui.widgets.BackTitleBar-->
    <!--        android:id="@+id/title"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:background="@color/color_white" />-->

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/fun_chat_setting_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back_white"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="备注名"
        app:title_text_color="@color/color_white"
        app:under_divider_color="@color/transparent" />


    <com.netease.yunxin.kit.common.ui.widgets.CleanableEditText
        android:id="@+id/edt_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_16_dp"
        android:background="@drawable/bg_white_rounded_10"
        android:maxLength="15" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvSave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_44_dp"
        android:layout_margin="@dimen/dimen_16_dp"
        android:layout_marginBottom="@dimen/dimen_40_dp"
        android:background="@drawable/fun_bg_app_theme_color_rounded_22"
        android:gravity="center"
        android:text="保存"
        android:textColor="#ffffffff"
        android:textSize="16sp" />

</LinearLayout>