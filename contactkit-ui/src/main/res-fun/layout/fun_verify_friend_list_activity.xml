<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@color/color_160B2C"
    android:layout_height="match_parent">
    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/fun_verify_friend_list_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back_white"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="验证消息"
        app:title_text_color="@color/color_white"
        app:under_divider_color="@color/transparent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fun_verify_friend_list_activity_rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        />
</LinearLayout>