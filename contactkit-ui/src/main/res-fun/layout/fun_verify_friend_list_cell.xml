<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    android:paddingVertical="@dimen/dimen_14_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_8_dp"
        android:layout_toLeftOf="@+id/fun_verify_friend_list_cell_agree_refuse_ll">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/fun_verify_friend_list_cell_head_iv"
            android:layout_width="@dimen/dimen_55_dp"
            android:layout_height="@dimen/dimen_55_dp"

            android:scaleType="centerCrop"
            app:riv_corner_radius="27.5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dimen_16_dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/fun_verify_friend_list_cell_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="陈杰"
                    android:textColor="#ff000000"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/fun_verify_friend_list_cell_id_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginLeft="@dimen/dimen_8_dp"
                    android:text="ID:7876560"
                    android:textColor="#ff666666"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/fun_verify_friend_list_cell_verify_content"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:text="申请加入多多买菜群"
                android:textColor="#ff666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fun_verify_friend_list_cell_verify_msg"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/dimen_5_dp"
                android:text=""
                android:textColor="#ff999999"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fun_verify_friend_list_cell_invite_tv"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/dimen_5_dp"
                android:text=""
                android:textColor="#ff999999"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
    <!-- 查看：先隐藏 -->
    <RelativeLayout
        android:id="@+id/fun_verify_friend_list_cell_opt_rl"
        android:layout_width="49dp"
        android:layout_height="24dp"
        android:layout_alignParentRight="true"
        android:background="@drawable/bg_app_theme_color_rounded_10">

        <TextView
            android:id="@+id/fun_verify_friend_list_cell_opt_tv"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_centerInParent="true"
            android:text="查看"
            android:textColor="#ffffffff"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- 同意、拒绝：直接展示 -->
    <LinearLayout
        android:id="@+id/fun_verify_friend_list_cell_agree_refuse_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/fun_verify_friend_list_cell_refuse_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="拒绝"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/fun_verify_friend_list_cell_agree_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="同意"
            android:textColor="@color/app_theme_color"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>