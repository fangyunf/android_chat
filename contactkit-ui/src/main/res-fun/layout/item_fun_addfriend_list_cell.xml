<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/dimen_14_dp"
    android:background="@color/color_white"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    android:gravity="center_vertical"
    >
    <ImageView
        android:id="@+id/item_fun_addfriend_list_cell_head_iv"
        android:layout_width="@dimen/dimen_50_dp"
        android:layout_height="@dimen/dimen_50_dp"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/dimen_8_dp"
        >
        <TextView
            android:id="@+id/item_fun_addfriend_list_cell_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="阿拉蕾"
            android:textColor="#ff000000"
            android:textSize="16sp"
            />
        <TextView
            android:id="@+id/item_fun_addfriend_list_cell_id_tv"
            android:layout_width="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_height="20dp"
            android:text="ID:87988656"
            android:textColor="#ff666666"
            android:textSize="14sp"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/item_fun_addfriend_list_cell_add_tv"
        android:layout_marginLeft="@dimen/dimen_10_dp"
        android:gravity="center"
        android:background="@drawable/bg_app_theme_color_rounded_10"
        android:layout_width="49dp"
        android:layout_height="24dp"
        android:text="添加"
        android:textColor="#ffffff"
        android:textSize="12sp"
        />

</LinearLayout>