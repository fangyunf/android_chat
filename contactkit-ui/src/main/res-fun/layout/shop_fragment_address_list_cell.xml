<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shop_fragment_address_list_cell_root_ll"
    android:orientation="vertical"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_weight="1"
        android:layout_width="0dp"
            android:orientation="vertical"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/shop_fragment_address_list_cell_name_tv"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="张先生"
android:textColor="#ff000000"
android:textSize="12sp"
/>
            <TextView
                android:id="@+id/shop_fragment_address_list_cell_phone_tv"
                android:layout_marginLeft="5dp"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="18936598758"
android:textColor="#ff000000"
android:textSize="12sp"
/>
        </LinearLayout>

        <TextView
            android:id="@+id/shop_fragment_address_list_cell_address_tv"
            android:layout_marginTop="5dp"
android:layout_width="wrap_content"
            android:maxLines="1"
android:layout_height="wrap_content"
android:text="天津市五华区江滨西路38号"
android:textColor="#ff000000"
android:textSize="12sp"
/>
    </LinearLayout>

        <ImageView
            android:id="@+id/shop_fragment_address_list_cell_edit_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/shop_order_address_edit"
            />
    </LinearLayout>
    <View
        android:layout_marginVertical="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ffe5e5e5"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/shop_fragment_address_list_cell_check_iv"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/shop_order_address_uncheck"
            />
        <TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
android:text="默认地址"
android:textColor="#ff999999"
android:textSize="12sp"
/>

        <TextView
            android:id="@+id/shop_fragment_address_list_cell_delete_tv"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="删除"
android:textColor="#ff999999"
android:textSize="12sp"
/>
    </LinearLayout>

</LinearLayout>