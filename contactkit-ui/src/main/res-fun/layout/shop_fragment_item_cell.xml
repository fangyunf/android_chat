<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shop_fragment_item_cell_root_cl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_shop_product_card"
    android:clipChildren="true"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/shop_fragment_item_cell_shop_iv"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        tools:background="#DDDDDD" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_tag_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_shop_tag_category"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#1D4ED8"
        android:textSize="11sp"
        tools:text="键盘" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_shop_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#111827"
        android:textSize="14sp"
        tools:text="青轴机械键盘 87键" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_shop_price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:textColor="#DC2626"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="¥299" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_sold_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="4dp"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        tools:text="已售 2.1万" />
</LinearLayout>
