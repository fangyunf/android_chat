<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shop_fragment_item_cell_root_cl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_shop_product_card"
    android:clipChildren="true"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/shop_fragment_item_cell_shop_iv"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        tools:background="#DDDDDD" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_tag_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_shop_tag_gift"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="礼盒"
        android:textColor="#C67A2F"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_shop_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#222222"
        android:textSize="14sp"
        tools:text="中秋团圆礼盒" />

    <TextView
        android:id="@+id/shop_fragment_item_cell_shop_price_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:textColor="#E54D42"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="¥398" />
</LinearLayout>
