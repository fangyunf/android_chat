<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/shop_fragment_item_cell_root_cl"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_white_rounded_10"
    android:layout_height="wrap_content">
<ImageView
    android:id="@+id/shop_fragment_item_cell_shop_iv"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintDimensionRatio="1:1"/>
    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/shop_fragment_item_cell_shop_iv"
        android:layout_width="match_parent"
        android:padding="10dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/shop_fragment_item_cell_shop_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_weight="1"
            android:textColor="@color/color_333333"
            android:text=""/>
        <TextView
            android:id="@+id/shop_fragment_item_cell_shop_price_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/app_theme_red_color"
            android:text=""/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>