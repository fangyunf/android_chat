<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_white"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/dimen_16_dp">

        <!-- 黑名单 -->
        <LinearLayout
            android:id="@+id/contact_header_blacklist_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_f6f1ff_rounded_4"
                android:paddingVertical="@dimen/dimen_6_dp">

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/caontact_list_grou_note" />

                <TextView
                    android:id="@+id/contact_header_group_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="right"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/color_white"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8_dp"
                android:text="群通知"
                android:textColor="@color/color_333333"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 新的好友 -->
        <LinearLayout
            android:id="@+id/contact_header_new_friend_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_f6f1ff_rounded_4"
                android:paddingVertical="@dimen/dimen_6_dp">

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/caontact_list_header_new_friend" />

                <TextView
                    android:id="@+id/contact_header_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="right"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/color_white"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="新的好友"
                android:textColor="@color/color_333333"
                android:textSize="14sp" />


        </LinearLayout>

        <!-- 我的群组 -->
        <LinearLayout
            android:id="@+id/contact_header_my_groups_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_f6f1ff_rounded_4"
                android:paddingVertical="@dimen/dimen_6_dp">

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/caontact_list_header_qunliao" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8_dp"
                android:text="我的群组"
                android:textColor="@color/color_333333"
                android:textSize="14sp" />
        </LinearLayout>


        <!-- 官方客服 -->
        <LinearLayout
            android:id="@+id/contact_header_customer_service_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_f6f1ff_rounded_4"
                android:paddingVertical="@dimen/dimen_6_dp">

                <ImageView
                    android:layout_width="@dimen/dimen_20_dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/caontact_list_header_kefu" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8_dp"
                android:text="官方客服"
                android:textColor="@color/color_333333"
                android:textSize="14sp" />
        </LinearLayout>


    </LinearLayout>

    <!-- Tab 切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_header_friend_tab_tv"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="好友"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="16sp" />

            <View
                android:id="@+id/contact_header_friend_line"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/app_theme_color"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_header_group_tab_tv"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="分组"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="16sp" />

            <View
                android:id="@+id/contact_header_group_line"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/app_theme_color"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_header_team_tab_tv"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="群聊"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="16sp" />

            <View
                android:id="@+id/contact_header_team_line"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/app_theme_color"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color_E8E8E8"
        android:visibility="gone" />

</LinearLayout>

