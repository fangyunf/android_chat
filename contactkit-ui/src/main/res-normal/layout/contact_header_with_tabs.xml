<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_contact_card_16"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <!-- 新的好友 -->
        <LinearLayout
            android:id="@+id/contact_header_new_friend_ll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/caontact_list_header_new_friend" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="新的好友"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/contact_header_new_friend_num_tv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/fun_bg_red_rounded_9"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingHorizontal="4dp"
                android:textColor="@color/color_white"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="70dp"
            android:background="#F0F0F0" />

        <!-- 我的群聊 -->
        <LinearLayout
            android:id="@+id/contact_header_my_groups_ll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/caontact_list_header_qunliao" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="我的群聊"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="70dp"
            android:background="#F0F0F0" />

        <!-- 客服 -->
        <LinearLayout
            android:id="@+id/contact_header_customer_service_ll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/caontact_list_header_kefu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="客服"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="70dp"
            android:background="#F0F0F0" />

        <!-- 黑名单 -->
        <LinearLayout
            android:id="@+id/contact_header_blacklist_ll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/caontact_list_header_hmd" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="黑名单"
                android:textColor="#1A1A1A"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tab 保留但隐藏，兼容旧逻辑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/contact_header_friend_tab_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="好友" />

        <View
            android:id="@+id/contact_header_friend_line"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/contact_header_group_tab_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分组" />

        <View
            android:id="@+id/contact_header_group_line"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/contact_header_team_tab_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="群聊" />

        <View
            android:id="@+id/contact_header_team_line"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
</LinearLayout>
