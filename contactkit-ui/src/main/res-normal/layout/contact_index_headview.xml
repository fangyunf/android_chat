<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp"
    android:background="@drawable/bg_white_rounded_12"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/contact_index_headview_1_ll"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingVertical="15dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/dimen_32_dp"
            android:layout_height="@dimen/dimen_32_dp"
            android:src="@drawable/contact_list_index_top_1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="客服消息"
            android:textColor="#ff333333"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contact_index_headview_2_ll"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"

        android:orientation="vertical"

        android:gravity="center_horizontal"
        android:paddingVertical="15dp">

        <ImageView
            android:layout_width="@dimen/dimen_32_dp"
            android:layout_height="@dimen/dimen_32_dp"
            android:src="@drawable/contact_list_index_top_2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="黑名单"
            android:textColor="#ff333333"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contact_index_headview_3_ll"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"

        android:orientation="vertical"

        android:gravity="center_horizontal"
        android:paddingVertical="15dp">

        <ImageView
            android:layout_width="@dimen/dimen_32_dp"
            android:layout_height="@dimen/dimen_32_dp"
            android:src="@drawable/contact_list_index_top_3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新好友"
            android:textColor="#ff333333"
            android:layout_marginTop="10dp"
            android:textSize="13sp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contact_index_headview_4_ll"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"

        android:orientation="vertical"

        android:gravity="center_horizontal"
        android:paddingVertical="15dp">

        <ImageView
            android:layout_width="@dimen/dimen_32_dp"
            android:layout_height="@dimen/dimen_32_dp"
            android:src="@drawable/contact_list_index_top_4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="群聊"
            android:textColor="#ff333333"
            android:layout_marginTop="10dp"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contact_index_headview_5_ll"
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:orientation="vertical"

        android:gravity="center_horizontal"
        android:paddingVertical="15dp">

        <ImageView
            android:layout_width="@dimen/dimen_32_dp"
            android:layout_height="@dimen/dimen_32_dp"
            android:src="@drawable/contact_list_index_top_5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="系统通知"
            android:textColor="#ff333333"
            android:layout_marginTop="10dp"
            android:textSize="13sp"/>

    </LinearLayout>
</LinearLayout>