<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/contact_new_fragment_top_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:paddingHorizontal="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingRight="10dp">

                <ImageView
                    android:id="@+id/contact_new_fragment_search_iv"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginHorizontal="10dp"
                    android:src="@mipmap/conversation_list_index_notice_icon" />

                <TextView
                    android:id="@+id/fun_conversation_fragment_title_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="联系人"

                    android:textColor="@color/color_black"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/contact_new_fragment_more_iv"

                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@mipmap/contact_fragment_add" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/contact_new_fragment_search_ll"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_f2f2f2_rounded_4"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="10dp"
                android:src="@mipmap/conversation_list_index_search_icon1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textColor="@color/color_black"
                android:textSize="15sp" />

        </LinearLayout>
        <!--        <LinearLayout-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_marginTop="15dp"-->
        <!--            android:paddingHorizontal="10dp"-->
        <!--            android:gravity="center_vertical"-->
        <!--            android:layout_height="wrap_content">-->

        <!--            <ImageView-->
        <!--                android:src="@mipmap/conversation_list_index_notice_icon"-->
        <!--                android:layout_width="25dp"-->
        <!--                android:layout_height="25dp"/>-->
        <!--            <com.sunfusheng.marqueeview.MarqueeView-->
        <!--                android:id="@+id/contact_new_fragment_marqueeView"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="30dp"-->
        <!--                android:layout_marginLeft="10dp"-->
        <!--                app:mvAnimDuration="1000"-->
        <!--                app:mvDirection="bottom_to_top"-->
        <!--                app:mvInterval="3000"-->
        <!--                app:mvSingleLine="true"-->
        <!--                app:mvTextColor="@color/color_333333"-->
        <!--                app:mvTextSize="14sp" />-->

        <!--        </LinearLayout>-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@color/transparent">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contact_new_fragment_friend_tv"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="好友"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/contact_new_fragment_friend_tv_line"
                    android:layout_width="30dp"
                    android:layout_height="4dp"

                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"
                    android:background="@color/app_theme_color" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/contact_new_fragment_group_tv"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="群聊"
                    android:textColor="@color/color_black"
                    android:textSize="18sp" />

                <View
                    android:id="@+id/contact_new_fragment_group_tv_line"
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_alignParentBottom="true"

                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"
                    android:background="@color/app_theme_color"
                    android:visibility="gone" />
            </RelativeLayout>
            <!--            <TextView-->
            <!--                android:layout_marginLeft="20dp"-->
            <!--                android:id="@+id/contact_new_fragment_group_tv"-->
            <!--                android:layout_width="0dp"-->
            <!--                android:layout_height="match_parent"-->
            <!--                android:layout_weight="1"-->
            <!--                android:gravity="center"-->
            <!--                android:text="群聊"-->
            <!--                android:textColor="@color/color_white"-->
            <!--                android:textSize="18sp"-->
            <!--                />-->
            <LinearLayout
                android:id="@+id/contact_new_fragment_new_friend_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|center"

                android:visibility="gone">

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="新的好友"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="12sp"
                    android:visibility="gone" />


            </LinearLayout>
        </LinearLayout>

        <FrameLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/main_search"
            android:background="@color/transparent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent" />

            <!--字母导航栏-->
            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>