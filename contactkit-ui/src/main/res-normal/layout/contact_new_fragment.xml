<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/color_F2F2F2"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg" />

    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/contact_new_fragment_top_ll"
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:paddingHorizontal="15dp"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/contact_new_fragment_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通讯录"
                android:layout_weight="1"
                android:textColor="#ff000000"
                android:textSize="21sp"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:gravity="center_vertical"
                android:paddingRight="10dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/contact_new_fragment_search_iv"
                    android:layout_marginHorizontal="10dp"
                    android:src="@mipmap/conversation_index_pop_search"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/contact_new_fragment_more_iv"

                    android:src="@mipmap/conversation_index_pop_more"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:background="@color/color_white"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView
                android:id="@+id/contact_new_fragment_friend_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="好友列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp"
                />
            <TextView
                android:id="@+id/contact_new_fragment_group_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="群组列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp"
                />
            <LinearLayout
                android:id="@+id/contact_new_fragment_new_friend_ll"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|center"

                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="新的好友"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp"
                    />

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="12sp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    />



            </LinearLayout>
        </LinearLayout>
        <FrameLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_white"
            android:layout_below="@+id/main_search">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent" />

            <!--字母导航栏-->
            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>