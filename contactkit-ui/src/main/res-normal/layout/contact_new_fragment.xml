    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white"
        >
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            >

            <RelativeLayout
                android:id="@+id/contact_new_fragment_new_friend_rl"
                android:layout_centerInParent="true"
                android:layout_width="95dp"
                android:layout_height="65dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/contact_fragment_top_view_item_new_friend"
                    />
                <TextView
                    android:visibility="gone"
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_18_dp"
                    android:minWidth="@dimen/dimen_18_dp"
                    android:paddingHorizontal="5dp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    android:layout_alignParentEnd="true"
                    />
            </RelativeLayout>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            >

            <RelativeLayout
                android:id="@+id/contact_new_fragment_group_notice_rl"
                android:layout_centerInParent="true"
                android:layout_width="95dp"
                android:layout_height="65dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/contact_fragment_top_view_item_group_notice"
                    />
                <TextView
                    android:visibility="gone"
                    android:id="@+id/contact_new_fragment_group_notice_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dimen_18_dp"
                    android:minWidth="@dimen/dimen_18_dp"
                    android:paddingHorizontal="5dp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#ffffffff"
                    android:textSize="12sp"
                    android:layout_alignParentEnd="true"
                    />
            </RelativeLayout>

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            >

            <RelativeLayout
                android:id="@+id/contact_new_fragment_black_list"
                android:layout_centerInParent="true"
                android:layout_width="95dp"
                android:layout_height="65dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/contact_fragment_top_view_item_black_list"
                    />
            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_search">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contact_new_fragment_rv"
            android:background="@color/color_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <!--字母导航栏-->
        <com.nanchen.wavesidebar.WaveSideBarView
            android:id="@+id/contact_new_fragment_main_side_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            app:sidebar_lazy_respond="false"
            app:sidebar_text_color="@color/black"/>

    </FrameLayout>

</LinearLayout>