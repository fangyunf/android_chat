<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_changsheng_page_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/contact_new_fragment_top_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/fun_conversation_fragment_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_contact_title_pill"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="通讯录"
                android:textColor="#1A1A1A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/contact_new_fragment_search_iv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_contact_action_circle"
                android:padding="8dp"
                android:src="@mipmap/conversation_list_index_notice_icon" />

            <ImageView
                android:id="@+id/contact_new_fragment_more_iv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_contact_action_circle"
                android:padding="8dp"
                android:src="@mipmap/conversation_index_pop_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fun_conversation_fragment_search_ll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_contact_search_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@mipmap/conversation_list_index_search_icon1" />

            <EditText
                android:id="@+id/fun_conversation_fragment_et"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#1A1A1A"
                android:textColorHint="#8E8E93"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 兼容旧搜索入口 -->
        <LinearLayout
            android:id="@+id/contact_new_fragment_search_ll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/contact_new_fragment_friend_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/contact_new_fragment_group_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/contact_new_fragment_new_friend_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:background="@color/transparent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/contact_new_fragment_empty_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:text="暂无联系人"
                android:textColor="#BBBBBB"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
