<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        android:visibility="gone" />

    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_bg"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/contact_new_fragment_top_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:paddingHorizontal="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingRight="10dp">

                    <TextView
                        android:id="@+id/fun_conversation_fragment_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingLeft="60dp"
                        android:text="联系人"
                        android:textColor="@color/color_black"
                        android:textSize="20sp" />

                    <ImageView
                        android:id="@+id/contact_new_fragment_search_iv"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginHorizontal="10dp"
                        android:src="@mipmap/conversation_list_index_notice_icon" />

                    <ImageView
                        android:id="@+id/contact_new_fragment_more_iv"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@mipmap/conversation_index_pop_more" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contact_new_fragment_search_ll"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="@dimen/dimen_16_dp"
                android:background="@drawable/bg_white_rounded_12"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="10dp"
                    android:src="@mipmap/conversation_list_index_search_icon1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索"
                    android:textColor="#8E8E93"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>
        <!--        <LinearLayout-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_marginTop="15dp"-->
        <!--            android:paddingHorizontal="10dp"-->
        <!--            android:gravity="center_vertical"-->
        <!--            android:layout_height="wrap_content">-->

        <!--            <ImageView-->
        <!--                android:src="@mipmap/conversation_list_index_notice_icon"-->
        <!--                android:layout_width="25dp"-->
        <!--                android:layout_height="25dp"/>-->
        <!--            <com.sunfusheng.marqueeview.MarqueeView-->
        <!--                android:id="@+id/contact_new_fragment_marqueeView"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="30dp"-->
        <!--                android:layout_marginLeft="10dp"-->
        <!--                app:mvAnimDuration="1000"-->
        <!--                app:mvDirection="bottom_to_top"-->
        <!--                app:mvInterval="3000"-->
        <!--                app:mvSingleLine="true"-->
        <!--                app:mvTextColor="@color/color_333333"-->
        <!--                app:mvTextSize="14sp" />-->

        <!--        </LinearLayout>-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@color/color_white"
            android:visibility="gone">

            <TextView
                android:id="@+id/contact_new_fragment_friend_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="好友列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/contact_new_fragment_group_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="群组列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/contact_new_fragment_new_friend_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"

                android:gravity="center_vertical|center">

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="新的好友"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="12sp"
                    android:visibility="gone" />


            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/main_search"
            android:background="@color/color_white">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent" />

            <!--字母导航栏（只在好友列表显示）-->
            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>