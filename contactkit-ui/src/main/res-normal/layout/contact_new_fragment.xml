<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2">

    <!--    <ImageView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="@dimen/dimen_140_dp"-->
    <!--        android:scaleType="fitXY"-->
    <!--        android:src="@mipmap/common_main_top_bg" />-->

    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@mipmap/common_main_top_bg"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/contact_new_fragment_top_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:paddingHorizontal="15dp">

                <TextView
                    android:id="@+id/contact_new_fragment_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="通讯录"
                    android:textColor="#ff000000"
                    android:textSize="21sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingRight="10dp">

                    <ImageView
                        android:id="@+id/contact_new_fragment_search_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@mipmap/conversation_index_pop_search" />

                    <ImageView
                        android:id="@+id/contact_new_fragment_xiaozhushou"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginLeft="@dimen/dimen_20_dp"
                        android:src="@mipmap/app_default_base_icon_xiaozhushou" />

                    <ImageView
                        android:id="@+id/contact_new_fragment_more_iv"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/conversation_index_pop_more"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/contact_new_fragment_friend_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="好友列表"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/contact_new_fragment_group_tv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="群组列表"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/contact_new_fragment_new_friend_ll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"

                    android:gravity="center_vertical|center">

                    <TextView
                        android:id="@+id/contact_new_fragment_new_friend_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="新的好友"
                        android:textColor="@drawable/fun_common_text_color_selector"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/contact_new_fragment_new_friend_num_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:background="@drawable/fun_bg_red_rounded_9"
                        android:gravity="center"
                        android:minWidth="18dp"
                        android:text=""
                        android:textColor="@color/color_white"
                        android:textSize="12sp" />


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/main_search"
            android:background="@color/color_white">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent" />

            <!--字母导航栏-->
            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />

        </FrameLayout>

    </LinearLayout>

</RelativeLayout>