<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/color_160B2C"
    android:layout_height="match_parent">


    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/contact_new_fragment_top_ll"
            android:layout_marginTop="55dp"
            android:layout_width="match_parent"
            android:paddingHorizontal="15dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center_vertical"
                android:paddingRight="10dp"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/contact_new_fragment_search_iv"
                    android:layout_marginHorizontal="10dp"
                    android:src="@mipmap/conversation_list_index_notice_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
                <TextView
                    android:id="@+id/fun_conversation_fragment_title_tv"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="联系人"
                    android:gravity="center"

                    android:textColor="@color/color_white"
                    android:textSize="16sp"
                    />
                <ImageView
                    android:id="@+id/contact_new_fragment_more_iv"

                    android:src="@mipmap/contact_fragment_add"
                    android:layout_width="25dp"
                    android:layout_height="25dp"/>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/contact_new_fragment_search_ll"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="5dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_white_rounded_10"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="30dp">

            <ImageView
                android:src="@mipmap/conversation_list_index_search_icon1"
                android:layout_width="16dp"
                android:layout_marginRight="10dp"
                android:layout_height="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textColor="#ffa0a0a0"
                android:textSize="15sp"
                />

        </LinearLayout>
<!--        <LinearLayout-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_marginTop="15dp"-->
<!--            android:paddingHorizontal="10dp"-->
<!--            android:gravity="center_vertical"-->
<!--            android:layout_height="wrap_content">-->

<!--            <ImageView-->
<!--                android:src="@mipmap/conversation_list_index_notice_icon"-->
<!--                android:layout_width="25dp"-->
<!--                android:layout_height="25dp"/>-->
<!--            <com.sunfusheng.marqueeview.MarqueeView-->
<!--                android:id="@+id/contact_new_fragment_marqueeView"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="30dp"-->
