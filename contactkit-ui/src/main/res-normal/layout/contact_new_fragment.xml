<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:background="@mipmap/concat_top_bg"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/contact_new_fragment_top_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="15dp"
                android:paddingTop="@dimen/dimen_25_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/contact_new_fragment_search_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@mipmap/conversation_list_index_notice_icon"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/fun_conversation_fragment_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="联系人"
                        android:textColor="@color/color_white"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/contact_new_fragment_more_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/saoyisao" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/contact_new_fragment_search_ll"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dimen_16_dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="搜索"
                        android:textColor="#ffa0a0a0"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@mipmap/icon_sousou" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:layout_marginBottom="@dimen/dimen_14_dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dimen_16_dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/layoutNewFriend"
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/fun_concat_top_bg"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_new_pengyou" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="新的朋友"
                                android:textColor="#ffffffff"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/caontact_list_header_new_friend_num_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="right"
                            android:background="@drawable/fun_bg_red_rounded_9"
                            android:gravity="center"
                            android:minWidth="18dp"
                            android:text="99"
                            android:textColor="@color/color_white"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutMyGrop"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_marginLeft="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_4_dp"
                        android:layout_weight="1"
                        android:background="@drawable/fun_concat_top_bg"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icon_new_group" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginTop="@dimen/dimen_5_dp"
                            android:text="我的群聊"
                            android:textColor="#ffffffff"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_16_dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/layoutGropNotice"
                            android:layout_width="match_parent"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/fun_concat_top_bg"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_qun_message" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="群通知"
                                android:textColor="#ffffffff"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/team_nontice_num"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="right"
                            android:background="@drawable/fun_bg_red_rounded_9"
                            android:gravity="center"
                            android:minWidth="18dp"
                            android:text="99"
                            android:textColor="@color/color_white"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutKehu"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_marginLeft="@dimen/dimen_16_dp"
                        android:layout_marginTop="@dimen/dimen_4_dp"
                        android:layout_weight="1"
                        android:background="@drawable/fun_concat_top_bg"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icon_guanfang_kehu" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginTop="@dimen/dimen_5_dp"
                            android:text="官方客服"
                            android:textColor="#ffffffff"
                            android:textSize="14sp" />

                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
        <!--        <LinearLayout-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_marginTop="15dp"-->
        <!--            android:paddingHorizontal="10dp"-->
        <!--            android:gravity="center_vertical"-->
        <!--            android:layout_height="wrap_content">-->

        <!--            <ImageView-->
        <!--                android:src="@mipmap/conversation_list_index_notice_icon"-->
        <!--                android:layout_width="25dp"-->
        <!--                android:layout_height="25dp"/>-->
        <!--            <com.sunfusheng.marqueeview.MarqueeView-->
        <!--                android:id="@+id/contact_new_fragment_marqueeView"-->
        <!--                android:layout_width="match_parent"-->
        <!--                android:layout_height="30dp"-->
        <!--                android:layout_marginLeft="10dp"-->
        <!--                app:mvAnimDuration="1000"-->
        <!--                app:mvDirection="bottom_to_top"-->
        <!--                app:mvInterval="3000"-->
        <!--                app:mvSingleLine="true"-->
        <!--                app:mvTextColor="@color/color_333333"-->
        <!--                app:mvTextSize="14sp" />-->

        <!--        </LinearLayout>-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@color/color_white"
            android:visibility="gone">

            <TextView
                android:id="@+id/contact_new_fragment_friend_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="好友列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/contact_new_fragment_group_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="群组列表"
                android:textColor="@drawable/fun_common_text_color_selector"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/contact_new_fragment_new_friend_ll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|center">

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="新的好友"
                    android:textColor="@drawable/fun_common_text_color_selector"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/contact_new_fragment_new_friend_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/fun_bg_red_rounded_9"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:text=""
                    android:textColor="@color/color_white"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/main_search"
            android:background="@color/color_white">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contact_new_fragment_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent" />


            <LinearLayout
                android:id="@+id/layoutNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="133dp"
                    android:layout_height="138dp"
                    android:src="@drawable/icon_zhanwushuju" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无联系人"
                    android:textColor="@color/color_999999" />

            </LinearLayout>

            <!--字母导航栏-->
            <com.nanchen.wavesidebar.WaveSideBarView
                android:id="@+id/contact_new_fragment_main_side_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:sidebar_lazy_respond="false"
                app:sidebar_text_color="@color/black" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>