<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@color/transparent"
    android:gravity="center_horizontal"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/cell_fun_team_setting_users_mingdan_tv_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:text="A"
            android:textSize="14sp"
            android:textColor="@color/color_white"
            android:background="@color/color_160B2C"/>
    </LinearLayout>
    <LinearLayout

        android:layout_marginHorizontal="8dp"
        android:paddingVertical="@dimen/dimen_14_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp"
        >
    

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/cell_fun_team_setting_users_mingdan_head_iv"
            android:layout_width="@dimen/dimen_44_dp"
            android:layout_height="@dimen/dimen_44_dp"
            app:riv_corner_radius="22dp"
            android:scaleType="centerCrop"

            />
        <TextView
            android:id="@+id/cell_fun_team_setting_users_mingdan_name_tv"
            android:layout_marginLeft="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:text="哔哩吧啦"
            android:textColor="@color/color_white"
            android:textSize="16sp"
            />
    </LinearLayout>
    
</LinearLayout>