<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_F2F2F2"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/cell_fun_team_setting_users_mingdan_tv_index"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:paddingLeft="12dp"
            android:text="A"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_white"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dimen_16_dp"
        android:paddingVertical="@dimen/dimen_14_dp">

        <FrameLayout
            android:layout_width="@dimen/dimen_44_dp"
            android:layout_height="@dimen/dimen_44_dp">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/cell_fun_team_setting_users_mingdan_head_iv"
                android:layout_width="@dimen/dimen_44_dp"
                android:layout_height="@dimen/dimen_44_dp"
                android:scaleType="centerCrop"
                app:riv_corner_radius="22dp" />

            <ImageView
                android:id="@+id/tvGradbg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8_dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cell_fun_team_setting_users_mingdan_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="哔哩吧啦"
                android:textColor="#ff000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cell_fun_team_setting_users_mingdan_logout_tv"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_f2f2f2_rounded_4"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/contact_user_logout"
                android:textColor="@color/color_8f8f8f"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivGrade"
            android:layout_width="@dimen/dimen_60_dp"
            android:layout_height="@dimen/dimen_30_dp"
            android:layout_marginLeft="5dp"
            android:src="@mipmap/mine_grade_level_1"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1_dp"
        android:background="#F2F2F2" />

</LinearLayout>