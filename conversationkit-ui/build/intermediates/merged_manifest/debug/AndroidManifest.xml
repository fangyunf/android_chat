<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.netease.yunxin.kit.conversationkit.ui" >

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <provider
            android:name="com.netease.yunxin.kit.corekit.startup.InitializationProvider"
            android:authorities="${applicationId}.xkit-startup"
            android:exported="false"
            tools:node="merge" >
            <meta-data
                android:name="com.netease.yunxin.kit.conversationkit.ui.ConversationUIService"
                android:value="xkit.startup" />
        </provider>

        <activity
            android:name="com.netease.yunxin.kit.conversationkit.ui.normal.page.ConversationSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.conversationkit.ui.normal.page.ConversationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.netease.yunxin.kit.conversationkit.ui.fun.page.FunConversationActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name="com.netease.yunxin.kit.conversationkit.ui.fun.page.FunSelected_User_Activity" />
    </application>

</manifest>