<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_system_notice_new_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/app_theme_color"
        app:back_icon="@mipmap/temp_ic_back_white"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="系统通知"
        app:title_text_color="@color/color_white"
        app:under_divider_color="@color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_info_rounded_bg"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dimen_10_dp">

        <LinearLayout
            android:id="@+id/activity_system_notice_new_xttz_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/system_notice_xttz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:text="系统通知"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_system_notice_new_xttz_num_tv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/fun_bg_red_rounded_9"
                android:gravity="center"
                android:minWidth="18dp"
                android:text="99"
                android:textColor="@color/color_white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_system_notice_new_qtz_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/system_notice_quntongzhi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:text="群通知"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_system_notice_new_qtz_num_tv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/fun_bg_red_rounded_9"
                android:gravity="center"
                android:minWidth="18dp"
                android:text="99"
                android:textColor="@color/color_white"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_system_notice_new_qbxx_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/system_notice_qianbao" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:text="钱包消息"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_system_notice_new_qbxx_num_tv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/fun_bg_red_rounded_9"
                android:gravity="center"
                android:minWidth="18dp"
                android:text="99"
                android:textColor="@color/color_white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>


</LinearLayout>