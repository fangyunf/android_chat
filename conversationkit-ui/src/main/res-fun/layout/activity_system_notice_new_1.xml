<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_white"

    xmlns:app="http://schemas.android.com/apk/res-auto">



    <com.yaoxin.appbase.navbar.NavToolbar

        android:id="@+id/activity_system_notice_new_nav"
        style="@style/WhiteFontToolbar"
        android:background="#ffffff"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="系统通知"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent"

        />

<LinearLayout
    android:id="@+id/activity_system_notice_new_xttz_ll"
    android:layout_width="match_parent"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:paddingHorizontal="15dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/system_notice_xttz"
        />
    <TextView
        android:layout_marginHorizontal="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="系统通知"
        android:textColor="#ff000000"
        android:textSize="15sp"
        />
    <TextView
        android:visibility="gone"
        android:id="@+id/activity_system_notice_new_xttz_num_tv"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:gravity="center"
        android:minWidth="18dp"
        android:text="99"
        android:textColor="@color/color_white"
        android:textSize="12sp"
        android:background="@drawable/fun_bg_red_rounded_9"
        />
</LinearLayout>
