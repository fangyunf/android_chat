<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/transparent"
        android:orientation="vertical">

        <LinearLayout
            android:background="@drawable/home_bg"
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:id="@+id/fun_conversation_fragment_top_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:paddingHorizontal="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingRight="10dp">

                    <ImageView
                        android:id="@+id/fun_conversation_fragment_kefu_iv"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginHorizontal="10dp"
                        android:src="@mipmap/conversation_list_index_kefu_icon"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/fun_conversation_fragment_title_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingLeft="@dimen/dimen_35_dp"
                        android:text="消息"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <ImageView
                        android:id="@+id/fun_conversation_fragment_search_iv"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginHorizontal="10dp"
                        android:src="@mipmap/conversation_list_index_notice_icon" />

                    <ImageView
                        android:id="@+id/fun_conversation_fragment_more_iv"

                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@mipmap/conversation_index_pop_more" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/fun_conversation_fragment_search_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_e3e3e3_rounded_10"
                android:gravity="center">

                <EditText
                    android:id="@+id/fun_conversation_fragment_et"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_48_dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_white_rounded_12"
                    android:drawableStart="@mipmap/conversation_list_index_search_icon1"
                    android:drawablePadding="5dp"
                    android:hint="搜索"
                    android:maxLines="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColor="@color/color_333333"
                    android:textColorHint="#8E8E93"
                    android:textSize="16dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_10_dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="@dimen/dimen_16_dp"
                    android:layout_height="@dimen/dimen_16_dp"
                    android:src="@mipmap/icon_new_notice" />

                <com.sunfusheng.marqueeview.MarqueeView
                    android:id="@+id/marqueeView"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    app:mvAnimDuration="1000"
                    app:mvDirection="bottom_to_top"
                    app:mvInterval="3000"
                    app:mvSingleLine="true"
                    app:mvTextColor="#0192FF"
                    app:mvTextSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/bodyTopLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />

        <LinearLayout
            android:id="@+id/bodyLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dimen_8_dp"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/errorTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_fceeee"
                android:gravity="center"
                android:paddingStart="@dimen/dimen_35_dp"
                android:paddingTop="@dimen/dimen_10_dp"
                android:paddingEnd="@dimen/dimen_5_dp"
                android:paddingBottom="@dimen/dimen_10_dp"
                android:text="@string/conversation_network_error_tip"
                android:textColor="@color/color_50_000000"
                android:textSize="14dp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.netease.yunxin.kit.conversationkit.ui.view.ConversationView
                    android:id="@+id/conversationView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/color_white" />

                <LinearLayout
                    android:id="@+id/emptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dimen_188_dp"
                    android:layout_marginTop="@dimen/dimen_150_dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/dimen_118_dp"
                        android:layout_height="@dimen/dimen_96_dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/fun_ic_conversation_empty" />

                    <TextView
                        android:id="@+id/empty_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/conversation_empty_tip" />

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints" />
    </LinearLayout>
</RelativeLayout>