<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fun_conversation_search_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/fun_conversation_fragment_search_dim_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:id="@+id/fun_conversation_search_content_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:paddingHorizontal="@dimen/dimen_16_dp"
            android:id="@+id/fun_conversation_fragment_search_panel_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/fun_conversation_search_panel_popup_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/fun_conversation_search_bar_outer"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <EditText
                    android:id="@+id/fun_conversation_fragment_et"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/fun_conversation_search_input_bg"
                    android:hint="搜索"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/color_333333"
                    android:textColorHint="#999999"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/fun_conversation_fragment_search_clear_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="@color/black" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/conversation_list_index_search_icon1"
                    app:tint="@color/color_white" />
            </LinearLayout>
        </LinearLayout>

        <com.netease.yunxin.kit.conversationkit.ui.view.ConversationView
            android:id="@+id/fun_conversation_fragment_search_conversation_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/color_white"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
