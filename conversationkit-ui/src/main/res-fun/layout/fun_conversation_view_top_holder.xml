<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@color/color_white"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/avatarLayout"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginVertical="@dimen/dimen_8_dp"
        android:layout_marginStart="@dimen/dimen_16_dp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/avatarView"
            android:layout_width="@dimen/dimen_44_dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:layout_gravity="bottom"
            android:src="@drawable/tonggao"
            app:avatarCorner="@dimen/dimen_22_dp" />

        <TextView
            android:id="@+id/unreadTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/dimen_2_dp"
            android:background="@drawable/bg_conversation_red_dot"
            android:gravity="center"
            android:paddingStart="@dimen/dimen_7_dp"
            android:paddingEnd="@dimen/dimen_7_dp"
            android:textColor="@color/color_white"
            android:textSize="@dimen/text_size_12"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="76dp"
        android:layout_marginEnd="@dimen/dimen_16_dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:layout_marginEnd="@dimen/dimen_100_dp"
            android:ellipsize="end"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="系统公告"
                    android:textColor="@color/fun_conversation_item_title_text_color"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_5_dp"
                    android:background="@drawable/fun_conversation_view_top_guanfang"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dimen_4_dp"
                    android:text="官方"
                    android:textColor="#FF962C"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/fun_conversation_view_holder_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                android:background="@drawable/bg_apptheme_alpha_30_rounded_7"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:textColor="#ffff8a0b"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_40_dp"
            android:layout_marginEnd="@dimen/dimen_20_dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/aitTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_4_dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/conversation_ait_tip"
                android:textColor="@color/color_f24957"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/messageTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fun_conversation_item_sub_title_text_color"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen_16_dp"
            android:ellipsize="end"
            android:maxWidth="@dimen/dimen_100_dp"
            android:maxLines="1"
            android:textColor="@color/app_theme_color"
            android:textSize="@dimen/text_size_12" />

        <ImageView
            android:id="@+id/muteIv"
            android:layout_width="@dimen/dimen_14_dp"
            android:layout_height="@dimen/dimen_14_dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen_40_dp"
            android:src="@drawable/fun_ic_conversation_mute"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>