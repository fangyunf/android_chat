<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/dimen_16_dp"
    android:paddingVertical="@dimen/dimen_12_dp">

    <!-- 方形头像 -->
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/cell_fun_team_setting_users_vertical_head_iv"
        android:layout_width="@dimen/dimen_50_dp"
        android:layout_height="@dimen/dimen_50_dp"
        android:adjustViewBounds="false"
        android:background="@color/color_F2F2F2"
        android:scaleType="centerCrop"
        app:riv_corner_radius="6dp" />

    <!-- 名称和角色容器 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12_dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cell_fun_team_setting_users_vertical_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#ff000000"
            android:textSize="16sp" />

        <!-- 角色标签：群主/管理员 -->
        <TextView
            android:id="@+id/cell_fun_team_setting_users_vertical_role_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8_dp"
            android:background="@drawable/fun_bg_purple_rounded_7"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="群主"
            android:textColor="#ffffffff"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
