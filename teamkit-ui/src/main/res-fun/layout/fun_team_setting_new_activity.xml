<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f2f2f2"
    tools:theme="@style/TeamKitLayoutPreviewTheme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/fun_team_setting_new_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@mipmap/icon_nav_title_bg"
            app:back_icon="@mipmap/icon_a_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="群信息"
            app:title_text_color="@color/color_white" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/dimen_20_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@mipmap/icon_liaotian_chat_settting"
                        android:gravity="center_vertical"
                        android:padding="@dimen/dimen_10_dp">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/fun_team_setting_new_activity_team_icon"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="@dimen/dimen_5_dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="4dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="15dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxWidth="350dp"
                                    android:singleLine="true"
                                    android:text="dfasfds"
                                    android:textColor="@color/color_white"
                                    android:textSize="18dp"
                                    tools:ignore="SpUsage" />

                                <ImageView
                                    android:id="@+id/edit_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="5dp"
                                    android:src="@mipmap/mine_index_bj" />
                            </LinearLayout>
                        </LinearLayout>


                        <!--                        android:background="@drawable/bg_black_alpha_20_rounded_10"-->

                        <TextView
                            android:id="@+id/fun_team_setting_new_activity_id_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:layout_marginTop="@dimen/dimen_30_dp"
                            android:paddingHorizontal="10dp"
                            android:text="ID:87988656"
                            android:textColor="@color/color_white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp"
                        android:layout_marginBottom="@dimen/dimen_14_dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingHorizontal="15dp">

                        <androidx.constraintlayout.helper.widget.Flow
                            android:id="@+id/flow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="layoutYaoqing,layoutTtuichu,layoutQunGuanli,layoutQunMore"
                            app:flow_horizontalAlign="start"
                            app:flow_wrapMode="none"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/layoutYaoqing"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/bg_white_rounded_10"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintWidth_percent="0.20">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_yaoqing" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="邀请"
                                android:textColor="@color/app_theme_color"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutTtuichu"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/bg_white_rounded_10"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintWidth_percent="0.20">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_tuichu" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="提出"
                                android:textColor="@color/app_theme_color"
                                android:textSize="14sp" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/layoutQunGuanli"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/bg_white_rounded_10"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintWidth_percent="0.20">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_quanguanli" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="群管理"
                                android:textColor="@color/app_theme_color"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutQunMore"
                            android:layout_width="0dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="@dimen/dimen_4_dp"
                            android:background="@drawable/bg_white_rounded_10"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintWidth_percent="0.20">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="20dp"
                                android:src="@drawable/icon_qun_more" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginTop="@dimen/dimen_5_dp"
                                android:text="更多"
                                android:textColor="@color/app_theme_color"
                                android:textSize="14sp" />

                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fun_team_setting_new_activity_member_rv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_75_dp"
                        android:layout_marginTop="@dimen/dimen_16_dp"
                        android:visibility="gone" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fun_team_setting_new_activity_gonggao_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_16_dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginRight="6dp"
                            android:src="@drawable/team_setting_cell_qcy"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:text="群公告"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fun_team_setting_new_activity_gonggao_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="…"
                        android:textColor="#ff666666"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_10_dp"
                    android:background="@drawable/white_bg_rounded_top_20"
                    android:orientation="vertical">

                    <!-- 切换-->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        style="@style/MyTabLayoutSmall"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_40_dp"
                        android:background="@color/transparent"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/app_theme_color"
                        app:tabIndicatorFullWidth="false"
                        app:tabMode="fixed"
                        app:tabSelectedTextColor="@color/app_theme_color"
                        app:tabTextColor="#666666">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="成员" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="设置" />
                    </com.google.android.material.tabs.TabLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_F2F2F2" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvUserInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_16_dp"
                        android:paddingBottom="@dimen/dimen_16_dp" />

                    <LinearLayout
                        android:id="@+id/layouSettingBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/fun_team_setting_new_activity_manager_ll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_12_dp"
                            android:background="@color/color_white"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <include
                                android:id="@+id/fun_team_setting_new_activity_manager_team"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/fun_team_setting_new_activity_team_setting"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/fun_team_setting_new_activity_team_upgrade"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/fun_team_setting_new_activity_set_gonggao"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/color_white"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/fun_team_setting_new_activity_see_all_member_ll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:gravity="center_vertical"
                                android:padding="@dimen/dimen_16_dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="22dp"
                                    android:layout_weight="1"
                                    android:text="群成员"
                                    android:textColor="#ff000000"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tvTeamNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:text=""
                                    android:textColor="#ff666666"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:layout_width="6dp"
                                    android:layout_height="@dimen/dimen_12_dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@mipmap/common_right_arrow" />
                            </LinearLayout>
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_12_dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_white_rounded_10"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/fun_team_setting_new_activity_vlq_hb"
                                    layout="@layout/view_title_arrow_template"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@color/color_white"
                                android:orientation="vertical">

                                <include
                                    android:id="@+id/fun_team_setting_new_activity_zhiding"
                                    layout="@layout/view_title_arrow_template"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:leftImg="@drawable/team_setting_miandarao" />

                                <include
                                    android:id="@+id/fun_team_setting_new_activity_miandarao"
                                    layout="@layout/view_title_arrow_template"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dimen_12_dp"
                            android:background="@color/color_white"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/fun_team_setting_new_activity_search_history"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/fun_team_setting_new_activity_nicheng"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <!--                    <include-->
                            <!--                        android:id="@+id/fun_team_setting_new_activity_upgrade_team"-->
                            <!--                        layout="@layout/view_title_arrow_template"-->
                            <!--                        android:layout_width="match_parent"-->
                            <!--                        android:layout_height="wrap_content" />-->


                            <include
                                android:id="@+id/fun_team_setting_new_activity_delte_record"
                                layout="@layout/view_title_arrow_template"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <!--                    <include-->
                            <!--                        android:id="@+id/fun_team_setting_new_activity_tousu"-->
                            <!--                        layout="@layout/view_title_arrow_template"-->
                            <!--                        android:layout_width="match_parent"-->
                            <!--                        android:layout_height="wrap_content" />-->
                        </LinearLayout>

                        <include
                            android:id="@+id/fun_team_setting_new_activity_tuichu"
                            layout="@layout/view_title_arrow_template"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvClearMessage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@drawable/bb_fun_bg_app_theme_color_rounded_22"
                    android:gravity="center"
                    android:text="清空聊天记录"
                    android:textColor="@color/app_theme_color"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/fun_team_setting_new_activity_quite"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:layout_marginBottom="@dimen/dimen_30_dp"
                    android:background="@drawable/fun_bg_app_theme_color_rounded_22"
                    android:gravity="center"
                    android:text="退出群聊"
                    android:textColor="@color/color_white"
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</RelativeLayout>