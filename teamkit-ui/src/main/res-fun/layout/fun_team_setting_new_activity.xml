<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ImageView
        android:scaleType="fitXY"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/jinzita_common_page_bg"
        />
    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar

            android:id="@+id/fun_team_setting_new_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@android:color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="群信息"
            app:title_text_color="@color/color_333333"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0.5dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"

                    android:padding="@dimen/dimen_16_dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/fun_team_setting_new_activity_team_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        app:riv_corner_radius="30dp"
                        android:scaleType="centerCrop"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        >

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            >

                            <TextView
                                android:id="@+id/tvName"
                                android:maxWidth="350dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/color_333333"
                                android:textSize="16dp"
                                tools:ignore="SpUsage" />

                            <ImageView
                                android:id="@+id/edit_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginLeft="5dp"
                                android:src="@mipmap/mine_index_bj"
                                />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/fun_team_setting_new_activity_id_tv"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="11dp"
                            android:text="ID:87988656"
                            android:textColor="@color/color_white"

                            android:paddingHorizontal="10dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_black_alpha_20_rounded_10"

                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout

                    android:layout_marginHorizontal="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_f2f2f2_rounded_10"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/dimen_16_dp"
                    >

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_marginLeft="@dimen/dimen_16_dp"
                            android:layout_marginRight="6dp"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/team_setting_cell_qcy"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="群成员"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fun_team_setting_new_activity_member_rv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_75_dp"
                        android:layout_marginTop="@dimen/dimen_12_dp" />

                    <LinearLayout
                        android:id="@+id/fun_team_setting_new_activity_see_all_member_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/dimen_12_dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="20dp"
                            android:text="查看更多群成员"
                            android:textColor="#ff666666"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="6dp"
                            android:layout_height="@dimen/dimen_12_dp"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/ic_right_arrow" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fun_team_setting_new_activity_gonggao_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@drawable/bg_f2f2f2_rounded_10"

                    android:layout_marginHorizontal="15dp"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_16_dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_marginRight="6dp"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/team_setting_cell_qcy"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="群公告"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fun_team_setting_new_activity_gonggao_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="…"
                        android:textColor="#ff666666"
                        android:textSize="14sp" />
                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="@dimen/dimen_12_dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="@dimen/dimen_14_dp"
                        android:src="@drawable/team_setting_cell_set"
                        />
                    <TextView
                        android:layout_marginLeft="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设置"
                        android:textColor="#ff000000"
                        android:textSize="15sp"
                        />
                </LinearLayout>
<!--                <com.yaoxin.appbase.view.templateview.ViewTitleArrowTemplate-->

<!--                    android:id="@+id/fun_team_setting_new_activity_miandarao"-->
<!--                    android:layout_width="match_parent"-->
<!--                    app:leftImg="@drawable/team_setting_miandarao"-->
<!--                    android:layout_height="wrap_content"/>-->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
android:layout_marginTop="5dp"
                    android:background="@drawable/bg_f2f2f2_rounded_10"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/fun_team_setting_new_activity_zhiding"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        app:leftImg="@drawable/team_setting_miandarao"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_miandarao"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@drawable/bg_f2f2f2_rounded_10"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/fun_team_setting_new_activity_nicheng"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_set_gonggao"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_manager_team"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
<!--                    <include-->
<!--                        android:id="@+id/fun_team_setting_new_activity_upgrade_team"-->
<!--                        layout="@layout/view_title_arrow_template"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content" />-->


                    <include
                        android:id="@+id/fun_team_setting_new_activity_delte_record"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

<!--                    <include-->
<!--                        android:id="@+id/fun_team_setting_new_activity_tousu"-->
<!--                        layout="@layout/view_title_arrow_template"-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content" />-->
                </LinearLayout>
                <TextView
                    android:id="@+id/fun_team_setting_new_activity_quite"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@color/color_white"
                    android:gravity="center"
                    android:text="退出群聊"
                    android:textColor="#ffef0000"
                    android:textSize="16sp"
                    />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</RelativeLayout>