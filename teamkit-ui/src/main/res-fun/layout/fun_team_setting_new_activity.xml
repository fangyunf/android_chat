<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/jinzita_common_page_bg" />

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar

            android:id="@+id/fun_team_setting_new_activity_nav"
            style="@style/WhiteFontToolbar"
            android:background="@android:color/transparent"
            app:back_icon="@mipmap/temp_ic_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="群信息"
            app:title_text_color="@color/color_333333" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0.5dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_white_rounded_10"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp">

                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/fun_team_setting_new_activity_team_icon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            app:riv_corner_radius="6dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/color_333333"
                                    android:textSize="17sp"
                                    tools:text="群名称(0)" />

                                <ImageView
                                    android:id="@+id/edit_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="6dp"
                                    android:src="@mipmap/mine_index_bj" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/fun_team_setting_new_activity_founder_tv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#999999"
                                android:textSize="13sp"
                                tools:text="创始人:玉麒麟" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/dimen_16_dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/fun_team_setting_new_activity_member_rv"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dimen_75_dp" />

                    <LinearLayout
                        android:id="@+id/fun_team_setting_new_activity_see_all_member_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dimen_12_dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查看更多群成员"
                            android:textColor="#ff666666"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:src="@drawable/team_setting_cell_right_arrow" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fun_team_setting_new_activity_manager_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/fun_team_setting_new_activity_manager_team"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_team_setting"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_team_upgrade"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/fun_team_setting_new_activity_set_gonggao"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fun_team_setting_new_activity_gonggao_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"

                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical"
                    android:padding="@dimen/dimen_16_dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginRight="6dp"
                            android:src="@drawable/team_setting_cell_qcy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:text="群公告"
                            android:textColor="#ff000000"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fun_team_setting_new_activity_gonggao_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="…"
                        android:textColor="#ff666666"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:orientation="vertical">

                    <!--                <com.yaoxin.appbase.view.templateview.ViewTitleArrowTemplate-->

                    <!--                    android:id="@+id/fun_team_setting_new_activity_miandarao"-->
                    <!--                    android:layout_width="match_parent"-->
                    <!--                    app:leftImg="@drawable/team_setting_miandarao"-->
                    <!--                    android:layout_height="wrap_content"/>-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_white_rounded_10"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/fun_team_setting_new_activity_zhiding"
                            layout="@layout/view_title_arrow_template"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:leftImg="@drawable/team_setting_miandarao" />

                        <include
                            android:id="@+id/fun_team_setting_new_activity_miandarao"
                            layout="@layout/view_title_arrow_template"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@drawable/bg_white_rounded_10"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/fun_team_setting_new_activity_nicheng"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!--                    <include-->
                    <!--                        android:id="@+id/fun_team_setting_new_activity_upgrade_team"-->
                    <!--                        layout="@layout/view_title_arrow_template"-->
                    <!--                        android:layout_width="match_parent"-->
                    <!--                        android:layout_height="wrap_content" />-->


                    <include
                        android:id="@+id/fun_team_setting_new_activity_delte_record"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!--                    <include-->
                    <!--                        android:id="@+id/fun_team_setting_new_activity_tousu"-->
                    <!--                        layout="@layout/view_title_arrow_template"-->
                    <!--                        android:layout_width="match_parent"-->
                    <!--                        android:layout_height="wrap_content" />-->
                </LinearLayout>

                <TextView
                    android:id="@+id/fun_team_setting_new_activity_quite"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="@dimen/dimen_12_dp"
                    android:background="@color/color_white"
                    android:gravity="center"
                    android:text="退出群聊"
                    android:textColor="#ffef0000"
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</RelativeLayout>