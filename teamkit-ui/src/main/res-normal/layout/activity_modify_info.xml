<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/add_friend_bg"
        android:scaleType="fitXY"
        />
<LinearLayout
    android:layout_width="match_parent"
    android:gravity="center_horizontal"
    android:layout_height="match_parent"

    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/activity_modify_info_nav"
        style="@style/WhiteFontToolbar"
        android:background="@color/transparent"
        app:back_icon="@mipmap/temp_ic_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="修改用户名"
        app:title_text_color="@color/color_333333"
        app:under_divider_color="@color/transparent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <EditText
            android:id="@+id/activity_modify_info_et"
            android:layout_margin="@dimen/dimen_14_dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_40_dp"
            android:paddingHorizontal="@dimen/dimen_14_dp"
            android:textSize="15sp"
            android:hint="请输入"
            android:textColorHint="@color/color_999999"
            android:textColor="@color/black"
            android:background="#F6F6F6"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"

            />
        <TextView
            android:background="@drawable/fun_bg_app_theme_color_rounded_22"
            android:id="@+id/activity_modify_info_save_rl"
            android:layout_width="301dp"
            android:layout_height="@dimen/dimen_44_dp"
            android:gravity="center"
            android:text="保存"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:textColor="#ffffffff"
            android:layout_marginBottom="@dimen/dimen_40_dp"
            android:textSize="16sp" />
    </RelativeLayout>



</LinearLayout>
</RelativeLayout>