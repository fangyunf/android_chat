<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@mipmap/icon_app_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"

        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/activity_modify_info_nav"
            style="@style/WhiteFontToolbar"
            android:background="@color/transparent"
            app:back_icon="@mipmap/temp_ic_back_white"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="修改用户名"
            app:title_text_color="@color/color_white"
            app:under_divider_color="@color/transparent" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/activity_modify_info_et"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_40_dp"
                android:layout_margin="@dimen/dimen_14_dp"
                android:background="#F6F6F6"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="请输入"
                android:paddingHorizontal="@dimen/dimen_14_dp"
                android:textColor="@color/black"
                android:textColorHint="@color/color_999999"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/activity_modify_info_save_rl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_44_dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_margin="@dimen/dimen_16_dp"
                android:layout_marginBottom="@dimen/dimen_40_dp"
                android:background="@drawable/fun_bg_app_theme_color_rounded_22"
                android:gravity="center"
                android:text="保存"
                android:textColor="#ffffffff"
                android:textSize="16sp" />
        </RelativeLayout>


    </LinearLayout>
</RelativeLayout>