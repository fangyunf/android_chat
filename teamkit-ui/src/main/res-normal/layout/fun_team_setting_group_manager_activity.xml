<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2"
    android:orientation="vertical">

    <com.yaoxin.appbase.navbar.NavToolbar
        android:id="@+id/fun_team_setting_group_manager_activity_nav"
        style="@style/WhiteFontToolbar"
        android:background="@mipmap/icon_nav_title_bg"
        app:back_icon="@mipmap/icon_a_back"
        app:enable_under_divider="true"
        app:support_translucent_status_bar="false"
        app:title="群管理"
        app:title_text_color="@color/color_white"
        app:under_divider_color="@color/transparent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@mipmap/icon_liaotian_chat_settting"
                    android:gravity="center_vertical"
                    android:padding="@dimen/dimen_10_dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/fun_team_setting_new_activity_team_icon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="@dimen/dimen_5_dp"
                        android:scaleType="centerCrop"
                        app:riv_corner_radius="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="350dp"
                                android:singleLine="true"
                                android:textColor="@color/color_white"
                                android:textSize="18dp"
                                tools:ignore="SpUsage" />


                        </LinearLayout>
                    </LinearLayout>
                    
                    <!--                        android:background="@drawable/bg_black_alpha_20_rounded_10"-->
                    <TextView
                        android:id="@+id/fun_team_setting_new_activity_id_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="@dimen/dimen_30_dp"
                        android:paddingHorizontal="10dp"
                        android:text=""
                        android:textColor="@color/color_white"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_16_dp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_qunzhu_zhuanrang"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_jinzhi_lingqu_mingdan"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_danren_jinyan"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_jinzhi_lingqu_gouwuquan"
                        layout="@layout/view_title_detail_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_yaoqing"
                        layout="@layout/view_title_detail_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_qunchengyuan_baohu"
                        layout="@layout/view_title_detail_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_chengyuan_jinyan"
                        layout="@layout/view_title_detail_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_guanliyuan_set"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_qunshengji"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />

                    <include
                        android:id="@+id/fun_team_setting_group_manager_activity_qunheimingdan"
                        layout="@layout/view_title_arrow_template"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_10_dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/fun_team_setting_group_manager_activity_jiesan_tv"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_margin="@dimen/dimen_16_dp"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/bg_white_rounded_10"
        android:gravity="center"
        android:text="解散群聊"
        android:textColor="@color/app_theme_red_color"
        android:textSize="16sp" />

</LinearLayout>