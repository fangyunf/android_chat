<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yaoxin.appbase.navbar.NavToolbar
            android:id="@+id/fun_team_user_info_detail_nav"
            style="@style/WhiteFontToolbar"
            android:background="@mipmap/icon_nav_title_bg"
            app:back_icon="@mipmap/icon_a_back"
            app:enable_under_divider="true"
            app:support_translucent_status_bar="false"
            app:title="详细信息"
            app:title_text_color="@color/color_white"
            app:under_divider_color="@android:color/transparent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_theme_color"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:paddingVertical="14dp">


                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="@dimen/dimen_16_dp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:id="@+id/fun_team_user_info_detail_head_iv"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="centerCrop"
                        app:riv_corner_radius="30dp" />

                    <ImageView
                        android:id="@+id/ivGradeBg"
                        android:layout_width="60dp"
                        android:layout_height="60dp" />
                </FrameLayout>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_18_dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/fun_team_user_info_detail_name_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1234"
                            android:textColor="@color/color_white"
                            android:textSize="22sp" />
                        
                        <ImageView
                            android:id="@+id/fun_team_user_info_detail_grade_iv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:src="@mipmap/mine_grade_level_1"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fun_team_user_info_detail_account_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dimen_8_dp"
                        android:text="5678"
                        android:textColor="@color/color_white"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layoutYaoqingren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_20_dp"
                android:paddingHorizontal="@dimen/dimen_16_dp"
                android:paddingBottom="@dimen/dimen_16_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:text="邀请人"
                    android:textColor="#ffffffff"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvYaoQingRen"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_alignParentRight="true"
                    android:textColor="#ffffffff"
                    android:textSize="16sp" />

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="15dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dimen_16_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded_12"
                android:orientation="vertical">

                <include
                    android:id="@+id/fun_team_user_info_detail_yaoqingren"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/fun_team_user_info_detail_beizhuming"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/fun_team_user_info_detail_lahei"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/fun_team_user_info_detail_jinzhi"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/fun_team_user_info_detail_tichu"
                    layout="@layout/view_title_arrow_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fun_team_user_info_detail_bottom_tv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/fun_bg_app_theme_color_rounded_26"
            android:gravity="center"
            android:text="加好友"
            android:textColor="@color/color_white"
            android:textSize="15sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvTichu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_48_dp"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="@dimen/dimen_10_dp"
            android:background="@drawable/bb_fun_bg_app_theme_color_rounded_22"
            android:gravity="center"
            android:text="移除群聊"
            android:textColor="@color/app_theme_color"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>