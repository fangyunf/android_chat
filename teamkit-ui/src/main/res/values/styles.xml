<resources>
    <style name="BottomDialogTheme" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/BottomDialogAnimation</item>
    </style>

    <style name="FunBottomDialogTheme" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/BottomDialogAnimation</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="TeamSelectorRadioBtn" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:button">@drawable/bg_team_radio_button_selector</item>
    </style>

    <!-- 布局预览用：TabLayout 等 Material 组件需要 MaterialComponents 主题 -->
    <style name="TeamKitLayoutPreviewTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/app_theme_color</item>
        <item name="colorAccent">@color/app_theme_color</item>
    </style>

    <style name="MyTabLayoutSmall" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextAppearance">@style/MyTabTextAppearanceSmall</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="MyTabTextAppearanceSmall" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
    </style>
</resources>